@inject GameEngine Engine
@inject NavigationManager Nav
@implements IDisposable

<div class="woodbar">
    <button class="home-btn" @onclick='() => Nav.NavigateTo("/")' title="Menu">🏠</button>
    <div class="wood-pills">
        <span class="wood-pill" title="Gold">🪙 @_gold<em>+@_income</em></span>
        <span class="wood-pill" title="Ruler Rating">👑 @_rating</span>
        <span class="wood-pill" title="Population">👥 @_pop</span>
    </div>
    <span class="build-tag" title="App build number — compare with the latest pushed build to spot a stale deploy">#@AppVersion.Build</span>
</div>

@code {
    private Nation _nation => Engine.State.PlayerNation;
    private string _gold => _nation.Gold.ToString("N0");
    private string _rating => _nation.RulerRating.ToString("N0");
    // The realm counts everyone once: the country's own people and income plus those of the territories it has annexed.
    private string _pop => Engine.RealmPopulation.ToString("N0");
    private string _income => Engine.RealmDailyIncome().ToString("N0");

    protected override void OnInitialized() => Engine.StateChanged += OnStateChanged;
    private void OnStateChanged() => InvokeAsync(StateHasChanged);
    public void Dispose() => Engine.StateChanged -= OnStateChanged;
}
