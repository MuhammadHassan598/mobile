@inject GameEngine Engine
@implements IDisposable

<div class="select2">
    <header class="select2-header">
        <span class="app-title">👑 EmpireSim</span>
        <span class="header-btns">
            <button class="hbtn" title="Settings">⚙️</button>
            <button class="hbtn" title="Help">❓</button>
        </span>
    </header>

    <div class="select2-body">
        <aside class="civ-rail">
            <div class="civ-label">CIVILIZATIONS</div>
            <div class="civ-grid">
                @foreach (var n in _options)
                {
                    <button class="civ-btn @(_selected.Id == n.Id ? "sel" : "")"
                            style="background:@n.ColorHex"
                            title="@n.Name"
                            @onclick="() => Select(n.Id)">
                        <span>@n.Emblem</span>
                    </button>
                }
            </div>
        </aside>

        <div class="select2-main">
            <div class="advisor-row2">
                <img class="advisor-framed" src="images/advisor.webp" alt="Advisor" />
                <div class="speech2">
                    <div>Choose the country you want to lead.</div>
                    <div class="speech-div">❖</div>
                </div>
            </div>

            <div class="banner-anchor">
                <button class="nation-banner" @onclick="ToggleDropdown">
                    <span class="banner-emblem" style="background:@_selected.ColorHex">@_selected.Emblem</span>
                    <span class="banner-name">@_selected.Name</span>
                    <span class="banner-chev">@(_dropdownOpen ? "▴" : "▾")</span>
                </button>
                @if (_dropdownOpen)
                {
                    <div class="dropdown-list">
                        @foreach (var n in _options)
                        {
                            <button class="dropdown-item @(n.Id == _selected.Id ? "selected" : "")"
                                    @onclick="() => Select(n.Id)">
                                <span class="crest-mini" style="background:@n.ColorHex">@n.Emblem</span>
                                <span>@n.Name</span>
                            </button>
                        }
                    </div>
                }
            </div>

            <div class="select-map2">
                <img src="images/parchment-map.webp" alt="World map" />
                <div class="map-pin2" style="left:@PinX%;top:@PinY%">
                    <span class="pin-head"><span class="pin-emblem">@_selected.Emblem</span></span>
                </div>
            </div>

            <div class="stats-card">
                <div class="min-row">
                    <span title="Wood">🪵 @Fmt(_selected.Wood)</span>
                    <span title="Stone">🪨 @Fmt(_selected.Stone)</span>
                    <span title="Iron">⛓️ @Fmt(_selected.Iron)</span>
                    <span title="Copper">🟤 @Fmt(_selected.Copper)</span>
                    <span title="Lead">⬜ @Fmt(_selected.Lead)</span>
                </div>
                <div class="stat2-grid">
                    <div class="stat2">
                        <span class="stat2-ic">👥</span>
                        <span class="stat2-val">@_selected.HistoricalPopulation.ToString("N0")</span>
                        <span class="stat2-lab">Population</span>
                    </div>
                    <div class="stat2">
                        <span class="stat2-ic">⚔️</span>
                        <span class="stat2-val">@_selected.Soldiers.ToString("N0")</span>
                        <span class="stat2-lab">Military Strength</span>
                    </div>
                    <div class="stat2">
                        <span class="stat2-ic">🪙</span>
                        <span class="stat2-val">@_income.ToString("N0")</span>
                        <span class="stat2-lab">Income per day</span>
                    </div>
                    <div class="stat2">
                        <span class="stat2-ic">@ReligionIcon(_selected.Religion)</span>
                        <span class="stat2-val">@_selected.Religion</span>
                        <span class="stat2-lab">State Religion</span>
                    </div>
                    <div class="stat2 wide">
                        <span class="stat2-ic">🏰</span>
                        <span class="stat2-val">@CapitalName</span>
                        <span class="stat2-lab">Capital City</span>
                    </div>
                </div>
            </div>

            <button class="start2" @onclick="Start">START</button>
            <img class="backdrop" src="images/select-backdrop.webp" alt="" />
        </div>
    </div>
</div>

@code {
    private List<Nation> _options = new();
    private Nation _selected = null!;
    private bool _dropdownOpen;

    protected override void OnInitialized()
    {
        var preview = GameState.NewGame("ottoman");
        _options = new[] { preview.PlayerNation }
            .Concat(preview.OtherNations)
            .OrderBy(n => n.Name)
            .ToList();
        _selected = _options.First(n => n.Id == "ottoman");
        Engine.StateChanged += OnStateChanged;
    }

    private void OnStateChanged() => InvokeAsync(StateHasChanged);

    private void ToggleDropdown() => _dropdownOpen = !_dropdownOpen;

    private void Select(string id)
    {
        _selected = _options.First(n => n.Id == id);
        _dropdownOpen = false;
    }

    private static string Fmt(double v) => v.ToString("N0");
    private long _income => GameEngine.EstimateDailyIncome(_selected);
    private string CapitalName => _selected.CapitalName;
    private double PinX => _selected.PinX;
    private double PinY => _selected.PinY;

    private static string ReligionIcon(string r) => r switch
    {
        "Islam" => "☪️",
        "Christianity" => "✝️",
        "Buddhism" => "☸️",
        "Hinduism" => "🕉️",
        "Shinto" => "⛩️",
        "Confucianism" => "📜",
        "Shamanism" => "🌙",
        "Animism" => "🌿",
        _ => "🛐",
    };

    private void Start() => Engine.StartCampaign(_selected.Id);

    public void Dispose() => Engine.StateChanged -= OnStateChanged;
}
