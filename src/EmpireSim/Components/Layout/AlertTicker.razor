@using EmpireSim.Core.Models

@if (Warnings is { Count: > 0 })
{
    <div class="alert-ticker-ribbon" title="Active Alerts">
        <div class="alert-ticker-track">
            <div class="alert-ticker-content">
                @for (int rep = 0; rep < _repeatCount; rep++)
                {
                    @foreach (var w in Warnings)
                    {
                        <span class="ticker-text">⚠ @w</span>
                        <span class="ticker-bullet">✦</span>
                    }
                }
            </div>
            <div class="alert-ticker-content" aria-hidden="true">
                @for (int rep = 0; rep < _repeatCount; rep++)
                {
                    @foreach (var w in Warnings)
                    {
                        <span class="ticker-text">⚠ @w</span>
                        <span class="ticker-bullet">✦</span>
                    }
                }
            </div>
        </div>
    </div>
}

<style>
/* Continuous Flowing Warning Ticker Ribbon */
.alert-ticker-ribbon {
    width: 100%;
    overflow: hidden;
    background: linear-gradient(180deg, #30170a 0%, #1c0e05 100%);
    border-top: 1.5px solid #8b6914;
    border-bottom: 1.5px solid #8b6914;
    box-shadow: inset 0 2px 4px rgba(0,0,0,0.6), 0 2px 5px rgba(0,0,0,0.4);
    margin: 2px 0 12px 0;
    border-radius: 6px;
    padding: 6px 0;
    user-select: none;
    position: relative;
}

.alert-ticker-track {
    display: flex;
    width: max-content;
    animation: ticker-flow 80s linear infinite;
    will-change: transform;
    transform: translateZ(0);
}

.alert-ticker-ribbon:hover .alert-ticker-track,
.alert-ticker-ribbon:active .alert-ticker-track {
    animation-play-state: paused;
}

.alert-ticker-content {
    display: flex;
    align-items: center;
    white-space: nowrap;
    flex-shrink: 0;
}

.ticker-text {
    color: #ffd466;
    font-family: Georgia, serif;
    font-size: 0.86rem;
    font-weight: bold;
    letter-spacing: 0.4px;
    text-shadow: 0 1px 2px #000;
}

.ticker-bullet {
    color: #e53935;
    margin: 0 20px;
    font-size: 0.85rem;
    opacity: 0.85;
}

@@keyframes ticker-flow {
    0% {
        transform: translate3d(0, 0, 0);
    }
    100% {
        transform: translate3d(-50%, 0, 0);
    }
}
</style>

@code {
    [Parameter] public List<string> Warnings { get; set; } = new();

    private string _cachedWarningText = "";
    private int _repeatCount = 1;

    protected override bool ShouldRender()
    {
        string currentText = Warnings.Count > 0 ? string.Join("|||", Warnings) : "";
        if (currentText == _cachedWarningText)
        {
            // Do NOT re-render on day turns if warnings have not changed!
            // Keeps the GPU CSS marquee running smoothly without stutter or stopping.
            return false;
        }
        _cachedWarningText = currentText;
        _repeatCount = Math.Max(1, 3 / Math.Max(1, Warnings.Count));
        return true;
    }
}
