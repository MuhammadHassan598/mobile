@using EmpireSim.Core.Models
@using EmpireSim.Core.Services
@inject GameEngine Engine
@implements IDisposable

@* Peace talks with one country the player is at war with: put terms, answer theirs (accept / reject / counter), see how the war stands.
   Nothing here moves anything until the other side — or the player — accepts. *@
@if (NationId is not null && Engine.State.OtherNations.FirstOrDefault(n => n.Id == NationId) is { } enemy)
{
    var player = Engine.State.PlayerNation;
    string? block = Engine.PeaceBlock(enemy.Id);
    var summary = Engine.WarSummaryOf(enemy.Id);
    var pending = Engine.PendingPeaceOffer(enemy.Id);
    var history = Engine.PeaceHistory(enemy.Id).Where(o => !o.IsPending).Reverse().Take(6).ToList();
    bool theirs = pending is not null && pending.ReceiverId == player.Id;
    bool mine = pending is not null && pending.ProposerId == player.Id;
    bool composing = block is null && !mine && (!theirs || _countering);

    <div class="pc-overlay" @onclick="Close">
        <div class="pc-panel" @onclick:stopPropagation>
            <button class="pc-x" @onclick="Close" title="Close">✕</button>
            <div class="pc-title">🕊️ Peace talks with @enemy.Emblem @enemy.Name</div>

            @if (!string.IsNullOrEmpty(_msg))
            {
                <div class="pc-msg @(_msgOk ? "ok" : "bad")">@_msg</div>
            }

            @if (block is not null)
            {
                <div class="pc-note">@block</div>
            }
            else
            {
                @if (summary is not null)
                {
                    <div class="pc-sum">
                        <div class="pc-row"><span>War lasting</span><b>@summary.AgeDays day@(summary.AgeDays == 1 ? "" : "s")</b></div>
                        <div class="pc-row"><span>Battles won (you / them)</span><b>@summary.PlayerBattlesWon / @summary.EnemyBattlesWon</b></div>
                        <div class="pc-row"><span>Soldiers lost (you / them)</span><b>@summary.PlayerLosses.ToString("N0") / @summary.EnemyLosses.ToString("N0")</b></div>
                        <div class="pc-row"><span>Armies at home (you / them)</span><b>@summary.PlayerHome.ToString("N0") / @summary.EnemyHome.ToString("N0")</b></div>
                        <div class="pc-mood">@summary.Assessment</div>
                    </div>
                }

                @if (theirs)
                {
                    <div class="pc-offer theirs">
                        <div class="pc-offer-head">📨 @enemy.Name proposes <small>(round @pending!.Round of @Balance.PeaceMaxRounds · answer by @pending.DueDate.ToString("dd-MM-yyyy"))</small></div>
                        @foreach (var line in PeaceService.Describe(Engine.State, pending))
                        {
                            <div class="pc-line">• @line</div>
                        }
                        <div class="pc-actions">
                            <button class="pc-btn go" @onclick="() => Respond(() => Engine.AcceptPeaceOffer(pending.Id))">✔ ACCEPT</button>
                            <button class="pc-btn no" @onclick="() => Respond(() => Engine.RejectPeaceOffer(pending.Id))">✖ REJECT</button>
                            @if (pending.Round < Balance.PeaceMaxRounds)
                            {
                                <button class="pc-btn alt" @onclick="() => StartCounter(pending)">↔ COUNTER</button>
                            }
                        </div>
                        @if (pending.Round >= Balance.PeaceMaxRounds)
                        {
                            <div class="pc-hint">This is the last round: accept or reject.</div>
                        }
                    </div>
                }
                else if (mine)
                {
                    <div class="pc-offer mine">
                        <div class="pc-offer-head">⏳ Your proposal waits for @enemy.Name <small>(round @pending!.Round · answer expected @pending.DueDate.ToString("dd-MM-yyyy"))</small></div>
                        @foreach (var line in PeaceService.Describe(Engine.State, pending))
                        {
                            <div class="pc-line">• @line</div>
                        }
                        <div class="pc-actions">
                            <button class="pc-btn no" @onclick="() => Respond(() => Engine.WithdrawPeaceOffer(pending.Id))">TAKE IT BACK</button>
                        </div>
                    </div>
                }

                @if (composing)
                {
                    <div class="pc-compose">
                        <div class="pc-label">@(theirs ? "Your counteroffer" : "Your terms")</div>
                        <label class="pc-check"><input type="checkbox" checked="@_peace" @onchange="e => _peace = (bool)(e.Value ?? false)" /> 🕊️ Peace — the war ends when they accept</label>
                        @foreach (var (term, i) in _terms.Select((t, i) => (t, i)))
                        {
                            <div class="pc-term">
                                <span>@PeaceService.Describe(Engine.State, term)</span>
                                <button @onclick="() => _terms.RemoveAt(i)" title="Remove">✕</button>
                            </div>
                        }

                        <div class="pc-add">
                            <select @bind="_kind">
                                <option value="gold">🪙 Gold</option>
                                <option value="goods">📦 Goods</option>
                                <option value="colony">⛵ Colony</option>
                                <option value="annex">🏰 Annex them</option>
                            </select>
                            @if (_kind != "annex")
                            {
                                <select @bind="_side">
                                    <option value="you">You give</option>
                                    <option value="them">@enemy.Name gives</option>
                                </select>
                            }
                            @if (_kind == "goods")
                            {
                                <select @bind="_product">
                                    @foreach (var prod in TradeCatalog.All)
                                    {
                                        <option value="@prod.Id">@prod.Icon @prod.Name (you @player.GetProductStock(prod.Id).ToString("N0") · them @enemy.GetProductStock(prod.Id).ToString("N0"))</option>
                                    }
                                </select>
                            }
                            @if (_kind == "colony")
                            {
                                <select @bind="_colony">
                                    <option value="">— choose a colony —</option>
                                    @foreach (var c in Engine.State.Colonies.Where(c => c.OwnerId == (YouGive ? player.Id : enemy.Id)))
                                    {
                                        <option value="@c.Id">@c.Name (👥 @c.Population.ToString("N0"))</option>
                                    }
                                </select>
                            }
                            @if (_kind is "gold" or "goods")
                            {
                                <input type="number" class="pc-num" min="1" @bind="_amount" placeholder="amount" />
                                @if (_kind == "gold")
                                {
                                    <div class="pc-quick">
                                        @foreach (var pct in new[] { 10, 25, 50, 100 })
                                        {
                                            <button @onclick="() => _amount = Math.Floor((YouGive ? player.Gold : enemy.Gold) * pct / 100.0)">@pct%</button>
                                        }
                                        <span class="pc-hint">(@(YouGive ? "you hold" : enemy.Name + " holds") @((YouGive ? player.Gold : enemy.Gold).ToString("N0")))</span>
                                    </div>
                                }
                            }
                            <button class="pc-btn alt small" @onclick="() => AddTerm(enemy)">+ ADD TERM</button>
                        </div>

                        <div class="pc-actions">
                            <button class="pc-btn go" @onclick="() => Send(enemy, pending)">@(theirs ? "SEND COUNTEROFFER" : "SEND PROPOSAL")</button>
                            @if (theirs)
                            {
                                <button class="pc-btn cancel" @onclick="() => _countering = false">BACK</button>
                            }
                        </div>
                        <div class="pc-hint">Nothing moves, and the war does not end, until the other side accepts. Terms are checked against what each country really owns.</div>
                    </div>
                }

                @if (history.Count > 0)
                {
                    <div class="pc-label">Talks so far</div>
                    @foreach (var o in history)
                    {
                        <div class="pc-hist">
                            <b>@(o.ProposerId == player.Id ? "You" : enemy.Name) · round @o.Round · @o.Status</b>
                            <span>@string.Join("; ", PeaceService.Describe(Engine.State, o))</span>
                            @if (!string.IsNullOrEmpty(o.Outcome) && o.Status is PeaceOfferStatus.Rejected or PeaceOfferStatus.Expired)
                            {
                                <small>@o.Outcome</small>
                            }
                        </div>
                    }
                }
            }
        </div>
    </div>
}

@code {
    /// <summary>The country to negotiate with; null keeps the dialog closed.</summary>
    [Parameter] public string? NationId { get; set; }

    [Parameter] public EventCallback OnClose { get; set; }

    private string? _opened;
    private readonly List<PeaceTerm> _terms = new();
    private bool _peace = true;
    private bool _countering;
    private string _kind = "gold";
    private string _side = "you";   // who gives: "you" or "them" (string values: a bool does not bind to <option> values)
    private bool YouGive => _side == "you";
    private string _product = "wheat";
    private string _colony = "";
    private double _amount = 1000;
    private string? _msg;
    private bool _msgOk;

    protected override void OnInitialized() => Engine.StateChanged += OnStateChanged;
    private void OnStateChanged() => InvokeAsync(StateHasChanged);
    public void Dispose() => Engine.StateChanged -= OnStateChanged;

    protected override void OnParametersSet()
    {
        if (NationId == _opened) return;
        _opened = NationId;
        _terms.Clear();
        _peace = true;
        _countering = false;
        _msg = null;
    }

    private async Task Close() => await OnClose.InvokeAsync();

    private void StartCounter(PeaceOffer offer)
    {
        // The counteroffer starts from their terms: the player edits what they want different.
        _terms.Clear();
        _terms.AddRange(offer.Terms.Where(t => t.Kind != PeaceTermKind.Peace).Select(t => t.Copy()));
        _peace = offer.Terms.Any(t => t.Kind == PeaceTermKind.Peace);
        _countering = true;
        _msg = null;
    }

    private void AddTerm(Nation enemy)
    {
        var player = Engine.State.PlayerNation;
        string giver = YouGive ? player.Id : enemy.Id, receiver = YouGive ? enemy.Id : player.Id;
        _msg = null;
        switch (_kind)
        {
            case "gold":
                if (_amount <= 0) { Say("Enter an amount above zero.", false); return; }
                _terms.Add(PeaceTerm.Gold(giver, receiver, _amount));
                break;
            case "goods":
                if (_amount <= 0) { Say("Enter a quantity above zero.", false); return; }
                _terms.Add(PeaceTerm.Goods(giver, receiver, _product, _amount));
                break;
            case "colony":
                if (string.IsNullOrEmpty(_colony)) { Say("Choose a colony.", false); return; }
                _terms.Add(PeaceTerm.Colony(giver, receiver, _colony));
                _colony = "";
                break;
            default:
                _terms.Add(PeaceTerm.Annexation(enemy.Id, player.Id));
                break;
        }
    }

    private void Send(Nation enemy, PeaceOffer? pending)
    {
        var terms = new List<PeaceTerm>();
        if (_peace) terms.Add(PeaceTerm.Peace());
        terms.AddRange(_terms);
        var result = pending is not null && pending.ReceiverId == Engine.State.PlayerNation.Id
            ? Engine.CounterPeaceOffer(pending.Id, terms)
            : Engine.ProposePeace(enemy.Id, terms);
        Say(result.Message, result.Ok);
        if (result.Ok) { _terms.Clear(); _countering = false; }
    }

    private void Respond(Func<DipResult> action)
    {
        var result = action();
        Say(result.Message, result.Ok);
        _countering = false;
    }

    private void Say(string message, bool ok) { _msg = message; _msgOk = ok; }
}

<style>
.pc-overlay { position: fixed; inset: 0; z-index: 210; background: rgba(0,0,0,.6); display: flex; align-items: center; justify-content: center; padding: 12px 12px calc(12px + var(--safe-bottom)); }
.pc-panel { background: linear-gradient(#f5e6c4, #e2cb92); border: 3px double #8b6914; border-radius: 10px; padding: 14px; max-width: 420px; width: 100%; max-height: calc(92vh - var(--safe-bottom)); overflow-y: auto; position: relative; font-family: Georgia, serif; color: #3d2b1f; }
.pc-x { position: absolute; top: 6px; right: 8px; background: none; border: none; font-size: 1.1rem; cursor: pointer; color: #5a4a2a; }
.pc-title { font-size: 1.1rem; font-weight: bold; margin-bottom: 8px; padding-right: 24px; }
.pc-msg { padding: 7px 10px; border-radius: 6px; font-size: 0.85rem; margin-bottom: 8px; }
.pc-msg.ok { background: #d4edda; color: #155724; border: 1px solid #2e7d32; }
.pc-msg.bad, .pc-note { background: #f8d7da; color: #721c24; border: 1px solid #8B0000; }
.pc-note { padding: 8px 10px; border-radius: 6px; font-size: 0.88rem; }
.pc-sum { background: rgba(255,253,245,.6); border: 1px solid #b79a55; border-radius: 6px; padding: 6px 8px; margin-bottom: 8px; }
.pc-row { display: flex; justify-content: space-between; font-size: 0.82rem; padding: 2px 0; }
.pc-mood { font-size: 0.82rem; font-style: italic; margin-top: 4px; color: #5a4a2a; }
.pc-offer { border-radius: 6px; padding: 8px 10px; margin-bottom: 8px; }
.pc-offer.theirs { background: #fff3cd; border: 1px solid #c9a227; }
.pc-offer.mine { background: #e8eef7; border: 1px solid #6b83b3; }
.pc-offer-head { font-weight: bold; font-size: 0.9rem; margin-bottom: 4px; }
.pc-offer-head small { font-weight: normal; color: #5a4a2a; }
.pc-line { font-size: 0.86rem; padding: 1px 0; }
.pc-label { font-size: 0.78rem; font-weight: bold; color: #8b6914; text-transform: uppercase; margin: 8px 0 4px; }
.pc-check { display: block; font-size: 0.86rem; margin: 4px 0; }
.pc-term { display: flex; justify-content: space-between; align-items: center; gap: 6px; font-size: 0.85rem; background: rgba(255,253,245,.7); border: 1px solid #b79a55; border-radius: 6px; padding: 4px 8px; margin: 3px 0; }
.pc-term button { background: none; border: none; cursor: pointer; color: #8B0000; }
.pc-add { display: flex; flex-wrap: wrap; gap: 6px; align-items: center; margin: 6px 0; }
.pc-add select, .pc-num { padding: 6px; border: 2px solid #8b6914; border-radius: 6px; background: #fffdf5; font-family: inherit; max-width: 100%; }
.pc-num { width: 110px; }
.pc-quick { display: flex; gap: 4px; align-items: center; flex-basis: 100%; }
.pc-quick button { padding: 3px 8px; border-radius: 5px; border: 1px solid #8b6914; background: linear-gradient(#f7ead0, #d9bd85); font-family: inherit; cursor: pointer; }
.pc-actions { display: flex; gap: 8px; margin-top: 8px; flex-wrap: wrap; }
.pc-btn { flex: 1; padding: 9px 8px; border-radius: 6px; cursor: pointer; font-family: inherit; border: 2px solid #2e1c0c; color: #fff; font-weight: bold; min-width: 90px; }
.pc-btn.go { background: linear-gradient(#3f8f4f, #25602f); }
.pc-btn.no { background: linear-gradient(#a33, #6b1a1a); }
.pc-btn.alt { background: linear-gradient(#7a5230, #4a2e14); color: #f5e6c4; }
.pc-btn.cancel { background: linear-gradient(#8a8a8a, #5a5a5a); }
.pc-btn.small { flex: none; padding: 5px 10px; }
.pc-hint { font-size: 0.76rem; color: #5a4a2a; margin-top: 4px; }
.pc-hist { font-size: 0.8rem; padding: 4px 0; border-bottom: 1px dotted #b79a55; display: flex; flex-direction: column; }
.pc-hist small { color: #8B0000; }
</style>
