@inherits LayoutComponentBase
@inject GameEngine Engine
@inject NavigationManager Nav
@inject NavigationHistory History
@implements IDisposable

<div class="page">
    <NavigationTracker />
    @if (Engine.CampaignChosen)
    {
        @if (!IsMapPage)
        {
            <TopBar />
            <VictoryBanner />
            <PeaceBanner />
        }
        <main class="@(IsMapPage ? "map-full" : null)">
            @* The Back ribbon hangs from the top-right corner of the page content (not from the status bar above it); a page's first row keeps clear of it. *@
            <article class="content @(IsMapPage ? "content-map" : null) @(!IsMapPage && History.CanGoBack ? "has-back" : null)">
                <BackButton Floating="@IsMapPage" />
                @Body
            </article>
        </main>
    }
    else
    {
        <NationSelect />
    }
</div>

@code {
    private bool _triedAutoLoad;

    // The world map is a full-screen war-room chart: no top bar, no chrome.
    private bool IsMapPage =>
        Nav.ToBaseRelativePath(Nav.Uri).Trim('/').StartsWith("map", StringComparison.OrdinalIgnoreCase);

    protected override void OnInitialized()
    {
        Engine.StateChanged += OnStateChanged;
        History.Changed += OnStateChanged;   // (the ribbon appears when there is somewhere to go back to, and the first row makes room for it)
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Returning players go straight to the main screen; only new users
        // (no save yet) see the nation-select screen.
        if (firstRender && !_triedAutoLoad && !Engine.CampaignChosen && Engine.HasSave)
        {
            _triedAutoLoad = true;
            await Engine.LoadAsync();
        }
    }

    private void OnStateChanged() => InvokeAsync(StateHasChanged);
    public void Dispose()
    {
        Engine.StateChanged -= OnStateChanged;
        History.Changed -= OnStateChanged;
    }
}
