@inherits LayoutComponentBase
@inject GameEngine Engine
@inject NavigationManager Nav
@implements IDisposable

<div class="page">
    @if (Engine.CampaignChosen)
    {
        @if (!IsMapPage)
        {
            <TopBar />
            <VictoryBanner />
        }
        <main class="@(IsMapPage ? "map-full" : null)">
            <article class="content @(IsMapPage ? "content-map" : null)">
                @Body
            </article>
        </main>
    }
    else
    {
        <NationSelect />
    }
</div>

@code {
    private bool _triedAutoLoad;

    // The world map is a full-screen war-room chart: no top bar, no chrome.
    private bool IsMapPage =>
        Nav.ToBaseRelativePath(Nav.Uri).Trim('/').StartsWith("map", StringComparison.OrdinalIgnoreCase);

    protected override void OnInitialized() => Engine.StateChanged += OnStateChanged;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Returning players go straight to the main screen; only new users
        // (no save yet) see the nation-select screen.
        if (firstRender && !_triedAutoLoad && !Engine.CampaignChosen && Engine.HasSave)
        {
            _triedAutoLoad = true;
            await Engine.LoadAsync();
        }
    }

    private void OnStateChanged() => InvokeAsync(StateHasChanged);
    public void Dispose() => Engine.StateChanged -= OnStateChanged;
}
