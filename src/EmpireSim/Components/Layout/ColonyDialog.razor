@using EmpireSim.Core.Models
@using EmpireSim.Core.Services
@inject GameEngine Engine
@implements IDisposable

@* The colonisation popup: what settling a region costs, how long it takes, when the colonists would land, and what the country has of each
   requirement. Confirming checks everything again (the region still unclaimed, the country still able to pay), takes the cost once and sends the
   mission; a refused mission changes nothing, and the dialog stays open and says why. *@
@if (RegionId is not null && Engine.State.RegionOf(RegionId) is { } region)
{
    var state = Engine.State;
    var player = state.PlayerNation;
    var q = Engine.QuoteColony(RegionId)!;
    var size = ColonizationService.SizeOf(q.Area);

    <div class="col-overlay" @onclick="Close">
        <BackLayer OnBack="Close" />
        <div class="col-panel" @onclick:stopPropagation>
            <button class="col-x" @onclick="Close" title="Close">✕</button>
            <div class="col-title">⛵ Colonise @region.Name</div>

            <div class="col-row"><span>Status</span><b>@ColonizationService.StatusText(state, region)</b></div>
            <div class="col-row"><span>Area</span><b>≈ @ColonizationService.AreaKm2(region).ToString("N0") km² (@ColonizationService.SizeName(size))</b></div>
            <div class="col-row"><span>Journey</span><b>@(q.Overland ? ColonizationService.Journey(true, region.Terrain) : $"{ColonizationService.Journey(false, region.Terrain)}; {q.Warships} warships carry the settlers")</b></div>
            <div class="col-row"><span>Duration</span><b>@q.Days days</b></div>
            <div class="col-row"><span>Estimated landing</span><b>@q.Completion.ToString("dd-MM-yyyy")</b></div>

            <div class="col-label">Requirements</div>
            @foreach (var rq in ColonizationService.Requirements(state, player, q))
            {
                <div class="col-req @(rq.Met ? "ok" : "bad")">
                    <span>@(rq.Met ? "✓" : "✗") @rq.Icon @rq.Label</span>
                    <span><b>@rq.Need</b> <small>· have @rq.Have</small></span>
                </div>
            }

            <div class="col-note">
                The gold, wheat, wood and settlers are taken now, once, and cannot be recalled. The colony is founded only when the colonists land on the date above:
                if @player.Name falls@(q.Overland ? "" : " or its fleet is lost") before then, the mission fails and the cost is lost. Nobody else can settle @region.Name while the mission is under way.
            </div>

            @if (q.Block is { } why)
            {
                <div class="col-err">🔒 @why</div>
            }
            @if (!string.IsNullOrEmpty(_error))
            {
                <div class="col-err">@_error</div>
            }

            <div class="col-actions">
                <button class="col-btn cancel" @onclick="Close">CANCEL</button>
                <button class="col-btn confirm" disabled="@(q.Block is not null)" @onclick="() => Send(region.Id)">⛵ SEND COLONISATION MISSION</button>
            </div>
        </div>
    </div>
}

@code {
    /// <summary>The colony region to settle; null keeps the dialog closed.</summary>
    [Parameter] public string? RegionId { get; set; }

    /// <summary>Raised when the dialog is dismissed without sending.</summary>
    [Parameter] public EventCallback OnClose { get; set; }

    /// <summary>Raised once the mission has been confirmed and sent.</summary>
    [Parameter] public EventCallback OnSent { get; set; }

    protected override void OnInitialized() => Engine.StateChanged += OnStateChanged;
    private void OnStateChanged() => InvokeAsync(StateHasChanged);
    public void Dispose() => Engine.StateChanged -= OnStateChanged;

    private string? _opened;
    private string? _error;

    protected override void OnParametersSet()
    {
        if (RegionId != _opened) { _opened = RegionId; _error = null; }
    }

    private async Task Close() => await OnClose.InvokeAsync();

    private async Task Send(string regionId)
    {
        // The engine checks it all again: still unclaimed, still affordable, nothing else under way. A refusal leaves everything as it was.
        var error = Engine.FoundColony(regionId);
        if (error is not null) { _error = error; return; }
        await OnSent.InvokeAsync();
    }
}

<style>
.col-overlay { position: fixed; inset: 0; z-index: 200; background: rgba(0,0,0,.6); display: flex; align-items: center; justify-content: center; padding: 12px 12px calc(12px + var(--safe-bottom)); }
.col-panel { background: linear-gradient(#f5e6c4, #e2cb92); border: 3px double #8b6914; border-radius: 10px; padding: 14px; max-width: 400px; width: 100%; max-height: calc(90vh - var(--safe-bottom)); overflow-y: auto; position: relative; font-family: Georgia, serif; color: #3d2b1f; }
.col-x { position: absolute; top: 6px; right: 8px; background: none; border: none; font-size: 1.1rem; cursor: pointer; color: #5a4a2a; }
.col-title { font-size: 1.15rem; font-weight: bold; margin-bottom: 10px; padding-right: 24px; }
.col-row { display: flex; justify-content: space-between; gap: 10px; font-size: 0.9rem; padding: 3px 0; border-bottom: 1px dotted #b79a55; }
.col-row b { text-align: right; }
.col-label { font-size: 0.8rem; font-weight: bold; color: #8b6914; text-transform: uppercase; margin: 10px 0 4px; }
.col-req { display: flex; justify-content: space-between; gap: 10px; font-size: 0.86rem; padding: 4px 6px; margin-bottom: 3px; border-radius: 5px; background: rgba(255,253,245,.7); border: 1px solid #c9b98a; }
.col-req small { color: #5a4a2a; }
.col-req.ok > span:first-child { color: #2e6b2e; }
.col-req.bad { border-color: #8B0000; background: #f8d7da; }
.col-req.bad > span:first-child { color: #8B0000; font-weight: bold; }
.col-note { font-size: 0.8rem; margin: 10px 0 6px; padding: 8px 10px; border-radius: 6px; background: #fff3cd; color: #664d03; border: 1px solid #c9a227; line-height: 1.3; }
.col-err { background: #f8d7da; color: #721c24; border: 1px solid #8B0000; border-radius: 6px; padding: 8px 10px; font-size: 0.88rem; margin: 6px 0; }
.col-actions { display: flex; gap: 10px; margin-top: 12px; }
.col-btn { flex: 1; padding: 10px; border-radius: 6px; cursor: pointer; font-family: inherit; border: 2px solid #2e1c0c; }
.col-btn.cancel { background: linear-gradient(#8a8a8a, #5a5a5a); color: #fff; }
.col-btn.confirm { background: linear-gradient(#3a7a3a, #1f4f1f); color: #fff; font-weight: bold; }
.col-btn.confirm:disabled { opacity: 0.4; cursor: not-allowed; }
</style>
