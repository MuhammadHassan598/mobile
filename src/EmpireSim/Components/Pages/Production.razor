@page "/production"
@using EmpireSim.Core.Models
@using EmpireSim.Core.Services
@inject GameEngine Engine
@implements IDisposable

<div class="prod-wrap">
    <!-- Top category tabs -->
    <div class="prod-top-tabs">
        <button class="top-tab @(_category == ProductionCategory.Military ? "active" : "")"
                @onclick="() => _category = ProductionCategory.Military" title="Military">
            ⚔️
        </button>
        <button class="top-tab @(_category == ProductionCategory.Food ? "active" : "")"
                @onclick="() => _category = ProductionCategory.Food" title="Food & Mills">
            🌾
        </button>
        <button class="top-tab @(_category == ProductionCategory.Minerals ? "active" : "")"
                @onclick="() => _category = ProductionCategory.Minerals" title="Minerals">
            ⛏️
        </button>
    </div>

    <div class="prod-list">
        @foreach (var spec in ProductionCatalog.ByCategory(_category))
        {
            int count = _nation.GetProductionBuilding(spec.Id);
            double output = count * spec.OutputPerDay;
            bool afford = _nation.CanPay(spec.GoldCost) && _nation.Wood >= spec.WoodCost && _nation.Iron >= spec.IronCost;
            <div class="prod-item">
                <div class="prod-item-icon">@spec.Icon</div>
                <div class="prod-item-body">
                    <div class="prod-item-name">@spec.Name: @count</div>
                    <div class="prod-item-prod">@spec.Produces: @output.ToString("N0")</div>
                </div>
                <button class="prod-item-btn" disabled="@(!afford)" @onclick="() => Build(spec.Id)" title="@ProductionCatalog.CostText(spec) (@spec.BuildDays days)">
                    📐
                </button>
            </div>
        }
    </div>
    @if (!string.IsNullOrEmpty(_error))
    {
        <div class="prod-error">@_error</div>
    }
</div>

@code {
    private Nation _nation => Engine.State.PlayerNation;
    private ProductionCategory _category = ProductionCategory.Food;
    private string? _error;

    protected override void OnInitialized()
    {
        Engine.StateChanged += OnStateChanged;
    }

    private void OnStateChanged() => InvokeAsync(StateHasChanged);

    private void Build(string id)
    {
        _error = Engine.BuildProduction(id);
    }

    public void Dispose() => Engine.StateChanged -= OnStateChanged;
}

<style>
.prod-wrap {
    background:
        radial-gradient(ellipse at 50% 0%, rgba(255,255,255,.4), transparent 60%),
        linear-gradient(#f0e0b0, #e8d090);
    min-height: 100vh;
    padding: 10px 8px 20px;
    font-family: Georgia, 'Times New Roman', serif;
}
.prod-top-tabs {
    display: flex; justify-content: center; gap: 14px;
    margin-bottom: 10px;
}
.top-tab {
    width: 52px; height: 52px; border-radius: 50%;
    background: radial-gradient(circle at 35% 30%, #8a6a3a, #4a3520);
    border: 2px solid #2e1c0c;
    font-size: 1.5rem; cursor: pointer; padding: 0;
    display: flex; align-items: center; justify-content: center;
    box-shadow: 0 2px 6px rgba(0,0,0,.5), inset 0 1px 2px rgba(255,255,255,.3);
    filter: grayscale(30%);
}
.top-tab.active {
    border-color: #ffd700;
    filter: none;
    box-shadow: 0 0 12px rgba(255,215,0,.8), 0 2px 6px rgba(0,0,0,.5);
}
.prod-list { display: flex; flex-direction: column; gap: 4px; }
.prod-item {
    display: flex; align-items: center; gap: 8px;
}
.prod-item-icon {
    width: 46px; height: 46px; border-radius: 50%;
    background: radial-gradient(circle at 35% 30%, #f7ead0, #d9bd85);
    border: 2px solid #6b4a2a;
    display: flex; align-items: center; justify-content: center;
    font-size: 1.4rem; flex-shrink: 0;
    box-shadow: 0 1px 3px rgba(0,0,0,.4);
}
.prod-item-body { flex: 1; min-width: 0; display: flex; flex-direction: column; }
.prod-item-name {
    background: #1a1a1a;
    color: #ffffff;
    font-size: 0.92rem; font-weight: bold;
    padding: 3px 10px;
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
    border-radius: 1px;
}
.prod-item-prod {
    color: #2a1f14;
    font-size: 0.85rem;
    padding: 1px 4px 0;
}
.prod-item-btn {
    width: 38px; height: 38px; flex-shrink: 0;
    background: linear-gradient(#3a3a3a, #1f1f1f);
    border: 1px solid #000; border-radius: 4px;
    font-size: 1.1rem; cursor: pointer; color: #f5e6c4;
    display: flex; align-items: center; justify-content: center;
    box-shadow: 0 1px 3px rgba(0,0,0,.5);
}
.prod-item-btn:disabled { opacity: 0.35; cursor: not-allowed; }
.prod-item-btn:not(:disabled):active { transform: translateY(1px); }
.prod-error {
    background: #8B0000; color: #fff; padding: 8px; border-radius: 4px;
    margin-top: 8px; text-align: center; font-size: 0.9rem;
    font-family: inherit;
}
</style>
