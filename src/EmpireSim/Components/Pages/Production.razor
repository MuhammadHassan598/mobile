@page "/production"
@using EmpireSim.Core.Models
@using EmpireSim.Core.Services
@inject GameEngine Engine
@implements IDisposable

<div class="prod-wrap">
    <div class="prod-header">
        <h2>🏭 Production</h2>
    </div>

    <div class="prod-cat-row">
        <button class="cat-icon-btn @(_category == ProductionCategory.Military ? "active" : "")"
                @onclick="() => SelectCategory(ProductionCategory.Military)" title="Military Production">🪖</button>
        <button class="cat-icon-btn @(_category == ProductionCategory.Food ? "active" : "")"
                @onclick="() => SelectCategory(ProductionCategory.Food)" title="Food & Textile Production">🌾</button>
        <button class="cat-icon-btn @(_category == ProductionCategory.Minerals ? "active" : "")"
                @onclick="() => SelectCategory(ProductionCategory.Minerals)" title="Mineral & Material Production">⛏️</button>
    </div>

    @if (_category == ProductionCategory.Military)
    {
        <!-- Military: 3x2 grid of box cards (crafting, not buildings) -->
        <div class="mil-grid">
            @foreach (var recipe in MilitaryRecipes.All)
            {
                double stock = _nation.GetMilitaryItem(recipe.Id);
                var active = _nation.MilitaryCraftQueue.FirstOrDefault(p => p.RecipeId == recipe.Id);
                bool inProg = active is not null;
                bool canAfford = _nation.Wood >= recipe.WoodCost && _nation.Stone >= recipe.StoneCost &&
                               _nation.Iron >= recipe.IronCost && _nation.Copper >= recipe.CopperCost &&
                               _nation.Lead >= recipe.LeadCost;
                <div class="mil-card @(_highlighted.Contains(recipe.Id) ? "highlight" : "")">
                    <button class="mil-info" @onclick="() => _milInfo = recipe">ⓘ</button>
                    <div class="mil-icon">@recipe.Icon</div>
                    <div class="mil-name">@recipe.Name</div>
                    <div class="mil-stock">Stock: @stock.ToString("N0")</div>
                    @if (inProg)
                    {
                        <button class="mil-btn stop" @onclick="() => Engine.CancelMilitaryCraft(active!.Id)">Stop</button>
                    }
                    else
                    {
                        <button class="mil-btn start @(!canAfford ? "" : "ready")" disabled="@(!canAfford)" @onclick="() => StartCraft(recipe.Id)">Start</button>
                    }
                </div>
            }
        </div>
        @if (_milInfo is not null)
        {
            <div class="popup-overlay" @onclick="() => _milInfo = null">
                <div class="popup-panel" @onclick:stopPropagation>
                    <div class="popup-header"><span class="popup-icon">@_milInfo.Icon</span><span class="popup-title">@_milInfo.Name</span></div>
                    <div class="popup-section"><div class="popup-section-title">Requirement for 10</div><div class="info-line">@MilitaryRecipes.RequirementsText(_milInfo)</div></div>
                    <div class="popup-section"><div class="popup-section-title">Production Time</div><div class="info-line">⏱️ @_milInfo.Days days</div></div>
                    <div class="popup-section"><div class="popup-section-title">Condition</div><div class="info-line">@_milInfo.Condition</div></div>
                    <div class="popup-actions"><button class="popup-btn cancel" @onclick="() => _milInfo = null">Close</button></div>
                </div>
            </div>
        }
    }
    else
    {
    <div class="prod-list">
        @foreach (var spec in ProductionCatalog.ByCategory(_category))
        {
            int built = _nation.GetProductionBuilding(spec.Id);
            double inventory = _nation.GetGood(spec.Produces);
            double perDay = built * spec.OutputPerDay;
            var inProgress = _nation.ConstructionQueue
                .Where(p => p.ProductionBuildingId == spec.Id)
                .ToList();
            int progCount = inProgress.Count;
            double progPct = progCount > 0 ? inProgress.Average(p => p.Progress) * 100 : 0;
            int daysLeft = progCount > 0 ? inProgress.Min(p => p.DaysLeft) : 0;
            bool afford = _nation.CanPay(spec.GoldCost) && _nation.Wood >= spec.WoodCost
                       && _nation.Stone >= spec.StoneCost && _nation.Iron >= spec.IronCost;

            <div class="prod-row">
                <div class="prod-icon-wrap">
                    <div class="prod-row-icon">
                        @spec.Icon
                        @if (progCount > 0)
                        {
                            <!-- Progress ring -->
                            <svg class="prog-ring" viewBox="0 0 44 44">
                                <circle cx="22" cy="22" r="20" fill="none" stroke="#ddd" stroke-width="3"/>
                                <circle cx="22" cy="22" r="20" fill="none" stroke="#4caf50" stroke-width="3"
                                        stroke-dasharray="@(progPct * 1.256) 125.6"
                                        stroke-linecap="round" transform="rotate(-90 22 22)"/>
                            </svg>
                            <span class="prog-badge">@progCount</span>
                        }
                    </div>
                    @if (progCount > 0)
                    {
                        <div class="prog-days">@daysLeft d</div>
                    }
                </div>
                <div class="prod-row-body">
                    <div class="prod-row-name">@spec.Name: @built</div>
                    <div class="prod-row-output">@spec.Produces: @inventory.ToString("N0") <em>(+@perDay.ToString("N0")/day)</em></div>
                </div>
                <button class="prod-info-btn" @onclick="() => ShowInfo(spec)" title="Details">ⓘ</button>
                <button class="prod-row-btn" disabled="@(!afford)"
                        @onclick="() => OnBuildClick(spec)"
                        title="@ProductionCatalog.CostText(spec) · @spec.BuildDays days">📐</button>
            </div>
        }
    </div>
    }

    @if (!string.IsNullOrEmpty(_error))
    {
        <div class="prod-error">@_error</div>
    }

    <!-- Info popup -->
    @if (_infoSpec is not null)
    {
        int built = _nation.GetProductionBuilding(_infoSpec.Id);
        <div class="popup-overlay" @onclick="() => _infoSpec = null">
            <div class="popup-panel" @onclick:stopPropagation>
                <div class="popup-header">
                    <span class="popup-icon">@_infoSpec.Icon</span>
                    <span class="popup-title">@_infoSpec.Name</span>
                </div>
                <div class="popup-section">
                    <div class="popup-section-title">Production</div>
                    <div class="info-line">1 mill produces: <b>@_infoSpec.OutputPerDay.ToString("N0") @_infoSpec.Produces</b> per day</div>
                    <div class="info-line">You own: <b>@built</b> mills</div>
                    <div class="info-line">Total per day: <b>@((built * _infoSpec.OutputPerDay).ToString("N0")) @_infoSpec.Produces</b></div>
                    <div class="info-line">In stock: <b>@_nation.GetGood(_infoSpec.Produces).ToString("N0") @_infoSpec.Produces</b></div>
                </div>
                <div class="popup-section">
                    <div class="popup-section-title">Build Cost (each)</div>
                    <div class="info-line">@ProductionCatalog.CostText(_infoSpec)</div>
                    <div class="info-line">⏱️ @_infoSpec.BuildDays days</div>
                </div>
                <div class="popup-actions">
                    <button class="popup-btn cancel" @onclick="() => _infoSpec = null">Close</button>
                </div>
            </div>
        </div>
    }

    <!-- Build confirmation popup (Food & Minerals only) -->
    @if (_popupSpec is not null)
    {
        int qty = _popupQty < 1 ? 1 : _popupQty;
        double reqGold = _popupSpec.GoldCost * qty;
        double reqWood = _popupSpec.WoodCost * qty;
        double reqStone = _popupSpec.StoneCost * qty;
        double reqIron = _popupSpec.IronCost * qty;
        int totalDays = _popupSpec.BuildDays * qty;
        bool canAfford = _nation.CanPay(reqGold) && _nation.Wood >= reqWood && _nation.Stone >= reqStone && _nation.Iron >= reqIron;

        <div class="popup-overlay" @onclick="ClosePopup">
            <div class="popup-panel" @onclick:stopPropagation>
                <div class="popup-header">
                    <span class="popup-icon">@_popupSpec.Icon</span>
                    <span class="popup-title">Build @_popupSpec.Name</span>
                </div>
                <div class="popup-section">
                    <div class="popup-section-title">Quantity</div>
                    <div class="popup-qty-row">
                        <button class="qty-btn" @onclick="() => _popupQty = Math.Max(1, _popupQty - 1)">−</button>
                        <input type="number" class="qty-input" @bind="_popupQty" min="1" max="100" />
                        <button class="qty-btn" @onclick="() => _popupQty = Math.Min(100, _popupQty + 1)">+</button>
                    </div>
                </div>
                <div class="popup-section">
                    <div class="popup-section-title">Current Balance</div>
                    <div class="popup-res-row">
                        <span>🪙 Gold: @_nation.Gold.ToString("N0")</span>
                        <span>🪵 Wood: @_nation.Wood.ToString("N0")</span>
                        <span>🪨 Stone: @_nation.Stone.ToString("N0")</span>
                    </div>
                </div>
                <div class="popup-section">
                    <div class="popup-section-title">Required (×@qty)</div>
                    <div class="popup-res-row">
                        <span class="@(_nation.Gold >= reqGold ? "ok" : "lack")">🪙 @reqGold.ToString("N0")</span>
                        <span class="@(_nation.Wood >= reqWood ? "ok" : "lack")">🪵 @reqWood.ToString("N0")</span>
                        <span class="@(_nation.Stone >= reqStone ? "ok" : "lack")">🪨 @reqStone.ToString("N0")</span>
                        @if (reqIron > 0)
                        {
                            <span class="@(_nation.Iron >= reqIron ? "ok" : "lack")">⛓️ @reqIron.ToString("N0")</span>
                        }
                    </div>
                </div>
                <div class="popup-section">
                    <div class="popup-section-title">Construction Time</div>
                    <div class="popup-time">⏱️ @_popupSpec.BuildDays days each · @totalDays days total</div>
                </div>
                <div class="popup-actions">
                    <button class="popup-btn cancel" @onclick="ClosePopup">Cancel</button>
                    <button class="popup-btn confirm" @onclick="ConfirmBuild" disabled="@(!canAfford)">Build @qty</button>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private Nation _nation => Engine.State.PlayerNation;
    private ProductionCategory _category = ProductionCategory.Food;
    private string? _error;
    private ProductionBuildingSpec? _popupSpec;
    private int _popupQty = 1;
    private ProductionBuildingSpec? _infoSpec;
    private MilitaryRecipe? _milInfo;
    private HashSet<string> _highlighted = new();

    protected override void OnInitialized() => Engine.StateChanged += OnStateChanged;
    private void OnStateChanged() => InvokeAsync(StateHasChanged);
    private void SelectCategory(ProductionCategory cat) { _category = cat; _error = null; }

    private void OnBuildClick(ProductionBuildingSpec spec)
    {
        if (spec.Category == ProductionCategory.Military)
            _error = Engine.BuildProduction(spec.Id, 1);
        else
        {
            _popupSpec = spec;
            _popupQty = 1;
            _error = null;
        }
    }

    private void ClosePopup() { _popupSpec = null; _popupQty = 1; }

    private void ConfirmBuild()
    {
        if (_popupSpec is not null)
        {
            int qty = _popupQty < 1 ? 1 : _popupQty;
            _error = Engine.BuildProduction(_popupSpec.Id, qty);
            _popupSpec = null;
            _popupQty = 1;
        }
    }

    private void ShowInfo(ProductionBuildingSpec spec) => _infoSpec = spec;

    private async void StartCraft(string recipeId)
    {
        _error = Engine.StartMilitaryCraft(recipeId);
        if (string.IsNullOrEmpty(_error))
        {
            _highlighted.Add(recipeId);
            StateHasChanged();
            await Task.Delay(5000);
            _highlighted.Remove(recipeId);
            StateHasChanged();
        }
    }

    public void Dispose() => Engine.StateChanged -= OnStateChanged;
}

<style>
.prod-wrap {
    background: radial-gradient(ellipse at 50% 0%, rgba(255,255,255,.4), transparent 60%), linear-gradient(#f0e0b0, #e8d090);
    min-height: 100vh; padding: 10px 8px 90px;
    font-family: Georgia, 'Times New Roman', serif;
}
.prod-header h2 { text-align: center; color: #3d2b1f; margin: 0 0 10px; font-size: 1.35rem; letter-spacing: 1px; text-shadow: 0 1px 0 rgba(255,255,255,.5); }
.prod-cat-row { display: flex; justify-content: center; gap: 16px; margin-bottom: 12px; padding-bottom: 10px; border-bottom: 2px solid #8b6914; }
.cat-icon-btn {
    width: 58px; height: 58px; border-radius: 50%;
    background: radial-gradient(circle at 35% 30%, #8a6a3a, #4a3520);
    border: 3px solid #2e1c0c; font-size: 1.7rem; cursor: pointer; padding: 0;
    display: flex; align-items: center; justify-content: center;
    box-shadow: 0 2px 6px rgba(0,0,0,.5), inset 0 1px 2px rgba(255,255,255,.3);
    filter: grayscale(40%) brightness(0.9); transition: filter 0.15s, box-shadow 0.15s, transform 0.1s;
}
.cat-icon-btn:hover { filter: grayscale(20%) brightness(1); }
.cat-icon-btn:active { transform: translateY(1px); }
.cat-icon-btn.active { border-color: #ffd700; filter: none; box-shadow: 0 0 14px rgba(255,215,0,.8), 0 2px 6px rgba(0,0,0,.5); }
.prod-list { display: flex; flex-direction: column; gap: 3px; overflow-y: auto; }
.prod-row { display: flex; align-items: center; gap: 8px; padding: 2px 0; }
/* Icon with progress ring and badge */
.prod-icon-wrap { display: flex; flex-direction: column; align-items: center; flex-shrink: 0; }
.prod-row-icon {
    width: 44px; height: 44px; border-radius: 50%; position: relative;
    background: radial-gradient(circle at 35% 30%, #f7ead0, #d9bd85);
    border: 2px solid #6b4a2a; display: flex; align-items: center; justify-content: center;
    font-size: 1.35rem; box-shadow: 0 1px 3px rgba(0,0,0,.4);
}
.prog-ring { position: absolute; inset: -3px; width: 50px; height: 50px; pointer-events: none; }
.prog-badge {
    position: absolute; top: -6px; right: -6px;
    background: #d32f2f; color: #fff; font-size: 0.7rem; font-weight: bold;
    min-width: 20px; height: 20px; border-radius: 10px;
    display: flex; align-items: center; justify-content: center;
    border: 2px solid #fff; box-shadow: 0 1px 3px rgba(0,0,0,.4);
    font-family: Arial, sans-serif;
}
.prog-days { font-size: 0.7rem; color: #5a4a2a; margin-top: 1px; font-family: Arial, sans-serif; }
.prod-row-body { flex: 1; min-width: 0; display: flex; flex-direction: column; }
.prod-row-name { background: #1a1a1a; color: #fff; font-size: 0.9rem; font-weight: bold; padding: 3px 10px; border-radius: 1px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.prod-row-output { color: #2a1f14; font-size: 0.83rem; padding: 1px 4px 0; }
.prod-row-output em { font-style: normal; color: #6b5a3a; font-size: 0.78rem; }
.prod-info-btn {
    width: 32px; height: 32px; flex-shrink: 0; border-radius: 50%;
    background: radial-gradient(circle at 35% 30%, #e8d090, #c9a876);
    border: 2px solid #8b6914; font-size: 1rem; cursor: pointer; color: #3d2b1f;
    display: flex; align-items: center; justify-content: center;
    font-family: Georgia, serif; font-style: italic; font-weight: bold;
}
.prod-info-btn:active { transform: translateY(1px); }
.prod-row-btn {
    width: 36px; height: 36px; flex-shrink: 0;
    background: linear-gradient(#3a3a3a, #1f1f1f); border: 1px solid #000; border-radius: 4px;
    font-size: 1.05rem; cursor: pointer; color: #f5e6c4;
    display: flex; align-items: center; justify-content: center;
    box-shadow: 0 1px 3px rgba(0,0,0,.5); transition: transform 0.1s, filter 0.15s;
}
.prod-row-btn:disabled { opacity: 0.35; cursor: not-allowed; }
.prod-row-btn:not(:disabled):hover { filter: brightness(1.2); }
.prod-row-btn:not(:disabled):active { transform: translateY(1px); }
.prod-error { background: #8B0000; color: #fff; padding: 8px; border-radius: 4px; margin-top: 8px; text-align: center; font-size: 0.9rem; }
/* Popup */
.popup-overlay { position: fixed; inset: 0; z-index: 100; background: rgba(0,0,0,.6); display: flex; align-items: center; justify-content: center; padding: 20px; }
.popup-panel { background: linear-gradient(#f5e6c4, #e2cb92); border: 3px double #8b6914; border-radius: 10px; padding: 16px; max-width: 340px; width: 100%; box-shadow: 0 8px 24px rgba(0,0,0,.5); font-family: Georgia, serif; color: #3d2b1f; max-height: 85vh; overflow-y: auto; }
.popup-header { display: flex; align-items: center; gap: 10px; margin-bottom: 12px; padding-bottom: 8px; border-bottom: 2px solid #8b6914; }
.popup-icon { font-size: 2rem; }
.popup-title { font-size: 1.15rem; font-weight: bold; }
.popup-section { margin-bottom: 12px; }
.popup-section-title { font-size: 0.85rem; font-weight: bold; color: #8b6914; margin-bottom: 6px; text-transform: uppercase; letter-spacing: 0.5px; }
.popup-res-row { display: flex; gap: 12px; flex-wrap: wrap; font-size: 0.95rem; }
.popup-res-row .ok { color: #2a6b2a; }
.popup-res-row .lack { color: #8B0000; font-weight: bold; }
.popup-time { font-size: 1rem; }
.popup-actions { display: flex; gap: 10px; margin-top: 14px; }
.popup-btn { flex: 1; padding: 10px; border-radius: 6px; cursor: pointer; font-family: inherit; font-size: 1rem; border: 2px solid #2e1c0c; transition: transform 0.1s; }
.popup-btn:active { transform: translateY(1px); }
.popup-btn.cancel { background: linear-gradient(#8a8a8a, #5a5a5a); color: #fff; }
.popup-btn.confirm { background: linear-gradient(#7a5230, #4a2e14); color: #f5e6c4; }
.popup-btn.confirm:disabled { opacity: 0.4; cursor: not-allowed; }
.popup-qty-row { display: flex; align-items: center; gap: 8px; justify-content: center; }
.qty-btn { width: 36px; height: 36px; border-radius: 50%; background: linear-gradient(#7a5230, #4a2e14); color: #f5e6c4; border: 2px solid #2e1c0c; font-size: 1.2rem; cursor: pointer; display: flex; align-items: center; justify-content: center; }
.qty-btn:active { transform: translateY(1px); }
.qty-input { width: 70px; text-align: center; font-size: 1.1rem; padding: 6px; border: 2px solid #8b6914; border-radius: 6px; background: #fffdf5; color: #3d2b1f; font-family: inherit; }
.info-line { font-size: 0.95rem; margin-bottom: 4px; }
.info-line b { color: #2a1f14; }
/* Military grid: 3 per row, 2 rows */
.mil-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; }
.mil-card {
    position: relative;
    background: linear-gradient(#f5e6c4, #e2cb92);
    border: 3px double #8b6914; border-radius: 8px;
    padding: 10px 6px; text-align: center;
    display: flex; flex-direction: column; align-items: center; gap: 6px;
    box-shadow: inset 0 0 15px rgba(139,105,20,.15), 0 2px 6px rgba(0,0,0,.3);
    font-family: Georgia, serif;
}
.mil-info {
    position: absolute; top: 4px; right: 4px;
    width: 24px; height: 24px; border-radius: 50%;
    background: radial-gradient(circle at 35% 30%, #e8d090, #c9a876);
    border: 1px solid #8b6914; font-size: 0.8rem; cursor: pointer;
    display: flex; align-items: center; justify-content: center;
    font-style: italic; font-weight: bold; color: #3d2b1f; padding: 0;
}
.mil-icon { font-size: 2.2rem; }
.mil-name { font-weight: bold; font-size: 0.9rem; color: #2a1f14; }
.mil-stock { font-size: 0.82rem; color: #5a4a2a; }
.mil-prog { width: 100%; height: 6px; background: #d4b896; border-radius: 3px; overflow: hidden; }
.mil-prog-fill { height: 100%; background: #4caf50; transition: width 0.3s; }
.mil-days { font-size: 0.75rem; color: #5a4a2a; }
.mil-btn {
    width: 100%; padding: 8px; border-radius: 6px; cursor: pointer;
    font-family: inherit; font-size: 0.9rem; border: 2px solid #2e1c0c;
    transition: transform 0.1s, filter 0.15s;
}
.mil-btn:active { transform: translateY(1px); }
.mil-btn.start { background: linear-gradient(#7a5230, #4a2e14); color: #f5e6c4; }
.mil-btn.start:disabled { opacity: 0.4; cursor: not-allowed; }
.mil-btn.start:not(:disabled):hover { filter: brightness(1.15); }
.mil-btn.stop { background: linear-gradient(#8B0000, #5a0000); color: #fff; }
/* Light red highlight when crafting starts (auto-fades after 5s) */
.mil-card.highlight {
    background: linear-gradient(#f8c8c8, #f0a8a8);
    border-color: #d32f2f;
    box-shadow: 0 0 12px rgba(211,47,47,.5), inset 0 0 15px rgba(211,47,47,.2);
}
/* Start button active state when requirements met */
.mil-btn.start.ready {
    background: linear-gradient(#4caf50, #2e7d32);
    box-shadow: 0 2px 8px rgba(76,175,80,.4);
}
</style>
