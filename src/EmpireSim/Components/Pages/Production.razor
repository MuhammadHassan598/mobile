@page "/production"
@using EmpireSim.Core.Models
@using EmpireSim.Core.Services
@inject GameEngine Engine
@implements IDisposable

<div class="parchment-panel prod-competitor">
    <!-- Category tabs like competitor's top icons -->
    <div class="prod-tabs">
        <button class="prod-tab @(_category == ProductionCategory.Military ? "active" : "")"
                @onclick="() => _category = ProductionCategory.Military">
            <span class="tab-icon">⚔️</span>
        </button>
        <button class="prod-tab @(_category == ProductionCategory.Food ? "active" : "")"
                @onclick="() => _category = ProductionCategory.Food">
            <span class="tab-icon">🌾</span>
        </button>
        <button class="prod-tab @(_category == ProductionCategory.Minerals ? "active" : "")"
                @onclick="() => _category = ProductionCategory.Minerals">
            <span class="tab-icon">⛏️</span>
        </button>
    </div>

    <div class="prod-cat-list">
        @foreach (var spec in ProductionCatalog.ByCategory(_category))
        {
            int count = _nation.GetProductionBuilding(spec.Id);
            double output = count * spec.OutputPerDay;
            bool afford = _nation.CanPay(spec.GoldCost) && _nation.Wood >= spec.WoodCost && _nation.Iron >= spec.IronCost;
            <div class="prod-row">
                <span class="prod-icon-circle">@spec.Icon</span>
                <span class="prod-text">
                    <span class="prod-name-bar">@spec.Name: @count</span>
                    <span class="prod-sub">@spec.Produces: @output.ToString("N0")</span>
                </span>
                <button class="prod-build-btn" disabled="@(!afford)" @onclick="() => Build(spec.Id)" title="@ProductionCatalog.CostText(spec)">
                    🏗️
                </button>
            </div>
        }
    </div>
    @if (!string.IsNullOrEmpty(_error))
    {
        <div class="prod-error">@_error</div>
    }
</div>

@code {
    private Nation _nation => Engine.State.PlayerNation;
    private ProductionCategory _category = ProductionCategory.Food;
    private string? _error;

    protected override void OnInitialized()
    {
        Engine.StateChanged += OnStateChanged;
    }

    private void OnStateChanged() => InvokeAsync(StateHasChanged);

    private void Build(string id)
    {
        _error = Engine.BuildProduction(id);
    }

    public void Dispose() => Engine.StateChanged -= OnStateChanged;
}

<style>
.prod-competitor {
    padding: 10px 8px;
    min-height: 400px;
}
/* Top tabs - circular icons like competitor */
.prod-tabs {
    display: flex; justify-content: center; gap: 12px;
    margin-bottom: 12px; padding-bottom: 8px;
    border-bottom: 2px solid #8b6914;
}
.prod-tab {
    width: 56px; height: 56px; border-radius: 50%;
    background: radial-gradient(circle at 30% 30%, #f5e6c4, #d4b896);
    border: 3px solid #8b6914;
    display: flex; align-items: center; justify-content: center;
    cursor: pointer; padding: 0;
    box-shadow: 0 2px 5px rgba(0,0,0,.4);
}
.prod-tab .tab-icon { font-size: 1.6rem; }
.prod-tab.active {
    border-color: #ffd700;
    box-shadow: 0 0 10px rgba(255,215,0,.7), 0 2px 5px rgba(0,0,0,.4);
}
/* Building rows */
.prod-cat-list { display: flex; flex-direction: column; gap: 8px; }
.prod-row {
    display: flex; align-items: center; gap: 10px;
    padding: 2px;
}
.prod-icon-circle {
    width: 52px; height: 52px; border-radius: 50%;
    background: radial-gradient(circle at 30% 30%, #f5e6c4, #c9a876);
    border: 2px solid #5a4a2a;
    display: flex; align-items: center; justify-content: center;
    font-size: 1.6rem; flex-shrink: 0;
    box-shadow: inset 0 0 8px rgba(0,0,0,.2), 0 2px 4px rgba(0,0,0,.3);
}
.prod-text { flex: 1; display: flex; flex-direction: column; gap: 3px; min-width: 0; }
.prod-name-bar {
    background: linear-gradient(#3a3a3a, #1a1a1a);
    color: #f5e6c4; padding: 5px 12px; border-radius: 2px;
    font-weight: bold; font-size: 0.95rem;
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
    border: 1px solid #000;
    box-shadow: 0 1px 3px rgba(0,0,0,.5);
}
.prod-sub {
    color: #3d2b1f; font-size: 0.88rem; padding-left: 6px;
    font-weight: 500;
}
.prod-build-btn {
    width: 44px; height: 44px; flex-shrink: 0;
    background: linear-gradient(#6b4a2a, #4a2e14);
    border: 2px solid #2e1c0c; border-radius: 8px;
    font-size: 1.3rem; cursor: pointer;
    display: flex; align-items: center; justify-content: center;
    box-shadow: 0 2px 4px rgba(0,0,0,.4);
}
.prod-build-btn:disabled { opacity: 0.35; cursor: not-allowed; }
.prod-build-btn:not(:disabled):active { transform: translateY(1px); }
.prod-error {
    background: #8B0000; color: #fff; padding: 8px; border-radius: 4px;
    margin-top: 8px; text-align: center; font-size: 0.9rem;
}
</style>
