    min-width: 120px; padding: 10px 16px; border-radius: 6px; cursor: pointer;
    background: linear-gradient(#3a3a3a, #1f1f1f); border: 2px solid #000; color: #f5e6c4;
    font-family: inherit; font-size: 1rem; font-weight: bold; letter-spacing: 1px;
    box-shadow: 0 2px 4px rgba(0,0,0,.5);
}
.build-btn:disabled { opacity: 0.4; cursor: not-allowed; }
.build-btn:not(:disabled):active { transform: translateY(1px); }
.info-line { font-size: 0.95rem; margin-bottom: 4px; }
.info-line b { color: #2a1f14; }
/* Military grid: 3 per row, 2 rows */
.mil-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; }
.mil-card {
    position: relative;
    background: linear-gradient(#f5e6c4, #e2cb92);
    border: 3px double #8b6914; border-radius: 8px;
    padding: 10px 6px; text-align: center;
    display: flex; flex-direction: column; align-items: center; gap: 6px;
    box-shadow: inset 0 0 15px rgba(139,105,20,.15), 0 2px 6px rgba(0,0,0,.3);
    font-family: Georgia, serif;
}
.mil-info {
    position: absolute; top: 4px; right: 4px;
    width: 24px; height: 24px; border-radius: 50%;
    background: radial-gradient(circle at 35% 30%, #e8d090, #c9a876);
    border: 1px solid #8b6914; font-size: 0.8rem; cursor: pointer;
    display: flex; align-items: center; justify-content: center;
    font-style: italic; font-weight: bold; color: #3d2b1f; padding: 0;
}
.mil-icon { font-size: 2.2rem; }
.mil-name { font-weight: bold; font-size: 0.9rem; color: #2a1f14; }
.mil-stock { font-size: 0.82rem; color: #5a4a2a; }
.mil-prog { width: 100%; height: 6px; background: #d4b896; border-radius: 3px; overflow: hidden; }
.mil-prog-fill { height: 100%; background: #4caf50; transition: width 0.3s; }
.mil-days { font-size: 0.75rem; color: #5a4a2a; }
.mil-btn {
    width: 100%; padding: 8px; border-radius: 6px; cursor: pointer;
    font-family: inherit; font-size: 0.9rem; border: 2px solid #2e1c0c;
    transition: transform 0.1s, filter 0.15s;
}
.mil-btn:active { transform: translateY(1px); }
.mil-btn.start { background: linear-gradient(#7a5230, #4a2e14); color: #f5e6c4; }
