@page "/production"
@using EmpireSim.Core.Models
@using EmpireSim.Core.Services
@inject GameEngine Engine
@inject NavigationManager Nav
@implements IDisposable

<div class="prod-wrap">
    @if (_category is null)
    {
        <!-- CATEGORY SELECTION SCREEN -->
        <div class="prod-header">
            <h2>🏭 Production</h2>
        </div>

        <div class="cat-cards">
            <!-- Military -->
            <button class="cat-card" @onclick="() => _category = ProductionCategory.Military">
                <span class="cat-card-icon">🪖</span>
                <span class="cat-card-body">
                    <span class="cat-card-name">Military Production</span>
                    <span class="cat-card-desc">Weapons, equipment and military materials</span>
                    <span class="cat-card-count">6 production types</span>
                </span>
                <span class="cat-card-arrow">▶</span>
            </button>

            <!-- Food & Textile -->
            <button class="cat-card" @onclick="() => _category = ProductionCategory.Food">
                <span class="cat-card-icon">🌾</span>
                <span class="cat-card-body">
                    <span class="cat-card-name">Food & Textile Production</span>
                    <span class="cat-card-desc">Food, livestock, agricultural and textile goods</span>
                    <span class="cat-card-count">12 production types</span>
                </span>
                <span class="cat-card-arrow">▶</span>
            </button>

            <!-- Minerals -->
            <button class="cat-card" @onclick="() => _category = ProductionCategory.Minerals">
                <span class="cat-card-icon">⛏️</span>
                <span class="cat-card-body">
                    <span class="cat-card-name">Mineral & Material Production</span>
                    <span class="cat-card-desc">Mining, wood and construction materials</span>
                    <span class="cat-card-count">6 production types</span>
                </span>
                <span class="cat-card-arrow">▶</span>
            </button>
        </div>

        <button class="prod-back-btn" @onclick='() => Nav.NavigateTo("/")'>◀ Back</button>
    }
    else
    {
        <!-- PRODUCTION SUB-SCREEN (existing) -->
        <div class="prod-sub-header">
            <button class="prod-back-btn small" @onclick="() => _category = null">◀ Categories</button>
            <h3>@CategoryTitle(_category.Value)</h3>
        </div>

        <div class="prod-list">
            @foreach (var spec in ProductionCatalog.ByCategory(_category.Value))
            {
                int count = _nation.GetProductionBuilding(spec.Id);
                double output = count * spec.OutputPerDay;
                bool afford = _nation.CanPay(spec.GoldCost) && _nation.Wood >= spec.WoodCost && _nation.Iron >= spec.IronCost;
                <div class="prod-item">
                    <div class="prod-item-icon">@spec.Icon</div>
                    <div class="prod-item-body">
                        <div class="prod-item-name">@spec.Name: @count</div>
                        <div class="prod-item-prod">@spec.Produces: @output.ToString("N0")</div>
                    </div>
                    <button class="prod-item-btn" disabled="@(!afford)" @onclick="() => Build(spec.Id)" title="@ProductionCatalog.CostText(spec) (@spec.BuildDays days)">
                        📐
                    </button>
                </div>
            }
        </div>
        @if (!string.IsNullOrEmpty(_error))
        {
            <div class="prod-error">@_error</div>
        }
    }
</div>

@code {
    private Nation _nation => Engine.State.PlayerNation;
    private ProductionCategory? _category;
    private string? _error;

    protected override void OnInitialized()
    {
        Engine.StateChanged += OnStateChanged;
    }

    private void OnStateChanged() => InvokeAsync(StateHasChanged);

    private string CategoryTitle(ProductionCategory cat) => cat switch
    {
        ProductionCategory.Military => "⚔️ Military Production",
        ProductionCategory.Food => "🌾 Food & Textile Production",
        ProductionCategory.Minerals => "⛏️ Mineral & Material Production",
        _ => ""
    };

    private void Build(string id)
    {
        _error = Engine.BuildProduction(id);
    }

    public void Dispose() => Engine.StateChanged -= OnStateChanged;
}

<style>
.prod-wrap {
    background:
        radial-gradient(ellipse at 50% 0%, rgba(255,255,255,.4), transparent 60%),
        linear-gradient(#f0e0b0, #e8d090);
    min-height: 100vh;
    padding: 12px 10px 20px;
    font-family: Georgia, 'Times New Roman', serif;
}
/* Header */
.prod-header h2 {
    text-align: center; color: #3d2b1f; margin: 0 0 14px;
    font-size: 1.4rem; letter-spacing: 1px;
    text-shadow: 0 1px 0 rgba(255,255,255,.5);
}
/* Category cards */
.cat-cards { display: flex; flex-direction: column; gap: 12px; margin-bottom: 16px; }
.cat-card {
    display: flex; align-items: center; gap: 14px;
    background: linear-gradient(#f5e6c4, #e2cb92);
    border: 3px double #8b6914; border-radius: 8px;
    padding: 14px 12px; cursor: pointer; text-align: left; width: 100%;
    font-family: inherit; color: #3d2b1f;
    box-shadow: inset 0 0 20px rgba(139,105,20,.15), 0 3px 8px rgba(0,0,0,.3);
    transition: transform 0.1s, box-shadow 0.1s;
}
.cat-card:hover {
    box-shadow: inset 0 0 20px rgba(139,105,20,.25), 0 4px 12px rgba(0,0,0,.4);
}
.cat-card:active {
    transform: translateY(2px);
    box-shadow: inset 0 0 20px rgba(139,105,20,.3), 0 1px 4px rgba(0,0,0,.3);
}
.cat-card-icon {
    width: 64px; height: 64px; border-radius: 50%; flex-shrink: 0;
    background: radial-gradient(circle at 35% 30%, #f7ead0, #d9bd85);
    border: 3px solid #8b6914;
    display: flex; align-items: center; justify-content: center;
    font-size: 2rem;
    box-shadow: 0 2px 5px rgba(0,0,0,.4), inset 0 1px 2px rgba(255,255,255,.5);
}
.cat-card-body { flex: 1; display: flex; flex-direction: column; gap: 4px; min-width: 0; }
.cat-card-name {
    font-size: 1.1rem; font-weight: bold; color: #2a1f14;
    letter-spacing: 0.5px;
}
.cat-card-desc {
    font-size: 0.88rem; color: #5a4a2a; line-height: 1.3;
}
.cat-card-count {
    font-size: 0.82rem; color: #8b6914; font-style: italic;
}
.cat-card-arrow {
    font-size: 1.2rem; color: #8b6914; flex-shrink: 0;
}
/* Back button */
.prod-back-btn {
    display: block; width: 100%;
    background: linear-gradient(#7a5230, #4a2e14); color: #f5e6c4;
    border: 2px solid #2e1c0c; border-radius: 8px; padding: 12px;
    font-family: inherit; font-size: 1rem; cursor: pointer;
    box-shadow: 0 2px 5px rgba(0,0,0,.4);
    transition: transform 0.1s;
}
.prod-back-btn:active { transform: translateY(1px); }
.prod-back-btn.small {
    width: auto; padding: 8px 14px; margin-bottom: 10px;
    font-size: 0.9rem;
}
/* Sub-screen header */
.prod-sub-header h3 {
    color: #3d2b1f; margin: 0 0 10px; font-size: 1.15rem;
    text-align: center;
}
/* Building list (existing style preserved) */
.prod-list { display: flex; flex-direction: column; gap: 4px; }
.prod-item {
    display: flex; align-items: center; gap: 8px;
}
.prod-item-icon {
    width: 46px; height: 46px; border-radius: 50%;
    background: radial-gradient(circle at 35% 30%, #f7ead0, #d9bd85);
    border: 2px solid #6b4a2a;
    display: flex; align-items: center; justify-content: center;
    font-size: 1.4rem; flex-shrink: 0;
    box-shadow: 0 1px 3px rgba(0,0,0,.4);
}
.prod-item-body { flex: 1; min-width: 0; display: flex; flex-direction: column; }
.prod-item-name {
    background: #1a1a1a; color: #ffffff;
    font-size: 0.92rem; font-weight: bold;
    padding: 3px 10px; border-radius: 1px;
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
}
.prod-item-prod {
    color: #2a1f14; font-size: 0.85rem; padding: 1px 4px 0;
}
.prod-item-btn {
    width: 38px; height: 38px; flex-shrink: 0;
    background: linear-gradient(#3a3a3a, #1f1f1f);
    border: 1px solid #000; border-radius: 4px;
    font-size: 1.1rem; cursor: pointer; color: #f5e6c4;
    display: flex; align-items: center; justify-content: center;
    box-shadow: 0 1px 3px rgba(0,0,0,.5);
    transition: transform 0.1s, opacity 0.1s;
}
.prod-item-btn:disabled { opacity: 0.35; cursor: not-allowed; }
.prod-item-btn:not(:disabled):hover { filter: brightness(1.15); }
.prod-item-btn:not(:disabled):active { transform: translateY(1px); }
.prod-error {
    background: #8B0000; color: #fff; padding: 8px; border-radius: 4px;
    margin-top: 8px; text-align: center; font-size: 0.9rem;
}
</style>
