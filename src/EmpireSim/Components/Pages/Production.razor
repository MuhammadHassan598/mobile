    font-family: Arial, sans-serif;
}
.prog-days { font-size: 0.7rem; color: #5a4a2a; margin-top: 1px; font-family: Arial, sans-serif; }
.prod-row-body { flex: 1; min-width: 0; display: flex; flex-direction: column; }
.prod-row-name { background: #1a1a1a; color: #fff; font-size: 0.9rem; font-weight: bold; padding: 3px 10px; border-radius: 1px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.prod-row-output { color: #2a1f14; font-size: 0.83rem; padding: 1px 4px 0; }
.prod-row-output em { font-style: normal; color: #6b5a3a; font-size: 0.78rem; }
.prod-info-btn {
    width: 32px; height: 32px; flex-shrink: 0; border-radius: 50%;
    background: radial-gradient(circle at 35% 30%, #e8d090, #c9a876);
    border: 2px solid #8b6914; font-size: 1rem; cursor: pointer; color: #3d2b1f;
    display: flex; align-items: center; justify-content: center;
    font-family: Georgia, serif; font-style: italic; font-weight: bold;
}
.prod-info-btn:active { transform: translateY(1px); }
.prod-row-btn {
    width: 36px; height: 36px; flex-shrink: 0;
    background: linear-gradient(#3a3a3a, #1f1f1f); border: 1px solid #000; border-radius: 4px;
    font-size: 1.05rem; cursor: pointer; color: #f5e6c4;
    display: flex; align-items: center; justify-content: center;
    box-shadow: 0 1px 3px rgba(0,0,0,.5); transition: transform 0.1s, filter 0.15s;
}
.prod-row-btn:disabled { opacity: 0.35; cursor: not-allowed; }
.prod-row-btn:not(:disabled):hover { filter: brightness(1.2); }
.prod-row-btn:not(:disabled):active { transform: translateY(1px); }
.prod-error { background: #8B0000; color: #fff; padding: 8px; border-radius: 4px; margin-top: 8px; text-align: center; font-size: 0.9rem; }
/* Popup */
.popup-overlay { position: fixed; inset: 0; z-index: 100; background: rgba(0,0,0,.6); display: flex; align-items: center; justify-content: center; padding: 20px; }
.popup-panel { background: linear-gradient(#f5e6c4, #e2cb92); border: 3px double #8b6914; border-radius: 10px; padding: 16px; max-width: 340px; width: 100%; box-shadow: 0 8px 24px rgba(0,0,0,.5); font-family: Georgia, serif; color: #3d2b1f; max-height: 85vh; overflow-y: auto; }
.popup-header { display: flex; align-items: center; gap: 10px; margin-bottom: 12px; padding-bottom: 8px; border-bottom: 2px solid #8b6914; }
.popup-icon { font-size: 2rem; }
.popup-title { font-size: 1.15rem; font-weight: bold; }
.popup-section { margin-bottom: 12px; }
.popup-section-title { font-size: 0.85rem; font-weight: bold; color: #8b6914; margin-bottom: 6px; text-transform: uppercase; letter-spacing: 0.5px; }
.popup-actions { display: flex; gap: 10px; margin-top: 14px; }
.popup-btn { flex: 1; padding: 10px; border-radius: 6px; cursor: pointer; font-family: inherit; font-size: 1rem; border: 2px solid #2e1c0c; transition: transform 0.1s; }
.popup-btn:active { transform: translateY(1px); }
.popup-btn.cancel { background: linear-gradient(#8a8a8a, #5a5a5a); color: #fff; }
.popup-btn.confirm { background: linear-gradient(#7a5230, #4a2e14); color: #f5e6c4; }
.popup-btn.confirm:disabled { opacity: 0.4; cursor: not-allowed; }
/* Build mill popup (competitor style: resource cards, MAX arrow, label/value rows) */
.build-panel {
    position: relative; width: 100%; max-width: 320px; max-height: 85vh; overflow-y: auto;
    background: radial-gradient(ellipse at 50% 0%, rgba(255,255,255,.45), transparent 65%), linear-gradient(#f5e6c4, #e2cb92);
    border: 3px double #8b6914; border-radius: 10px; padding: 14px 16px 16px;
    box-shadow: 0 8px 24px rgba(0,0,0,.5); font-family: Georgia, serif; color: #3d2b1f;
}
.build-close {
    position: absolute; top: 8px; right: 8px; width: 30px; height: 30px; border-radius: 50%;
    background: radial-gradient(circle at 35% 30%, #f7ead0, #d9bd85); border: 2px solid #3d2b1f;
    color: #3d2b1f; font-size: 0.95rem; font-weight: bold; cursor: pointer; padding: 0;
    display: flex; align-items: center; justify-content: center;
}
.build-close:active { transform: translateY(1px); }
.build-title { display: flex; align-items: center; justify-content: center; gap: 8px; margin: 2px 30px 14px; font-weight: bold; font-size: 1.05rem; letter-spacing: 1px; }
.build-title-icon { font-size: 1.8rem; }
.build-costs { display: flex; justify-content: center; gap: 10px; margin-bottom: 14px; }
.build-cost-card {
    flex: 0 1 76px; min-width: 0; text-align: center; padding: 5px 4px 6px;
    background: linear-gradient(#efdcae, #dcc088); border: 2px solid #8b6914; border-radius: 6px;
    box-shadow: inset 0 0 8px rgba(139,105,20,.2), 0 1px 3px rgba(0,0,0,.3);
}
.build-cost-need { font-size: 0.72rem; font-weight: bold; color: #3d2b1f; font-family: Arial, sans-serif; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.build-cost-need.lack { color: #c62828; }
.build-cost-icon { font-size: 1.7rem; line-height: 1.25; }
.build-cost-have { background: #1f1f1f; color: #f5e6c4; font-size: 0.72rem; font-family: Arial, sans-serif; border-radius: 2px; padding: 1px 2px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.build-cost-label { font-size: 0.75rem; margin-top: 2px; }
.build-line { display: flex; align-items: center; justify-content: space-between; gap: 10px; padding: 8px 0; border-bottom: 1px solid rgba(139,105,20,.45); font-size: 0.95rem; }
.build-line-label { font-weight: bold; }
.build-line-value { display: flex; align-items: center; gap: 4px; }
.build-line-icon { font-size: 1rem; }
.build-qty { display: flex; align-items: stretch; flex: 0 1 150px; min-width: 0; }
.build-qty-input {
    flex: 1; min-width: 0; padding: 5px 8px; font-size: 1rem; font-family: inherit; color: #3d2b1f;
    background: #fffdf5; border: 2px solid #8b6914; border-right: none; border-radius: 4px 0 0 4px;
}
.build-max-btn {
    width: 34px; flex-shrink: 0; padding: 0; cursor: pointer; font-size: 0.95rem; color: #3d2b1f;
    background: linear-gradient(#f7ead0, #d9bd85); border: 2px solid #8b6914; border-radius: 0 4px 4px 0;
}
.build-max-btn:active { filter: brightness(.9); }
