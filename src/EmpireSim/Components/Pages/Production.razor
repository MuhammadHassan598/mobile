@page "/production"
@using EmpireSim.Core.Models
@using EmpireSim.Core.Services
@inject GameEngine Engine
@implements IDisposable

<div class="prod-wrap">
    <div class="prod-header">
        <h2>🏭 Production</h2>
    </div>

    <div class="prod-cat-row">
        <button class="cat-icon-btn @(_category == ProductionCategory.Military ? "active" : "")"
                @onclick="() => SelectCategory(ProductionCategory.Military)" title="Military Production">🪖</button>
        <button class="cat-icon-btn @(_category == ProductionCategory.Food ? "active" : "")"
                @onclick="() => SelectCategory(ProductionCategory.Food)" title="Food & Textile Production">🌾</button>
        <button class="cat-icon-btn @(_category == ProductionCategory.Minerals ? "active" : "")"
                @onclick="() => SelectCategory(ProductionCategory.Minerals)" title="Mineral & Material Production">⛏️</button>
    </div>

    @if (_category == ProductionCategory.Military)
    {
        <!-- Military: 3x2 grid of box cards (crafting, not buildings) -->
        <div class="mil-grid">
            @foreach (var recipe in MilitaryRecipes.All)
            {
                double stock = _nation.GetMilitaryItem(recipe.Id);
                var active = _nation.MilitaryCraftQueue.FirstOrDefault(p => p.RecipeId == recipe.Id);
                bool inProg = active is not null;
                bool canAfford = _nation.Wood >= recipe.WoodCost && _nation.Stone >= recipe.StoneCost &&
                               _nation.Iron >= recipe.IronCost && _nation.Copper >= recipe.CopperCost &&
                               _nation.Lead >= recipe.LeadCost;
                <div class="mil-card @(_highlightGreen.Contains(recipe.Id) ? "highlight-green" : _highlightRed.Contains(recipe.Id) ? "highlight-red" : "")">
                    <button class="mil-info" @onclick="() => _milInfo = recipe">ⓘ</button>
                    <div class="mil-icon">@recipe.Icon</div>
                    <div class="mil-name">@recipe.Name</div>
                    <div class="mil-stock">Stock: @stock.ToString("N0")</div>
                    @if (inProg)
                    {
                        <button class="mil-btn stop" @onclick="() => Engine.CancelMilitaryCraft(active!.Id)">Stop</button>
                    }
                    else
                    {
                        <button class="mil-btn start" @onclick="() => StartCraft(recipe.Id)">Start</button>
                    }
                </div>
            }
        </div>
        @if (_milInfo is not null)
        {
            <div class="popup-overlay" @onclick="() => _milInfo = null">
                <div class="popup-panel" @onclick:stopPropagation>
                    <div class="popup-header"><span class="popup-icon">@_milInfo.Icon</span><span class="popup-title">@_milInfo.Name</span></div>
                    <div class="popup-section"><div class="popup-section-title">Requirement for 10</div><div class="info-line">@MilitaryRecipes.RequirementsText(_milInfo)</div></div>
                    <div class="popup-section"><div class="popup-section-title">Production Time</div><div class="info-line">⏱️ @_milInfo.Days days</div></div>
                    <div class="popup-section"><div class="popup-section-title">Condition</div><div class="info-line">@_milInfo.Condition</div></div>
                    <div class="popup-actions"><button class="popup-btn cancel" @onclick="() => _milInfo = null">Close</button></div>
                </div>
            </div>
        }
    }
    else
    {
    <div class="prod-list">
        @foreach (var spec in ProductionCatalog.ByCategory(_category))
        {
            int built = _nation.GetProductionBuilding(spec.Id);
            double inventory = _nation.GetProduct(spec.Produces);
            double perDay = built * spec.OutputPerDay;
            var inProgress = _nation.ConstructionQueue
                .Where(p => p.ProductionBuildingId == spec.Id)
                .ToList();
            int progCount = inProgress.Count;
            double progPct = progCount > 0 ? inProgress.Average(p => p.Progress) * 100 : 0;
            int daysLeft = progCount > 0 ? inProgress.Min(p => p.DaysLeft) : 0;
            bool afford = _nation.CanPay(spec.GoldCost) && _nation.Wood >= spec.WoodCost
                       && _nation.Stone >= spec.StoneCost && _nation.Iron >= spec.IronCost;

            <div class="prod-row">
                <div class="prod-icon-wrap">
                    <div class="prod-row-icon">
                        @spec.Icon
                        @if (progCount > 0)
                        {
                            <!-- Progress ring -->
                            <svg class="prog-ring" viewBox="0 0 44 44">
                                <circle cx="22" cy="22" r="20" fill="none" stroke="#ddd" stroke-width="3"/>
                                <circle cx="22" cy="22" r="20" fill="none" stroke="#4caf50" stroke-width="3"
                                        stroke-dasharray="@(progPct * 1.256) 125.6"
                                        stroke-linecap="round" transform="rotate(-90 22 22)"/>
                            </svg>
                            <span class="prog-badge">@progCount</span>
                        }
                    </div>
                    @if (progCount > 0)
                    {
                        <div class="prog-days">@daysLeft d</div>
                    }
                </div>
                <div class="prod-row-body">
                    <div class="prod-row-name">@spec.Name: @built</div>
                    <div class="prod-row-output">@spec.Produces: @inventory.ToString("N0") <em>(+@perDay.ToString("N0")/day)</em></div>
                </div>
                <button class="prod-info-btn" @onclick="() => ShowInfo(spec)" title="Details">ⓘ</button>
                <button class="prod-row-btn" disabled="@(!afford)"
                        @onclick="() => OnBuildClick(spec)"
                        title="@ProductionCatalog.CostText(spec) · @spec.BuildDays days">📐</button>
            </div>
        }
    </div>
    }

    @if (!string.IsNullOrEmpty(_error))
    {
        <div class="prod-error">@_error</div>
    }

    <!-- Info popup -->
    @if (_infoSpec is not null)
    {
        int built = _nation.GetProductionBuilding(_infoSpec.Id);
        <div class="popup-overlay" @onclick="() => _infoSpec = null">
            <div class="popup-panel" @onclick:stopPropagation>
                <div class="popup-header">
                    <span class="popup-icon">@_infoSpec.Icon</span>
                    <span class="popup-title">@_infoSpec.Name</span>
                </div>
                <div class="popup-section">
                    <div class="popup-section-title">Production</div>
                    <div class="info-line">1 mill produces: <b>@_infoSpec.OutputPerDay.ToString("N0") @_infoSpec.Produces</b> per day</div>
                    <div class="info-line">You own: <b>@built</b> mills</div>
                    <div class="info-line">Total per day: <b>@((built * _infoSpec.OutputPerDay).ToString("N0")) @_infoSpec.Produces</b></div>
                    <div class="info-line">In stock: <b>@_nation.GetProduct(_infoSpec.Produces).ToString("N0") @_infoSpec.Produces</b></div>
                </div>
                <div class="popup-section">
                    <div class="popup-section-title">Build Cost (each)</div>
                    <div class="info-line">@ProductionCatalog.CostText(_infoSpec)</div>
                    <div class="info-line">⏱️ @_infoSpec.BuildDays days</div>
                </div>
                <div class="popup-actions">
                    <button class="popup-btn cancel" @onclick="() => _infoSpec = null">Close</button>
                </div>
            </div>
        </div>
    }

    <!-- Build confirmation popup (Food & Minerals only) -->
    @if (_popupSpec is not null)
    {
        int qty = _popupQty < 1 ? 1 : _popupQty;
        double reqGold = _popupSpec.GoldCost * qty;
        double reqWood = _popupSpec.WoodCost * qty;
        double reqStone = _popupSpec.StoneCost * qty;
        double reqIron = _popupSpec.IronCost * qty;
        double perDayQty = _popupSpec.OutputPerDay * qty;
        bool canAfford = _nation.CanPay(reqGold) && _nation.Wood >= reqWood && _nation.Stone >= reqStone && _nation.Iron >= reqIron;
        // One card per resource this mill actually costs (cost x qty on top, stock below).
        var costs = new List<(string Icon, string Label, double Need, double Have)>();
        if (reqWood > 0) costs.Add(("🪵", "Wood", reqWood, _nation.Wood));
        if (reqGold > 0) costs.Add(("🪙", "Gold", reqGold, _nation.Gold));
        if (reqStone > 0) costs.Add(("🪨", "Stone", reqStone, _nation.Stone));
        if (reqIron > 0) costs.Add(("⛓️", "Iron", reqIron, _nation.Iron));

        <div class="popup-overlay" @onclick="ClosePopup">
            <div class="build-panel" @onclick:stopPropagation>
                <button class="build-close" @onclick="ClosePopup" title="Close">✕</button>
                <div class="build-title">
                    <span class="build-title-icon">@_popupSpec.Icon</span>
                    <span>@_popupSpec.Name.ToUpperInvariant()</span>
                </div>
                <div class="build-costs">
                    @foreach (var c in costs)
                    {
                        <div class="build-cost-card">
                            <div class="build-cost-need @(c.Have >= c.Need ? "" : "lack")">-@c.Need.ToString("N0")</div>
                            <div class="build-cost-icon">@c.Icon</div>
                            <div class="build-cost-have">@c.Have.ToString("N0")</div>
                            <div class="build-cost-label">@c.Label</div>
                        </div>
                    }
                </div>
                <div class="build-line">
                    <span class="build-line-label">Quantity:</span>
                    <span class="build-qty">
                        <input type="number" class="build-qty-input" @bind="_popupQty" min="1" />
                        <button class="build-max-btn" @onclick="FillMax" title="Max you can afford">⬆</button>
                    </span>
                </div>
                <div class="build-line">
                    <span class="build-line-label">Production per day:</span>
                    <span class="build-line-value">@perDayQty.ToString("N0") <span class="build-line-icon">@_popupSpec.Icon</span></span>
                </div>
                <div class="build-line">
                    <span class="build-line-label">Total time:</span>
                    <span class="build-line-value">@_popupSpec.BuildDays <span class="build-line-icon">⏱️</span></span>
                </div>
                <div class="build-actions">
                    <button class="build-btn" @onclick="ConfirmBuild" disabled="@(!canAfford)">BUILD</button>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private Nation _nation => Engine.State.PlayerNation;
    private ProductionCategory _category = ProductionCategory.Food;
    private string? _error;
    private ProductionBuildingSpec? _popupSpec;
    private int _popupQty = 1;
    private ProductionBuildingSpec? _infoSpec;
    private MilitaryRecipe? _milInfo;
    private HashSet<string> _highlightGreen = new();
    private HashSet<string> _highlightRed = new();

    protected override void OnInitialized() => Engine.StateChanged += OnStateChanged;
    private void OnStateChanged() => InvokeAsync(StateHasChanged);
    private void SelectCategory(ProductionCategory cat) { _category = cat; _error = null; }

    private void OnBuildClick(ProductionBuildingSpec spec)
    {
        if (spec.Category == ProductionCategory.Military)
            _error = Engine.BuildProduction(spec.Id, 1);
        else
        {
            _popupSpec = spec;
            _popupQty = 1;
            _error = null;
        }
    }

    private void ClosePopup() { _popupSpec = null; _popupQty = 1; }

    // Up-arrow: fill in the most mills affordable now (at least 1, so the red costs show why).
    private void FillMax()
    {
        if (_popupSpec is not null)
            _popupQty = Math.Max(1, ProductionCatalog.MaxAffordable(_nation, _popupSpec));
    }

    private void ConfirmBuild()
    {
        if (_popupSpec is not null)
        {
            int qty = _popupQty < 1 ? 1 : _popupQty;
            _error = Engine.BuildProduction(_popupSpec.Id, qty);
            _popupSpec = null;
            _popupQty = 1;
        }
    }

    private void ShowInfo(ProductionBuildingSpec spec) => _infoSpec = spec;

    private async void StartCraft(string recipeId)
    {
        var err = Engine.StartMilitaryCraft(recipeId);
        // Green glow on success, red glow on failure. No text messages.
        if (string.IsNullOrEmpty(err))
            _highlightGreen.Add(recipeId);
        else
            _highlightRed.Add(recipeId);
        StateHasChanged();
        await Task.Delay(5000);
        _highlightGreen.Remove(recipeId);
        _highlightRed.Remove(recipeId);
        StateHasChanged();
    }

    public void Dispose() => Engine.StateChanged -= OnStateChanged;
}

<style>
.prod-wrap {
    background: radial-gradient(ellipse at 50% 0%, rgba(255,255,255,.4), transparent 60%), linear-gradient(#f0e0b0, #e8d090);
    min-height: 100vh; padding: 10px 8px 90px;
    font-family: Georgia, 'Times New Roman', serif;
}
.prod-header h2 { text-align: center; color: #3d2b1f; margin: 0 0 10px; font-size: 1.35rem; letter-spacing: 1px; text-shadow: 0 1px 0 rgba(255,255,255,.5); }
.prod-cat-row { display: flex; justify-content: center; gap: 16px; margin-bottom: 12px; padding-bottom: 10px; border-bottom: 2px solid #8b6914; }
.cat-icon-btn {
    width: 58px; height: 58px; border-radius: 50%;
    background: radial-gradient(circle at 35% 30%, #8a6a3a, #4a3520);
    border: 3px solid #2e1c0c; font-size: 1.7rem; cursor: pointer; padding: 0;
    display: flex; align-items: center; justify-content: center;
    box-shadow: 0 2px 6px rgba(0,0,0,.5), inset 0 1px 2px rgba(255,255,255,.3);
    filter: grayscale(40%) brightness(0.9); transition: filter 0.15s, box-shadow 0.15s, transform 0.1s;
}
.cat-icon-btn:hover { filter: grayscale(20%) brightness(1); }
.cat-icon-btn:active { transform: translateY(1px); }
.cat-icon-btn.active { border-color: #ffd700; filter: none; box-shadow: 0 0 14px rgba(255,215,0,.8), 0 2px 6px rgba(0,0,0,.5); }
.prod-list { display: flex; flex-direction: column; gap: 3px; overflow-y: auto; }
.prod-row { display: flex; align-items: center; gap: 8px; padding: 2px 0; }
/* Icon with progress ring and badge */
.prod-icon-wrap { display: flex; flex-direction: column; align-items: center; flex-shrink: 0; }
.prod-row-icon {
    width: 44px; height: 44px; border-radius: 50%; position: relative;
    background: radial-gradient(circle at 35% 30%, #f7ead0, #d9bd85);
    border: 2px solid #6b4a2a; display: flex; align-items: center; justify-content: center;
    font-size: 1.35rem; box-shadow: 0 1px 3px rgba(0,0,0,.4);
}
.prog-ring { position: absolute; inset: -3px; width: 50px; height: 50px; pointer-events: none; }
