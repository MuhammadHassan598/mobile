@page "/laws"
@using EmpireSim.Core.Models
@using EmpireSim.Core.Services
@inject GameEngine Engine
@implements IDisposable

<div class="law-wrap">
    <div class="law-header">
        <h2>📜 NATIONAL LAWS</h2>
    </div>

    <div class="law-tabs">
        <button class="@(_tab == 0 ? "active" : "")" @onclick="() => _tab = 0">
            <span class="tab-ico">💰</span><span>Economic</span>
        </button>
        <button class="@(_tab == 1 ? "active" : "")" @onclick="() => _tab = 1">
            <span class="tab-ico">⚙️</span><span>Production</span>
        </button>
    </div>

    @if (!string.IsNullOrEmpty(_error))
    {
        <div class="law-error">⚠ @_error</div>
    }
    @if (!string.IsNullOrEmpty(_msg))
    {
        <div class="law-msg">@_msg</div>
    }

    <div class="law-grid">
        @foreach (var law in LawCatalog.ByCategory(_tab == 0 ? "Economic" : "Production"))
        {
            bool active = _nation.ActiveLaws.Contains(law.Id);
            <div class="law-card @(active ? "active" : "")">
                <div class="law-icon">@law.Icon</div>
                <div class="law-name">@law.Name</div>
                <div class="law-actions">
                    <button class="law-info" @onclick="() => _info = law" title="Info">ⓘ</button>
                    @if (active)
                    {
                        <span class="law-active-badge">ACTIVE</span>
                        <button class="law-repeal" @onclick="() => Repeal(law.Id)">Repeal</button>
                    }
                    else
                    {
                        <button class="law-select" @onclick="() => _selected = law">SELECT</button>
                    }
                </div>
            </div>
        }
    </div>
</div>

<!-- Info Modal -->
@if (_info is not null)
{
    <div class="popup-overlay" @onclick="() => _info = null">
        <div class="popup-panel" @onclick:stopPropagation>
            <div class="law-modal-icon">@_info.Icon</div>
            <div class="law-modal-name">@_info.Name</div>
            <div class="law-section">
                <div class="law-sec-title" style="color:#2e7d32">Advantages:</div>
                @foreach (var a in _info.Advantages) { <div class="law-adv">✓ @a</div> }
            </div>
            <div class="law-section">
                <div class="law-sec-title" style="color:#b71c1c">Disadvantages:</div>
                @foreach (var d in _info.Disadvantages) { <div class="law-dis">✗ @d</div> }
            </div>
            <div class="popup-actions">
                <button class="popup-btn cancel" @onclick="() => _info = null">CLOSE</button>
            </div>
        </div>
    </div>
}

<!-- Selection Modal -->
@if (_selected is not null)
{
    var law = _selected;
    bool canAfford = _nation.Gold >= law.SelectionCost;
    // Check for conflicting law
    var conflict = _nation.ActiveLaws
        .Select(id => LawCatalog.Get(id))
        .FirstOrDefault(l => l is not null && l.PolicyGroup == law.PolicyGroup
            && law.PolicyGroup != "general" && law.PolicyGroup != "diplomatic");

    <div class="popup-overlay" @onclick="() => _selected = null">
        <div class="popup-panel" @onclick:stopPropagation>
            <div class="law-modal-icon">@law.Icon</div>
            <div class="law-modal-name">@law.Name</div>
            <div class="c-row"><span>🪙 Selection Cost:</span><b>@law.SelectionCost.ToString("N0") Gold</b></div>
            @if (conflict is not null)
            {
                <div class="law-conflict">Will replace: @conflict.Name</div>
            }
            <div class="law-section">
                <div class="law-sec-title" style="color:#2e7d32">Advantages:</div>
                @foreach (var a in law.Advantages) { <div class="law-adv">✓ @a</div> }
            </div>
            <div class="law-section">
                <div class="law-sec-title" style="color:#b71c1c">Disadvantages:</div>
                @foreach (var d in law.Disadvantages) { <div class="law-dis">✗ @d</div> }
            </div>
            @if (!canAfford)
            {
                <div class="law-insufficient">Insufficient Gold!</div>
            }
            <div class="popup-actions">
                <button class="popup-btn cancel" @onclick="() => _selected = null">CANCEL</button>
                <button class="popup-btn confirm" disabled="@(!canAfford)" @onclick="() => DoSelect(law.Id)">SELECT</button>
            </div>
        </div>
    </div>
}

@code {
    private Nation _nation => Engine.State.PlayerNation;
    private int _tab = 0;
    private string? _error;
    private string? _msg;
    private LawDefinition? _info;
    private LawDefinition? _selected;

    protected override void OnInitialized() => Engine.StateChanged += OnStateChanged;
    private void OnStateChanged() => InvokeAsync(StateHasChanged);
    public void Dispose() => Engine.StateChanged -= OnStateChanged;

    private void DoSelect(string id)
    {
        _error = Engine.SelectLaw(id);
        if (_error is null)
        {
            _msg = "Law enacted.";
            _selected = null;
        }
    }

    private void Repeal(string id)
    {
        Engine.RepealLaw(id);
        _msg = "Law repealed.";
    }
}

<style>
.law-wrap { background: linear-gradient(#f0e0b0, #e8d090); min-height: 100vh; padding: 10px 8px 90px; font-family: Georgia, serif; color: #3d2b1f; }
.law-header h2 { text-align: center; letter-spacing: 2px; margin: 0 0 10px; }
.law-tabs { display: flex; gap: 12px; justify-content: center; margin-bottom: 12px; }
.law-tabs button { display: flex; flex-direction: column; align-items: center; gap: 4px; width: 90px; height: 90px; border-radius: 50%; background: linear-gradient(#4a7a8a, #2e4a5a); border: 3px solid #1a2a3a; color: #fff; cursor: pointer; font-family: inherit; justify-content: center; }
.law-tabs button.active { border-color: #ffd700; box-shadow: 0 0 12px rgba(255,215,0,.6); }
.tab-ico { font-size: 1.8rem; }
.law-tabs button span:last-child { font-size: 0.7rem; font-weight: bold; }
.law-error { background: #f8d7da; color: #721c24; border-radius: 6px; padding: 8px; margin-bottom: 8px; font-size: 0.9rem; }
.law-msg { background: #d4edda; color: #155724; border-radius: 6px; padding: 8px; margin-bottom: 8px; font-size: 0.9rem; }
.law-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; }
.law-card { background: linear-gradient(#f5e6c4, #e2cb92); border: 2px solid #8b6914; border-radius: 8px; padding: 10px 6px; text-align: center; display: flex; flex-direction: column; gap: 6px; }
.law-card.active { border-color: #2e7d32; box-shadow: 0 0 8px rgba(46,125,50,.4); }
.law-icon { font-size: 2rem; }
.law-name { font-size: 0.78rem; font-weight: bold; min-height: 2.2em; }
.law-actions { display: flex; align-items: center; justify-content: center; gap: 4px; margin-top: auto; }
.law-info { background: #4a7a8a; color: #fff; border: none; border-radius: 50%; width: 24px; height: 24px; cursor: pointer; font-size: 0.8rem; }
.law-select { background: linear-gradient(#7a5230, #4a2e14); color: #f5e6c4; border: 1px solid #2e1c0c; border-radius: 4px; padding: 4px 10px; cursor: pointer; font-family: inherit; font-size: 0.72rem; font-weight: bold; }
.law-active-badge { background: #2e7d32; color: #fff; font-size: 0.65rem; padding: 2px 6px; border-radius: 4px; font-weight: bold; }
.law-repeal { background: #8B0000; color: #fff; border: none; border-radius: 4px; padding: 4px 8px; cursor: pointer; font-size: 0.65rem; font-family: inherit; }
.popup-overlay { position: fixed; inset: 0; z-index: 100; background: rgba(0,0,0,.6); display: flex; align-items: center; justify-content: center; padding: 12px; }
.popup-panel { background: linear-gradient(#f5e6c4, #e2cb92); border: 3px double #8b6914; border-radius: 10px; padding: 16px; max-width: 360px; width: 100%; max-height: 88vh; overflow-y: auto; font-family: Georgia, serif; color: #3d2b1f; text-align: center; }
.law-modal-icon { font-size: 3rem; margin-bottom: 4px; }
.law-modal-name { font-size: 1.2rem; font-weight: bold; margin-bottom: 8px; }
.c-row { display: flex; justify-content: space-between; padding: 6px 0; border-bottom: 1px solid #c9b98a; font-size: 0.92rem; text-align: left; }
.law-section { margin: 10px 0; text-align: left; }
.law-sec-title { font-weight: bold; font-size: 0.9rem; margin-bottom: 4px; }
.law-adv { color: #2e7d32; font-size: 0.88rem; padding: 2px 0; }
.law-dis { color: #b71c1c; font-size: 0.88rem; padding: 2px 0; }
.law-conflict { background: #fff3cd; color: #856404; border-radius: 4px; padding: 6px; margin: 8px 0; font-size: 0.85rem; }
.law-insufficient { color: #8B0000; font-weight: bold; margin-top: 8px; }
.popup-actions { display: flex; gap: 10px; margin-top: 12px; }
.popup-btn { flex: 1; padding: 10px; border-radius: 6px; cursor: pointer; font-family: inherit; border: 2px solid #2e1c0c; font-weight: bold; }
.popup-btn.cancel { background: linear-gradient(#8a8a8a, #5a5a5a); color: #fff; }
.popup-btn.confirm { background: linear-gradient(#7a5230, #4a2e14); color: #f5e6c4; }
.popup-btn.confirm:disabled { opacity: 0.4; }
</style>
