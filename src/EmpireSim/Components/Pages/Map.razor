@page "/map"
@inject GameEngine Engine
@inject IJSRuntime JS
@inject NavigationManager Nav
@inject NavigationHistory History
@implements IAsyncDisposable

<div class="map-page">
    <canvas id="gameMap" class="map-canvas"></canvas>
    <AttackDialog TargetId="@_attackId" OnClose="AttackClosed" OnSent="AttackSent" />
    <PeaceDialog NationId="@_peaceId" OnClose="() => _peaceId = null" />
    <ColonyDialog RegionId="@_colonyId" OnClose="() => _colonyId = null" OnSent="ColonySent" />

    @if (_selectedNation is not null || _selectedFrontier is not null || _selectedNeutral is not null)
    {
        <div class="province-card">
            @* Back closes the card (the selection) before it leaves the map *@
            <BackLayer OnBack="ClearSelection" />
            <div class="province-head">
                <div>
                    <div class="province-name">@SelectedName</div>
                    <div class="province-owner">
                        @if (_selectedNation is not null)
                        {
                            <span class="owner-dot" style="background:@_selectedNation.ColorHex"></span>
                            @_selectedNation.CapitalName
                            @if (_selectedNation.IsPlayer)
                            {
                                <span class="you-badge">YOU</span>
                            }
                        }
                        else if (_selectedNeutral is not null)
                        {
                            <span class="owner-dot" style="background:#4A4438"></span>
                            <span class="muted">Neutral territory</span>
                        }
                        else if (_selectedFrontier is not null)
                        {
                            var holder = FrontierHolder(_selectedFrontier);
                            <span class="owner-dot" style="background:@(holder?.ColorHex ?? "#C9952B")"></span>
                            @switch (_selectedFrontier.Status)
                            {
                                case ColonyStatus.Colonized:
                                    <span class="muted">Colony of @(holder?.Name ?? "another country")</span>
                                    @if (holder?.IsPlayer == true)
                                    {
                                        <span class="you-badge">YOU</span>
                                    }
                                    break;
                                case ColonyStatus.MissionInProgress:
                                    <span class="muted">Claimed by @(holder?.Name ?? "another country") · mission in progress</span>
                                    break;
                                default:
                                    <span class="muted">Unclaimed colony region</span>
                                    break;
                            }
                        }
                    </div>
                </div>
                <button class="card-close" @onclick="ClearSelection">✕</button>
            </div>

            @if (!string.IsNullOrEmpty(_error))
            {
                <div class="warning">⚠ @_error</div>
            }
            @if (!string.IsNullOrEmpty(_battleReport))
            {
                <div class="battle-report">@_battleReport</div>
            }

            @if (_selectedNation is not null)
            {
                <div class="cards">
                    <div class="card"><div class="label">Population</div><div class="value">@_selectedNation.Population.ToString("N0")</div></div>
                    <div class="card"><div class="label">Capital</div><div class="value">@_selectedNation.CapitalName</div></div>
                    <div class="card"><div class="label">Farms</div><div class="value">@_selectedNation.Farms</div></div>
                    <div class="card"><div class="label">Mines</div><div class="value">@_selectedNation.Mines</div></div>
                </div>
                @if (Engine.State.AnnexedBy(_selectedNation.Id) is { Count: > 0 } annexed)
                {
                    <div class="annexed-note">🏳 Includes annexed @(annexed.Count == 1 ? "country" : "countries"): @string.Join(", ", annexed.Select(a => $"{a.Name} ({a.AnnexedDate:dd-MM-yyyy})"))</div>
                    @if (_selectedNation.IsPlayer)
                    {
                        <button class="inline-btn" @onclick='() => Nav.NavigateTo("/annexed")'>🏳️ Manage annexed states…</button>
                    }
                }
                @if (Engine.State.ColoniesOf(_selectedNation.Id) is { Count: > 0 } colonies)
                {
                    <div class="annexed-note">⛵ Colonies: @string.Join(", ", colonies.Select(c => $"{c.Name} ({c.AnnexedDate:dd-MM-yyyy})"))</div>
                    @if (_selectedNation.IsPlayer)
                    {
                        <button class="inline-btn" @onclick='() => Nav.NavigateTo("/colonies")'>⛵ Manage colonies…</button>
                    }
                }
                @if (_selectedNation.IsEliminated && _selectedNation.AnnexedById is { } masterId)
                {
                    <div class="annexed-note">🏳 Annexed by @(Engine.State.AllNations().FirstOrDefault(n => n.Id == masterId)?.Name ?? "another country") on @_selectedNation.AnnexedDate?.ToString("dd-MM-yyyy")</div>
                }
                @if (!_selectedNation.IsPlayer && !_selectedNation.IsEliminated)
                {
                    <div class="invade-box">
                        <div class="invade-title">⚔ @(_selectedNation.AtWarWithPlayer ? "Invade" : "Attack") @_selectedNation.Name — win, then annex it, take its resources, or let it go</div>
                        <button class="inline-btn" @onclick="() => _attackId = _selectedNation.Id">⚔ Attack @_selectedNation.Name…</button>
                        @if (_selectedNation.AtWarWithPlayer)
                        {
                            <button class="inline-btn" @onclick="() => _peaceId = _selectedNation.Id">🕊️ Peace talks…</button>
                        }
                    </div>
                }
            }
            else if (_selectedNeutral is not null)
            {
                var why = ColonyCatalog.WhyNot(_selectedNeutral.Name);
                <div class="cards">
                    <div class="card"><div class="label">Status</div><div class="value">Neutral territory</div></div>
                    <div class="card"><div class="label">Land</div><div class="value">@(why?.Kind ?? "Reserved")</div></div>
                    <div class="card"><div class="label">Settlement</div><div class="value">Not possible</div></div>
                </div>
                <p class="page-hint">🚫 <b>This land cannot be settled.</b> @(why?.Reason ?? "It is reserved: no ruler claims it and no colony can be founded on it.")</p>
            }
            else if (_selectedFrontier is not null)
            {
                @ColonyCard(_selectedFrontier)
            }
        </div>
    }
    else
    {
        <div class="map-hint">Drag to pan · scroll or pinch to zoom · tap a country or an amber colony region</div>
    }
</div>

@code {
    /// <summary>The popup of a colony region: its status and area, and by status what it would cost to settle, who is on the way, or who owns it.</summary>
    private RenderFragment ColonyCard(FrontierRegion region) => @<text>
        @{
            var state = Engine.State;
            var player = state.PlayerNation;
            var size = ColonizationService.SizeOf(ColonizationService.AreaOf(region));
            var mission = region.Status == ColonyStatus.MissionInProgress ? state.ColonizationMissions.FirstOrDefault(m => m.Id == region.MissionId) : null;
            var colony = region.Status == ColonyStatus.Colonized ? state.Colonies.FirstOrDefault(c => c.Id == region.ColonyId) : null;
            var record = colony is null ? null : state.AllNations().FirstOrDefault(n => n.Id == colony.Id);
            var site = ColonyCatalog.Get(region.Name);
        }
        <div class="cards">
            <div class="card"><div class="label">Status</div><div class="value">@(region.Status switch { ColonyStatus.Colonized => "Colonised", ColonyStatus.MissionInProgress => "Mission under way", _ => "Unclaimed" })</div></div>
            <div class="card"><div class="label">Area</div><div class="value">≈ @ColonizationService.AreaKm2(region).ToString("N0") km²</div></div>
            <div class="card"><div class="label">Size</div><div class="value">@ColonizationService.SizeName(size)</div></div>
        </div>
        @if (site is not null)
        {
            <p class="page-hint">@site.Blurb@(region.Landmass.Length > 0 ? $" Part of {region.Landmass}." : "")</p>
        }

        @switch (region.Status)
        {
            case ColonyStatus.Unclaimed:
                var q = Engine.QuoteColony(region.Id)!;
                <div class="mp-sub">Cost and requirements (for @player.Name)</div>
                @foreach (var rq in ColonizationService.Requirements(state, player, q))
                {
                    <div class="mp-req @(rq.Met ? "ok" : "bad")"><span>@(rq.Met ? "✓" : "✗") @rq.Icon @rq.Label</span><span>@rq.Need <small>· have @rq.Have</small></span></div>
                }
                <div class="mp-when">⏱ <b>@q.Days days</b> @ColonizationService.Journey(q.Overland, region.Terrain) · estimated landing <b>@q.Completion.ToString("dd-MM-yyyy")</b></div>
                @if (q.Block is { } why)
                {
                    <div class="warning">🔒 @why</div>
                }
                <button class="inline-btn" disabled="@(q.Block is not null)" @onclick="() => _colonyId = region.Id">⛵ Send Colonization Mission…</button>
                break;

            case ColonyStatus.MissionInProgress:
                @if (mission is not null)
                {
                    double progress = mission.Progress(state.CurrentDate);
                    <div class="build-row">
                        <div class="build-info">
                            <div class="build-name">⛵ @mission.OwnerName's colonists @(mission.Overland ? "march to" : region.Terrain == ColonyTerrain.Highland ? "sail, then march inland to" : "sail for") @region.Name</div>
                            <div class="progress"><div class="progress-fill" style="width:@((progress * 100).ToString("N0"))%"></div></div>
                        </div>
                        <div class="build-days">@((progress * 100).ToString("N0"))% · @mission.DaysLeft(state.CurrentDate) d</div>
                    </div>
                    <div class="mp-when">Started <b>@mission.StartDate.ToString("dd-MM-yyyy")</b> · lands <b>@mission.CompletionDate.ToString("dd-MM-yyyy")</b> · @mission.Settlers.ToString("N0") settlers</div>
                    <p class="page-hint">The land is claimed: nobody else can settle it while these colonists are on their way.</p>
                }
                break;

            default:
                @if (colony is not null && record is not null)
                {
                    var owner = state.AllNations().FirstOrDefault(n => n.Id == colony.OwnerId);
                    <div class="cards">
                        <div class="card"><div class="label">Settlement</div><div class="value">@record.CapitalName</div></div>
                        <div class="card"><div class="label">Founded</div><div class="value">@colony.FoundedDate.ToString("dd-MM-yyyy")</div></div>
                        <div class="card"><div class="label">People</div><div class="value">@record.Population.ToString("N0")</div></div>
                    </div>
                    @if (owner?.IsPlayer == true)
                    {
                        <button class="inline-btn" @onclick='() => Nav.NavigateTo($"/colonies/{record.Id}")'>⛵ Manage @region.Name…</button>
                    }
                    else
                    {
                        <p class="page-hint">A colony of @(owner?.Name ?? "another country"): it has no ruler of its own, and its owner governs it.</p>
                    }
                }
                break;
        }
    </text>;

    private DotNetObjectReference<Map>? _dotNetRef;
    private Nation? _selectedNation;
    private FrontierRegion? _selectedFrontier;
    private NeutralTerritory? _selectedNeutral;
    private string? _error;
    private string? _battleReport;
    private string? _attackId;
    private string? _peaceId;
    private string? _colonyId;

    /// <summary>A region to open on (from the Colonies list: "show on map").</summary>
    [SupplyParameterFromQuery(Name = "focus")] public string? Focus { get; set; }

    private string SelectedName =>
        _selectedNation?.Name ?? _selectedFrontier?.Name ?? _selectedNeutral?.Name ?? "";
    private string? SelectedId =>
        _selectedNation?.Id ?? _selectedFrontier?.Id ?? _selectedNeutral?.Id;

    // The Attack popup asks how many soldiers to send; confirming declares war (if none is on) and starts the march together.
    private void AttackClosed() => _attackId = null;

    private void AttackSent(AttackResult result)
    {
        _attackId = null;
        _error = null;
        _battleReport = result.Message;
    }

    // The colony popup confirmed a mission: say when the colonists land.
    private void ColonySent()
    {
        _colonyId = null;
        _error = null;
        var mission = Engine.PlayerMission;
        _battleReport = mission is null ? null : $"Colonists are on their way to {mission.RegionName}: they land on {mission.CompletionDate:dd-MM-yyyy}.";
    }

    /// <summary>The country a colony region is claimed by or belongs to (null while it is unclaimed).</summary>
    private Nation? FrontierHolder(FrontierRegion region)
    {
        var state = Engine.State;
        string? ownerId = region.Status switch
        {
            ColonyStatus.Colonized => state.Colonies.FirstOrDefault(c => c.Id == region.ColonyId)?.OwnerId,
            ColonyStatus.MissionInProgress => state.ColonizationMissions.FirstOrDefault(m => m.Id == region.MissionId)?.OwnerId,
            _ => null,
        };
        return ownerId is null ? null : state.AllNations().FirstOrDefault(n => n.Id == ownerId);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            double focusX = Engine.State.PlayerNation.MapX, focusY = Engine.State.PlayerNation.MapY;
            bool focused = !string.IsNullOrEmpty(Focus) && Engine.State.RegionOf(Focus) is not null;
            if (focused)
            {
                var region = Engine.State.RegionOf(Focus!)!;
                _selectedFrontier = region;
                focusX = region.LabelX;
                focusY = region.LabelY;
            }
            // Returning by Back: the map is as the player left it (where they were looking, how far in, and which country was selected).
            bool returning = History.ArrivedByBack && !focused;
            if (returning) SelectById(History.Recall(SelectionKey));
            _dotNetRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("empireMap.init", "gameMap", _dotNetRef, focusX, focusY, returning);
            await RenderMapAsync();
            if (_selectedFrontier is not null || _selectedNation is not null || _selectedNeutral is not null) StateHasChanged();
        }
    }

    private async Task RenderMapAsync()
    {
        var state = Engine.State;
        // Draw large territories first so small nations (city-states, khanates)
        // render on top and stay tappable.
        var nations = state.AllNations()
            .Where(n => !n.IsEliminated && n.Territory.Count > 0)
            .OrderByDescending(n => n.Territory.Sum(t => PolyArea(t)))
            .Select(n => new
            {
                id = n.Id,
                name = n.Name,
                kind = "nation",
                painted = WorldGeometry.IsPaintedIsland(n.Id),
                color = n.ColorHex,
                polygons = n.Territory,
                labelX = n.MapX,
                labelY = n.MapY,
                // The old capitals of the countries this one has annexed: their lands are drawn as part of this realm.
                annexedCities = state.AnnexedBy(n.Id)
                    .Select(a => new { name = a.CapitalName, country = a.Name, x = a.MapX, y = a.MapY, minScale = 0.0 })
                    .ToList(),
            })
            .ToList();
        _mapSignature = MapSignature();

        // Colony regions: open (amber, dashed), claimed by a mission (the claimant's colour, hatched, with its progress), or settled
        // (the owner's colour, part of its realm: the settlement shows once zoomed in).
        var frontier = state.FrontierRegions.Select(r =>
        {
            var holder = FrontierHolder(r);
            var mission = r.Status == ColonyStatus.MissionInProgress ? state.ColonizationMissions.FirstOrDefault(m => m.Id == r.MissionId) : null;
            var record = r.Status == ColonyStatus.Colonized ? state.AllNations().FirstOrDefault(n => n.Id == r.ColonyId) : null;
            bool settled = r.Status == ColonyStatus.Colonized && holder is not null;
            return new
            {
                id = r.Id,
                name = r.Name,
                kind = settled ? "colony" : "frontier",
                status = r.Status switch { ColonyStatus.Colonized => "colonized", ColonyStatus.MissionInProgress => "mission", _ => "unclaimed" },
                painted = r.Terrain == ColonyTerrain.Archipelago,
                color = holder?.ColorHex ?? "#C9952B",
                realm = settled ? holder!.Id : r.Id,
                progress = mission?.Progress(state.CurrentDate) ?? 0.0,
                polygons = r.Polygons,
                labelX = r.LabelX,
                labelY = r.LabelY,
                annexedCities = settled && record is not null
                    ? new List<object> { new { name = record.CapitalName, country = r.Name, x = r.LabelX, y = r.LabelY + 11, minScale = 1.0 } }
                    : new List<object>(),
            };
        });

        var neutral = state.NeutralRegions.Select(r => new
        {
            id = r.Id,
            name = r.Name,
            kind = "neutral",
            color = "#4A4438",
            polygons = r.Polygons,
            labelX = r.LabelX,
            labelY = r.LabelY,
        });

        // Neutrals form the background; nations draw over them (small first
        // within nations so enclaves stay tappable); colony regions sit on top (they share exact borders with whatever lies beside them).
        var shapes = neutral.Cast<object>().Concat(nations).Concat(frontier).ToList();

        await JS.InvokeVoidAsync("empireMap.render",
            new { shapes, selectedId = SelectedId });
    }

    private const string SelectionKey = "map.selected";

    /// <summary>Selects a country, colony region or neutral land by id (nothing for null or an unknown id).</summary>
    private void SelectById(string? id)
    {
        _selectedNation = id is null ? null : Engine.State.AllNations().FirstOrDefault(n => n.Id == id);
        _selectedFrontier = id is null || _selectedNation is not null ? null : Engine.State.FrontierRegions.FirstOrDefault(r => r.Id == id);
        _selectedNeutral = id is null || _selectedNation is not null || _selectedFrontier is not null ? null : Engine.State.NeutralRegions.FirstOrDefault(r => r.Id == id);
        History.Remember(SelectionKey, SelectedId);
    }

    [JSInvokable]
    public async Task OnMapTapped(string id)
    {
        SelectById(id);
        _error = null;
        _battleReport = null;
        await RenderMapAsync();
        StateHasChanged();
    }

    private async Task ClearSelection()
    {
        SelectById(null);
        await RenderMapAsync();
        StateHasChanged();
    }

    // The map follows the world: when a country is annexed or a colony is claimed, landed or lost (by the player or by an AI country) while
    // this page is open, it is redrawn at once, instead of waiting for the next tap.
    private string _mapSignature = "";

    private string MapSignature() =>
        string.Join(";", Engine.State.AllNations().Select(n => $"{n.Id}:{n.IsEliminated}:{n.Territory.Count}:{n.AnnexedPolygonCount}:{n.ColorHex}"))
        + "|" + string.Join(";", Engine.State.FrontierRegions.Select(r =>
            $"{r.Id}:{r.Status}:{r.MissionId}:{r.ColonyId}:{FrontierHolder(r)?.ColorHex}:{(int)((Engine.State.ColonizationMissions.FirstOrDefault(m => m.Id == r.MissionId)?.Progress(Engine.State.CurrentDate) ?? 0) * 10)}"));

    protected override void OnInitialized() => Engine.StateChanged += OnStateChanged;

    private void OnStateChanged() => InvokeAsync(async () =>
    {
        if (_dotNetRef is null) return;
        if (MapSignature() != _mapSignature)
        {
            // The selected country may just have been annexed: its lands now belong to the winner, so select the winner.
            if (_selectedNation is { IsEliminated: true, AnnexedById: { } masterId })
                _selectedNation = Engine.State.AllNations().FirstOrDefault(n => n.Id == masterId) ?? _selectedNation;
            await RenderMapAsync();
        }
        StateHasChanged();   // (the open card shows a mission's progress and a price that moves with the treasury)
    });

    public async ValueTask DisposeAsync()
    {
        Engine.StateChanged -= OnStateChanged;
        _dotNetRef?.Dispose();
        await Task.CompletedTask;
    }

    private static double PolyArea(List<MapPoint> poly)
    {
        double a = 0;
        for (int i = 0; i < poly.Count - 1; i++)
            a += poly[i].X * poly[i + 1].Y - poly[i + 1].X * poly[i].Y;
        return Math.Abs(a) / 2;
    }
}
