@page "/map"
@inject GameEngine Engine
@inject IJSRuntime JS
@inject NavigationManager Nav
@implements IAsyncDisposable

<div class="map-page">
    <canvas id="gameMap" class="map-canvas"></canvas>
    <AttackDialog TargetId="@_attackId" OnClose="AttackClosed" OnSent="AttackSent" />
    <PeaceDialog NationId="@_peaceId" OnClose="() => _peaceId = null" />

    @if (_selectedNation is not null || _selectedFrontier is not null || _selectedNeutral is not null)
    {
        <div class="province-card">
            <div class="province-head">
                <div>
                    <div class="province-name">@SelectedName</div>
                    <div class="province-owner">
                        @if (_selectedNation is not null)
                        {
                            <span class="owner-dot" style="background:@_selectedNation.ColorHex"></span>
                            @_selectedNation.CapitalName
                            @if (_selectedNation.IsPlayer)
                            {
                                <span class="you-badge">YOU</span>
                            }
                        }
                        else if (_selectedNeutral is not null)
                        {
                            <span class="owner-dot" style="background:#4A4438"></span>
                            <span class="muted">Neutral territory</span>
                        }
                        else
                        {
                            <span class="owner-dot" style="background:#6B7280"></span>
                            <span class="muted">Uncharted territory</span>
                        }
                    </div>
                </div>
                <button class="card-close" @onclick="ClearSelection">✕</button>
            </div>

            @if (!string.IsNullOrEmpty(_error))
            {
                <div class="warning">⚠ @_error</div>
            }
            @if (!string.IsNullOrEmpty(_battleReport))
            {
                <div class="battle-report">@_battleReport</div>
            }

            @if (_selectedNation is not null)
            {
                <div class="cards">
                    <div class="card"><div class="label">Population</div><div class="value">@_selectedNation.Population.ToString("N0")</div></div>
                    <div class="card"><div class="label">Capital</div><div class="value">@_selectedNation.CapitalName</div></div>
                    <div class="card"><div class="label">Farms</div><div class="value">@_selectedNation.Farms</div></div>
                    <div class="card"><div class="label">Mines</div><div class="value">@_selectedNation.Mines</div></div>
                </div>
                @if (Engine.State.AnnexedBy(_selectedNation.Id) is { Count: > 0 } annexed)
                {
                    <div class="annexed-note">🏳 Includes annexed @(annexed.Count == 1 ? "country" : "countries"): @string.Join(", ", annexed.Select(a => $"{a.Name} ({a.AnnexedDate:dd-MM-yyyy})"))</div>
                    @if (_selectedNation.IsPlayer)
                    {
                        <button class="inline-btn" @onclick='() => Nav.NavigateTo("/annexed")'>🏳️ Manage annexed states…</button>
                    }
                }
                @if (_selectedNation.IsEliminated && _selectedNation.AnnexedById is { } masterId)
                {
                    <div class="annexed-note">🏳 Annexed by @(Engine.State.AllNations().FirstOrDefault(n => n.Id == masterId)?.Name ?? "another country") on @_selectedNation.AnnexedDate?.ToString("dd-MM-yyyy")</div>
                }
                @if (!_selectedNation.IsPlayer && !_selectedNation.IsEliminated)
                {
                    <div class="invade-box">
                        <div class="invade-title">⚔ @(_selectedNation.AtWarWithPlayer ? "Invade" : "Attack") @_selectedNation.Name — win, then annex it, take its resources, or let it go</div>
                        <button class="inline-btn" @onclick="() => _attackId = _selectedNation.Id">⚔ Attack @_selectedNation.Name…</button>
                        @if (_selectedNation.AtWarWithPlayer)
                        {
                            <button class="inline-btn" @onclick="() => _peaceId = _selectedNation.Id">🕊️ Peace talks…</button>
                        }
                    </div>
                }
            }
            else if (_selectedNeutral is not null)
            {
                <div class="cards">
                    <div class="card"><div class="label">Status</div><div class="value">Neutral territory</div></div>
                </div>
                <p class="page-hint">Beyond the reach of crowns — no ruler claims this land.</p>
            }
            else
            {
                <div class="cards">
                    <div class="card"><div class="label">Status</div><div class="value">Uncharted</div></div>
                </div>
                @if (Engine.State.ActiveExpedition is not null)
                {
                    <div class="build-row">
                        <div class="build-info">
                            <div class="build-name">Expedition to @Engine.State.ActiveExpedition.RegionName</div>
                            <div class="progress"><div class="progress-fill" style="width:@((Engine.State.ActiveExpedition.Progress * 100).ToString("N0"))%"></div></div>
                        </div>
                        <div class="build-days">@((Engine.State.ActiveExpedition.Progress * 100).ToString("N0"))% · @Engine.State.ActiveExpedition.DaysLeft d</div>
                    </div>
                }
                else
                {
                    <button class="inline-btn" @onclick="() => Colonize(_selectedFrontier!.Id)">
                        ⛵ Found colony (@Currency.Cost(Balance.ColonyCostGold) · @Balance.ColonyCostFood.ToString("N0") food · @Balance.ColonyWarshipsRequired warships)
                    </button>
                }
            }
        </div>
    }
    else
    {
        <div class="map-hint">Drag to pan · scroll or pinch to zoom · tap a country</div>
    }
</div>

@code {
    private DotNetObjectReference<Map>? _dotNetRef;
    private Nation? _selectedNation;
    private FrontierRegion? _selectedFrontier;
    private NeutralTerritory? _selectedNeutral;
    private string? _error;
    private string? _battleReport;
    private string? _attackId;
    private string? _peaceId;

    private string SelectedName =>
        _selectedNation?.Name ?? _selectedFrontier?.Name ?? _selectedNeutral?.Name ?? "";
    private string? SelectedId =>
        _selectedNation?.Id ?? _selectedFrontier?.Id ?? _selectedNeutral?.Id;

    // The Attack popup asks how many soldiers to send; confirming declares war (if none is on) and starts the march together.
    private void AttackClosed() => _attackId = null;

    private void AttackSent(AttackResult result)
    {
        _attackId = null;
        _error = null;
        _battleReport = result.Message;
    }

    private void Colonize(string regionId)
    {
        _error = Engine.FoundColony(regionId);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _dotNetRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("empireMap.init", "gameMap", _dotNetRef,
                Engine.State.PlayerNation.MapX, Engine.State.PlayerNation.MapY);
            await RenderMapAsync();
        }
    }

    private async Task RenderMapAsync()
    {
        // Draw large territories first so small nations (city-states, khanates)
        // render on top and stay tappable.
        var nations = Engine.State.AllNations()
            .Where(n => !n.IsEliminated && n.Territory.Count > 0)
            .OrderByDescending(n => n.Territory.Sum(t => PolyArea(t)))
            .Select(n => new
            {
                id = n.Id,
                name = n.Name,
                color = n.ColorHex,
                polygons = n.Territory,
                labelX = n.MapX,
                labelY = n.MapY,
                // The old capitals of the countries this one has annexed: their lands are drawn as part of this realm.
                annexedCities = Engine.State.AnnexedBy(n.Id)
                    .Select(a => new { name = a.CapitalName, country = a.Name, x = a.MapX, y = a.MapY })
                    .ToList(),
            })
            .ToList();
        _mapSignature = MapSignature();

        var frontier = Engine.State.FrontierRegions.Select(r => new
        {
            id = r.Id,
            name = r.Name,
            color = "#6B7280",
            polygons = r.Polygons,
            labelX = r.LabelX,
            labelY = r.LabelY,
        });

        var neutral = Engine.State.NeutralRegions.Select(r => new
        {
            id = r.Id,
            name = r.Name,
            color = "#4A4438",
            polygons = r.Polygons,
            labelX = r.LabelX,
            labelY = r.LabelY,
        });

        // Neutrals form the background; nations draw over them (small first
        // within nations so enclaves stay tappable); frontiers sit in open ocean.
        var shapes = neutral.Cast<object>().Concat(nations).Concat(frontier).ToList();

        await JS.InvokeVoidAsync("empireMap.render",
            new { shapes, selectedId = SelectedId });
    }

    [JSInvokable]
    public async Task OnMapTapped(string id)
    {
        _selectedNation = Engine.State.AllNations().FirstOrDefault(n => n.Id == id);
        _selectedFrontier = _selectedNation is null
            ? Engine.State.FrontierRegions.FirstOrDefault(r => r.Id == id) : null;
        _selectedNeutral = _selectedNation is null && _selectedFrontier is null
            ? Engine.State.NeutralRegions.FirstOrDefault(r => r.Id == id) : null;

        _error = null;
        _battleReport = null;
        await RenderMapAsync();
        StateHasChanged();
    }

    private async Task ClearSelection()
    {
        _selectedNation = null;
        _selectedFrontier = null;
        _selectedNeutral = null;
        await RenderMapAsync();
        StateHasChanged();
    }

    // The map follows the world: when a country is annexed (by the player or by an AI country) while this page is open, its lands are
    // redrawn as part of the winner's realm at once, instead of waiting for the next tap.
    private string _mapSignature = "";

    private string MapSignature() => string.Join(";", Engine.State.AllNations()
        .Select(n => $"{n.Id}:{n.IsEliminated}:{n.Territory.Count}:{n.AnnexedPolygonCount}:{n.ColorHex}"));

    protected override void OnInitialized() => Engine.StateChanged += OnStateChanged;

    private void OnStateChanged() => InvokeAsync(async () =>
    {
        if (_dotNetRef is null || MapSignature() == _mapSignature) return;
        // The selected country may just have been annexed: its lands now belong to the winner, so select the winner.
        if (_selectedNation is { IsEliminated: true, AnnexedById: { } masterId })
            _selectedNation = Engine.State.AllNations().FirstOrDefault(n => n.Id == masterId) ?? _selectedNation;
        await RenderMapAsync();
        StateHasChanged();
    });

    public async ValueTask DisposeAsync()
    {
        Engine.StateChanged -= OnStateChanged;
        _dotNetRef?.Dispose();
        await Task.CompletedTask;
    }

    private static double PolyArea(List<MapPoint> poly)
    {
        double a = 0;
        for (int i = 0; i < poly.Count - 1; i++)
            a += poly[i].X * poly[i + 1].Y - poly[i + 1].X * poly[i].Y;
        return Math.Abs(a) / 2;
    }
}
