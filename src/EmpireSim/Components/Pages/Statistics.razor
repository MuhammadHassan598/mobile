@page "/statistics"
@inject GameEngine Engine
@implements IDisposable

<div class="dashboard">
    <div class="topbar">
        <div class="nation-name">Statistics</div>
    </div>

    <div class="cards">
        <div class="card"><div class="label">Treasury</div><div class="value gold">@Currency.Format(_nation.WealthInSilver)</div></div>
        <div class="card"><div class="label">Income / day</div><div class="value">@GameEngine.EstimateDailyIncome(_nation).ToString("N0") Silver</div></div>
        <div class="card"><div class="label">Countries annexed</div><div class="value">@Engine.State.NationsAnnexedByPlayer</div></div>
        <div class="card"><div class="label">Population</div><div class="value">@_nation.Population.ToString("N0")</div></div>
        <div class="card"><div class="label">Soldiers</div><div class="value">@_nation.Soldiers.ToString("N0")</div></div>
        <div class="card"><div class="label">Warships</div><div class="value">@_nation.Warships.ToString("N0")</div></div>
        <div class="card"><div class="label">Buildings</div><div class="value">@(_nation.Farms + _nation.Mines + _nation.Sawmills + _nation.Workshops)</div></div>
        <div class="card"><div class="label">Trade pacts</div><div class="value">@Engine.State.OtherNations.Count(n => n.HasTradePactWithPlayer)</div></div>
        <div class="card"><div class="label">Wars</div><div class="value">@Engine.State.OtherNations.Count(n => n.AtWarWithPlayer)</div></div>
        <div class="card"><div class="label">Spy networks</div><div class="value">@Engine.State.SpyNetworks.Count</div></div>
        <div class="card"><div class="label">Colonies</div><div class="value">@_nation.ColoniesFounded</div></div>
        <div class="card"><div class="label">Battles won</div><div class="value">@_nation.BattlesWon</div></div>
    </div>
</div>

@code {
    private Nation _nation => Engine.State.PlayerNation;

    protected override void OnInitialized() => Engine.StateChanged += OnStateChanged;
    private void OnStateChanged() => InvokeAsync(StateHasChanged);
    public void Dispose() => Engine.StateChanged -= OnStateChanged;
}
