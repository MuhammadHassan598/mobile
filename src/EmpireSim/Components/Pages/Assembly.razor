@page "/assembly"
@using EmpireSim.Core.Models
@using EmpireSim.Core.Services
@inject GameEngine Engine
@implements IDisposable

<div class="asm-wrap">
    <div class="asm-header">
        <h2>🏛️ INTERNATIONAL ASSEMBLY</h2>
    </div>

    <div class="asm-tabs">
        <button class="@(_tab == 0 ? "active" : "")" @onclick="() => _tab = 0">
            <span class="tab-ico">🗳️</span><span>VOTES</span>
        </button>
        <button class="@(_tab == 1 ? "active" : "")" @onclick="() => _tab = 1">
            <span class="tab-ico">📜</span><span>SUGGESTIONS</span>
        </button>
    </div>

    @if (!string.IsNullOrEmpty(_error))
    {
        <div class="asm-error">⚠ @_error</div>
    }
    @if (!string.IsNullOrEmpty(_msg))
    {
        <div class="asm-msg">@_msg</div>
    }

    @if (_tab == 0)
    {
        <!-- VOTES -->
        <div class="asm-list-head"><span>STATE</span><span>VOTES</span></div>
        @foreach (var n in Engine.State.AllNations().OrderByDescending(n => n.VotingPower))
        {
            <div class="asm-row">
                <span class="asm-flag">@n.Emblem</span>
                <span class="asm-name">@n.Name</span>
                <span class="asm-votes">@n.VotingPower</span>
            </div>
        }
    }
    else
    {
        <!-- SUGGESTIONS -->
        <div style="text-align:center; margin-bottom:10px">
            <button class="asm-btn" @onclick="() => _proposalOpen = true">MAKE A SUGGESTION</button>
        </div>

        @if (!Engine.State.AssemblyProposals.Any())
        {
            <div class="asm-empty">
                <div style="font-size:3rem">🏛️</div>
                <div>No proposals yet. Make a suggestion to shape international policy.</div>
            </div>
        }
        @foreach (var p in Engine.State.AssemblyProposals.OrderByDescending(p => p.CreatedDate))
        {
            var type = AssemblyProposalTypes.Get(p.TypeId);
            var target = Engine.State.AllNations().FirstOrDefault(n => n.Id == p.TargetId);
            var proposer = Engine.State.AllNations().FirstOrDefault(n => n.Id == p.ProposerId);
            var nations = Engine.State.AllNations().ToList();
            int forV = p.VotesFor(nations);
            int againstV = p.VotesAgainst(nations);
            int daysLeft = Math.Max(0, p.VotingDeadline.DayNumber - Engine.State.CurrentDate.DayNumber);

            <div class="prop-card">
                <div class="prop-head">
                    <span>@type?.Icon</span>
                    <div>
                        <div class="prop-name">@type?.Name</div>
                        <div class="prop-sub">Target: @target?.Emblem @target?.Name · By @proposer?.Name</div>
                    </div>
                    <span class="prop-status @p.Status.ToString().ToLower()">@p.Status</span>
                </div>
                <div class="prop-votes">
                    <span class="for">FOR: @forV</span>
                    <span class="against">AGAINST: @againstV</span>
                    @if (p.Status == ProposalStatus.VotingOpen)
                    {
                        <span>@daysLeft days left</span>
                    }
                </div>
                @if (p.Status == ProposalStatus.VotingOpen && !p.Votes.ContainsKey(_nation.Id))
                {
                    <div class="prop-actions">
                        <button class="asm-btn small" @onclick="() => Vote(p.Id, true)">VOTE FOR</button>
                        <button class="asm-btn small against" @onclick="() => Vote(p.Id, false)">VOTE AGAINST</button>
                    </div>
                }
            </div>
        }
    }
</div>

<!-- Make a Suggestion Modal -->
@if (_proposalOpen)
{
    var type = AssemblyProposalTypes.Get(_propTypeId);
    var target = Engine.State.AllNations().FirstOrDefault(n => n.Id == _propTargetId);
    var estimate = EstimateVotes();

    <div class="popup-overlay" @onclick="() => _proposalOpen = false">
        <div class="popup-panel" @onclick:stopPropagation>
            <div class="popup-header"><span class="popup-title">Make a Suggestion</span></div>

            <div class="popup-section">
                <div class="popup-section-title">Assembly type:</div>
                <select class="asm-input" @bind="_propTypeId">
                    @foreach (var t in AssemblyProposalTypes.All)
                    {
                        <option value="@t.Id">@t.Icon @t.Name</option>
                    }
                </select>
                <div class="asm-desc">@type?.EffectDescription</div>
            </div>

            <div class="popup-section">
                <div class="popup-section-title">Choose a state:</div>
                <select class="asm-input" @bind="_propTargetId">
                    <option value="">-- Select --</option>
                    @foreach (var n in Engine.State.OtherNations.OrderBy(n => n.Name))
                    {
                        <option value="@n.Id">@n.Emblem @n.Name</option>
                    }
                </select>
            </div>

            <div class="popup-section">
                <div class="popup-section-title">Choose a timeframe:</div>
                <select class="asm-input" @bind="_propDuration">
                    <option value="30">1 month</option>
                    <option value="60">2 months</option>
                    <option value="180">6 months</option>
                    <option value="270">9 months</option>
                    <option value="365">1 year</option>
                    <option value="730">2 years</option>
                    <option value="1095">3 years</option>
                </select>
            </div>

            <div class="popup-section">
                <div class="popup-section-title">Voting timeframe:</div>
                <div>@_propVotingDays days</div>
            </div>

            <div class="popup-section">
                <div class="popup-section-title">Estimated number of votes:</div>
                <div class="est-row">
                    <span class="for">FOR: @estimate.forVotes</span>
                    <span class="against">AGAINST: @estimate.againstVotes</span>
                </div>
                <div class="asm-note">Improving your relations with other states may influence the voting results.</div>
            </div>

            <div class="popup-actions">
                <button class="popup-btn cancel" @onclick="() => _proposalOpen = false">CANCEL</button>
                <button class="popup-btn confirm" disabled="@(string.IsNullOrEmpty(_propTargetId))" @onclick="Submit">ADD</button>
            </div>
        </div>
    </div>
}

@code {
    private Nation _nation => Engine.State.PlayerNation;
    private int _tab = 0;
    private string? _error;
    private string? _msg;
    private bool _proposalOpen = false;
    private string _propTypeId = "military_restriction";
    private string _propTargetId = "";
    private int _propDuration = 365;
    private int _propVotingDays = 30;

    protected override void OnInitialized() => Engine.StateChanged += OnStateChanged;
    private void OnStateChanged() => InvokeAsync(StateHasChanged);
    public void Dispose() => Engine.StateChanged -= OnStateChanged;

    private (int forVotes, int againstVotes) EstimateVotes()
    {
        var prop = new AssemblyProposal
        {
            Id = "estimate",
            TypeId = _propTypeId,
            TargetId = _propTargetId,
            ProposerId = _nation.Id
        };
        return AssemblyService.EstimateVotes(prop, Engine.State.AllNations(), _nation.Id);
    }

    private void Submit()
    {
        _error = Engine.SubmitProposal(_propTypeId, _propTargetId, _propDuration, _propVotingDays);
        if (_error is null)
        {
            _msg = $"Proposal submitted. Voting closes in {_propVotingDays} days.";
            _proposalOpen = false;
            _propTargetId = "";
        }
    }

    private void Vote(string proposalId, bool forProposal)
    {
        _error = Engine.CastVote(proposalId, forProposal);
        if (_error is null) _msg = "Vote cast.";
    }
}

<style>
