.asm-btn { background: linear-gradient(#7a5230, #4a2e14); color: #f5e6c4; border: 2px solid #2e1c0c; border-radius: 8px; padding: 12px 24px; cursor: pointer; font-family: inherit; font-weight: bold; letter-spacing: 1px; }
