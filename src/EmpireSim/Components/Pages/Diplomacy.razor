@page "/diplomacy"
@using EmpireSim.Core.Models
@using EmpireSim.Core.Services
@inject GameEngine Engine
@inject NavigationManager Nav
@implements IDisposable

<div class="dip-wrap">
    <!-- Header -->
    <div class="dip-header">
        <button class="dip-back" @onclick='() => Nav.NavigateTo("/")'>◀ BACK</button>
        <h2>MANAGEMENT</h2>
        <span class="dip-spacer"></span>
    </div>

    <!-- Tabs -->
    <div class="dip-tabs">
        <button class="dip-tab @(_tab == 0 ? "active" : "")" @onclick="() => _tab = 0">STATE</button>
        <button class="dip-tab @(_tab == 1 ? "active" : "")" @onclick="() => _tab = 1">DIPLOMACY</button>
    </div>

    @if (_tab == 0)
    {
        <!-- STATE TAB: country resource list -->
        <div class="dip-list-header">
            <span>STATE</span>
            <span>PRODUCT</span>
        </div>
        <div class="dip-list">
            @foreach (var n in Engine.State.OtherNations.OrderBy(x => x.Name))
            {
                <div class="dip-row">
                    <span class="dip-flag">@n.Emblem</span>
                    <span class="dip-name">@n.Name</span>
                    <span class="dip-res">
                        <span class="dip-res-icon">🌾</span>
                        <span>@((int)n.GetProduct("Wheat"))</span>
                    </span>
                    <button class="dip-help" @onclick="() => OpenAid(n)">HELP</button>
                </div>
            }
        </div>
    }
    else
    {
        <!-- DIPLOMACY TAB: relationship list -->
        <div class="dip-list-header">
            <span>STATE</span>
            <span>DIPLOMACY</span>
        </div>
        <div class="dip-list">
            @foreach (var n in Engine.State.OtherNations.OrderBy(x => x.Name))
            {
                int rating = DiplomacyService.ToDisplayRating(n.RelationToPlayer);
                var status = DiplomacyService.GetStatus(rating);
                <div class="dip-row">
                    <span class="dip-flag">@n.Emblem</span>
                    <span class="dip-name">@n.Name</span>
                    <span class="dip-rel @DiplomacyService.StatusColorClass(status)">
                        @DiplomacyService.StatusName(status) (@rating)
                    </span>
                    <button class="dip-action-btn" @onclick="() => OpenProfile(n)" title="Diplomacy">🤝</button>
                </div>
            }
        </div>
    }
</div>

<!-- Send Aid Modal -->
@if (_aidTarget is not null)
{
    var eligible = Engine.State.OtherNations
        .Where(n => DiplomacyService.ToDisplayRating(n.RelationToPlayer) < _aidThreshold)
        .ToList();
    double totalAid = eligible.Count * _aidPerCountry;
    bool canAfford = Engine.State.PlayerNation.Gold >= totalAid;

    <div class="popup-overlay" @onclick="() => _aidTarget = null">
        <div class="popup-panel" @onclick:stopPropagation>
            <div class="popup-header">
                <span class="popup-title">Send Aid</span>
            </div>
            <div class="popup-section">
                <div class="popup-section-title">Send aid to countries with relationship below:</div>
                <input type="number" class="dip-input" @bind="_aidThreshold" min="0" max="100" />
                <div class="dip-hint">@eligible.Count countries eligible</div>
            </div>
            <div class="popup-section">
                <div class="popup-section-title">Aid value for each country:</div>
                <div class="popup-qty-row">
                    <span>🪙</span>
                    <input type="number" class="qty-input" @bind="_aidPerCountry" min="1" />
                </div>
            </div>
            <div class="popup-section">
                <div class="dip-total">Total aid value: 🪙 @totalAid.ToString("N0")</div>
                @if (!canAfford)
                {
                    <div class="dip-insufficient">Insufficient gold!</div>
                }
            </div>
            <div class="popup-actions">
                <button class="popup-btn cancel" @onclick="() => _aidTarget = null">CANCEL</button>
                <button class="popup-btn confirm" disabled="@(!canAfford || eligible.Count == 0)" @onclick="() => SendAid(eligible, totalAid)">HELP / SEND</button>
            </div>
        </div>
    </div>
}

<!-- Country Profile Modal -->
@if (_profile is not null)
{
    var p = _profile;
    int rating = DiplomacyService.ToDisplayRating(p.RelationToPlayer);
    var status = DiplomacyService.GetStatus(rating);
    double playerPower = DiplomacyService.MilitaryPower(Engine.State.PlayerNation);
    double targetPower = DiplomacyService.MilitaryPower(p);
    double playerShare = DiplomacyService.PlayerShare(playerPower, targetPower) * 100;

    <div class="popup-overlay" @onclick="() => _profile = null">
        <div class="popup-panel wide" @onclick:stopPropagation>
            <button class="profile-close" @onclick="() => _profile = null">✕</button>
            <div class="profile-head">
                <span class="profile-emblem">@p.Emblem</span>
                <div>
                    <div class="profile-name">@p.Name</div>
                    <div class="profile-capital">@p.CapitalName</div>
                </div>
            </div>

            <div class="profile-stats">
                <div class="pstat"><span>Area:</span><b>@GetArea(p)</b></div>
                <div class="pstat"><span>Population:</span><b>@p.Population.ToString("N0")</b></div>
                <div class="pstat"><span>Military Power:</span><b>@targetPower.ToString("N0")</b></div>
            </div>

            <div class="popup-section">
                <div class="popup-section-title">Resource Deposits</div>
                <div class="popup-res-row">
                    <span>🪙 @p.Gold.ToString("N0")</span>
                    <span>🪵 @p.Wood.ToString("N0")</span>
                    <span>🪨 @p.Stone.ToString("N0")</span>
                    <span>⛓️ @p.Iron.ToString("N0")</span>
                    <span>🟤 @p.Copper.ToString("N0")</span>
                    <span>⚫ @p.Lead.ToString("N0")</span>
                </div>
            </div>

            <div class="profile-stats">
                <div class="pstat"><span>Religion:</span><b>@p.Religion</b></div>
                <div class="pstat"><span>Stance:</span><b class="@DiplomacyService.StatusColorClass(status)">@DiplomacyService.StatusName(status) (@rating)</b></div>
                <div class="pstat"><span>Treaties:</span><b class="pstat-treaties">@TreatySummary(p)</b></div>
                @if (Engine.MissionaryInfluenceOn(p.Id) > 0)
                {
                    <div class="pstat"><span>Our missionaries:</span><b>@Engine.MissionaryInfluenceOn(p.Id).ToString("N0") / @Balance.MissionaryConversionThreshold.ToString("N0")</b></div>
                }
            </div>

            <div class="popup-section">
                <div class="popup-section-title">Balance of Forces</div>
                <div class="balance-bar">
                    <span class="bal-emblem">@Engine.State.PlayerNation.Emblem</span>
                    <div class="bal-track">
                        <div class="bal-fill-player" style="width: @playerShare%"></div>
                    </div>
                    <span class="bal-emblem">@p.Emblem</span>
                </div>
                <div class="bal-labels">
                    <span>@playerPower.ToString("N0")</span>
                    <span>@targetPower.ToString("N0")</span>
                </div>
            </div>

            <!-- Actions on a dark-wood panel: three pages so everything fits on a phone -->
            <div class="popup-section">
                <div class="popup-section-title">Diplomatic Actions</div>
                <div class="dip-wood">
                    @if (_actTab == 0)
                    {
                        <!-- Hostile & covert: 2 rows x 4 -->
                        <div class="action-grid">
                            <button class="action-btn" @onclick="() => DoAttack(p)">⚔️<span>Attack</span></button>
                            <button class="action-btn" @onclick="() => DoEspionage(p)">🕵️<span>Espionage</span></button>
                            <button class="action-btn" @onclick="() => DoSabotage(p)">💣<span>Sabotage</span></button>
                            <button class="action-btn" @onclick="() => DoInsult(p)">😠<span>Insult</span></button>
                            <button class="action-btn" @onclick="() => DoCoup(p)">👑<span>Coup</span></button>
                            <button class="action-btn" @onclick="() => DoAnnex(p)">🏰<span>Annex</span></button>
                            <button class="action-btn" @onclick="() => _demandTarget = p">💰<span>Demand</span></button>
                            <button class="action-btn" @onclick="() => DoAskAttack(p)">🤝<span>Ask Attack</span></button>
                        </div>
                    }
                    else
                    {
                        <!-- Treaties / Relations: tap an action for its requirements, effects and a confirm button -->
                        <div class="dip-act-grid">
                            @foreach (var spec in DiplomaticActionCatalog.ForTab(_actTab == 1 ? DiplomaticTab.Treaties : DiplomaticTab.Relations))
                            {
                                var st = Engine.CheckDiplomaticAction(spec.Id, p.Id);
                                bool inForce = IsInForce(spec.Id, p);
                                <button class="dip-act @(inForce ? "on" : st.Available ? "" : "off")"
                                        aria-disabled="@(!inForce && !st.Available)"
                                        title="@(inForce ? "In force" : st.Available ? spec.Name : st.Reason)"
                                        @onclick="() => OpenSheet(spec)">
                                    <span class="dip-act-ico">@spec.Icon</span>
                                    <span class="dip-act-lbl">@spec.Name</span>
                                    @if (inForce)
                                    {
                                        <span class="dip-act-badge">✔</span>
                                    }
                                </button>
                            }
                        </div>
                    }
                    <div class="dip-wood-tabs">
                        <button class="@(_actTab == 0 ? "active" : "")" @onclick="() => SetActTab(0)" title="Hostile and covert actions">⚔️</button>
                        <button class="@(_actTab == 1 ? "active" : "")" @onclick="() => SetActTab(1)" title="Treaties and military cooperation">🏛️</button>
                        <button class="@(_actTab == 2 ? "active" : "")" @onclick="() => SetActTab(2)" title="Gifts, aid and expansion">🎁</button>
                    </div>
                </div>
                @if (!string.IsNullOrEmpty(_actionMsg))
                {
                    <div class="dip-action-msg">@_actionMsg</div>
                }
            </div>
        </div>
    </div>
}

<!-- Demand Resources Modal -->
@if (_demandTarget is not null)
{
    <div class="popup-overlay" @onclick="() => _demandTarget = null">
        <div class="popup-panel" @onclick:stopPropagation>
            <div class="popup-header"><span class="popup-title">Demand Resources: @_demandTarget.Name</span></div>
            <div class="popup-section">
                <div class="popup-section-title">Resource</div>
                <select class="dip-input" @bind="_demandRes">
                    <option value="Gold">🪙 Gold</option>
                    <option value="Wood">🪵 Wood</option>
                    <option value="Stone">🪨 Stone</option>
                    <option value="Iron">⛓️ Iron</option>
                </select>
            </div>
            <div class="popup-section">
                <div class="popup-section-title">Amount</div>
                <input type="number" class="dip-input" @bind="_demandAmt" min="1" />
            </div>
            <div class="popup-actions">
                <button class="popup-btn cancel" @onclick="() => _demandTarget = null">CANCEL</button>
                <button class="popup-btn confirm" @onclick="DoDemand">DEMAND</button>
            </div>
        </div>
    </div>
}

<!-- Diplomatic action sheet: what it needs, what it does, the inputs, and the confirm step -->
@if (_sheet is not null && _profile is not null)
{
    var sp = _sheet;
    var t = _profile;
    var st = Engine.CheckDiplomaticAction(sp.Id, t.Id);
    bool inForce = IsInForce(sp.Id, t);
    bool canCancel = inForce && CancelType(sp.Id) is not null;
    bool usable = st.Available && !inForce;

    <div class="popup-overlay sheet-overlay" @onclick="CloseSheet">
        <div class="popup-panel sheet" @onclick:stopPropagation>
            <button class="profile-close" @onclick="CloseSheet">✕</button>
            <div class="sheet-head">
                <span class="sheet-ico">@sp.Icon</span>
                <div>
                    <div class="sheet-name">@sp.Name</div>
                    <div class="sheet-with">with @t.Emblem @t.Name</div>
                </div>
            </div>
            <div class="sheet-block"><b>Requirements</b><div>@sp.Requirements</div></div>
            <div class="sheet-block"><b>Effects</b><div>@sp.Effects</div></div>

            @if (inForce)
            {
                <div class="sheet-ok">✔ In force@(TreatyEndNote(sp.Id, t))</div>
            }
            else if (!st.Available)
            {
                <div class="sheet-off">🔒 Unavailable: @st.Reason</div>
            }
            else
            {
                <div class="sheet-cost">Cost: @st.CostText</div>
            }

            @if (usable)
            {
                @switch (sp.Id)
                {
                    case DiplomaticActionCatalog.SendTroops:
                    case DiplomaticActionCatalog.GiveArmy:
                        <div class="sheet-input">
                            <div class="popup-section-title">Soldiers (you can spare @Engine.SpareSoldiers.ToString("N0"))</div>
                            <div class="popup-qty-row">
                                <button class="qty-btn" @onclick="() => AdjustQty(-100)">−</button>
                                <input type="number" class="qty-input" @bind="_qty" min="1" max="@Engine.SpareSoldiers" />
                                <button class="qty-btn" @onclick="() => AdjustQty(100)">+</button>
                            </div>
                            <div class="sheet-quick">
                                <button @onclick="() => SetQtyPct(10)">10%</button>
                                <button @onclick="() => SetQtyPct(25)">25%</button>
                                <button @onclick="() => SetQtyPct(50)">50%</button>
                                <button @onclick="() => SetQtyPct(100)">MAX</button>
                            </div>
                        </div>
                        break;
                    case DiplomaticActionCatalog.Gift:
                        <div class="sheet-input">
                            <div class="popup-section-title">Gift of gold (you have @Engine.State.PlayerNation.Gold.ToString("N0"))</div>
                            <div class="popup-qty-row">
                                <span>🪙</span>
                                <input type="number" class="qty-input" @bind="_giftAmt" min="@Balance.GiftMinAmount" />
                            </div>
                            <div class="sheet-quick">
                                @foreach (var amt in new[] { 100, 500, 1000, 5000 })
                                {
                                    <button @onclick="() => _giftAmt = amt">@amt.ToString("N0")</button>
                                }
                            </div>
                            <div class="dip-hint">Relations gained: +@DiplomacyService.AidRelationshipGain(_giftAmt)</div>
                        </div>
                        break;
                    case DiplomaticActionCatalog.Aid:
                        <div class="sheet-input">
                            <div class="popup-section-title">Ask for</div>
                            <select class="dip-input" @bind="_aidRes">
                                @foreach (var res in GameEngine.AidResources)
                                {
                                    <option value="@res">@res (they hold @t.GetProduct(res).ToString("N0"))</option>
                                }
                            </select>
                        </div>
                        break;
                    case DiplomaticActionCatalog.CallToArms:
                        <div class="sheet-input">
                            <div class="popup-section-title">Join our war against</div>
                            <select class="dip-input" @bind="_enemyId">
                                @foreach (var en in Engine.Enemies(t.Id))
                                {
                                    <option value="@en.Id">@en.Emblem @en.Name (@en.Soldiers.ToString("N0") soldiers)</option>
                                }
                            </select>
                        </div>
                        break;
                    case DiplomaticActionCatalog.PresentColony:
                        <div class="sheet-input">
                            <div class="popup-section-title">Colony to present</div>
                            <select class="dip-input" @bind="_colonyId">
                                @foreach (var c in Engine.OwnedColonies)
                                {
                                    <option value="@c.Id">@c.Name — 👥 @c.Population.ToString("N0"), @c.Farms farms, @c.Mines mines</option>
                                }
                            </select>
                        </div>
                        break;
                    case DiplomaticActionCatalog.Missionary:
                        <div class="sheet-input">
                            <div class="dip-hint">Our faith: @Engine.State.PlayerNation.Religion → theirs: @t.Religion</div>
                            <div class="bal-track" style="margin-top:6px"><div class="bal-fill-player" style="width: @(Engine.MissionaryInfluenceOn(t.Id) / Balance.MissionaryConversionThreshold * 100)%"></div></div>
                            <div class="dip-hint">Influence @Engine.MissionaryInfluenceOn(t.Id).ToString("N0") / @Balance.MissionaryConversionThreshold.ToString("N0")</div>
                        </div>
                        break;
                }
                @if (NeedsConfirm(sp.Id))
                {
                    <div class="sheet-warn">⚠ Permanent — this cannot be undone.@(_armed ? " Tap again to confirm." : "")</div>
                }
            }

            @if (canCancel && _armed)
            {
                <div class="sheet-warn">⚠ Cancelling costs relations (−@(CancelType(sp.Id) is TreatyType.NonAggression or TreatyType.DefensiveAlliance ? Balance.BreakPactRatingPenalty : Balance.BreakMinorTreatyRatingPenalty)). Tap again to confirm.</div>
            }

            @if (!string.IsNullOrEmpty(_sheetMsg))
            {
                <div class="sheet-msg @SheetMsgClass">@_sheetMsg</div>
            }

            <div class="popup-actions">
                <button class="popup-btn cancel" @onclick="CloseSheet">CLOSE</button>
                @if (canCancel)
                {
                    <button class="popup-btn danger" @onclick="CancelTreatyClick">@(_armed ? "CONFIRM CANCEL" : "CANCEL TREATY")</button>
                }
                else
                {
                    <button class="popup-btn confirm" disabled="@(!usable)" @onclick="RunSheet">@ConfirmLabel(sp)</button>
                }
            </div>
        </div>
    </div>
}

@code {
    // Diplomacy page of the country panel: 0 hostile & covert, 1 treaties & cooperation, 2 relations & expansion.
    private int _actTab = 0;
    private DiplomaticActionSpec? _sheet;
    private string? _sheetMsg;
    private DipOutcome _sheetOutcome;
    private bool _armed;
    private int _qty = 1000;
    private double _giftAmt = 1000;
    private string _aidRes = "Gold";
    private string _enemyId = "";
    private string _colonyId = "";

    private int _tab = 0;
    private Nation? _aidTarget;
    private int _aidThreshold = 40;
    private double _aidPerCountry = 100;
    private Nation? _profile;
    private Nation? _demandTarget;
    private string _demandRes = "Gold";
    private double _demandAmt = 100;
    private string? _actionMsg;

    protected override void OnInitialized() => Engine.StateChanged += OnStateChanged;
    private void OnStateChanged() => InvokeAsync(StateHasChanged);
    public void Dispose() => Engine.StateChanged -= OnStateChanged;

    private string GetArea(Nation n)
    {
        // Approximate from territory polygon area
        double area = 0;
        foreach (var poly in n.Territory)
        {
            for (int i = 0; i < poly.Count - 1; i++)
                area += Math.Abs(poly[i].X * poly[i + 1].Y - poly[i + 1].X * poly[i].Y);
        }
        return ((int)(area / 2)).ToString("N0");
    }

    private void OpenAid(Nation n)
    {
        _aidTarget = n;
        _aidThreshold = 40;
        _aidPerCountry = 100;
    }

    private void SendAid(List<Nation> eligible, double total)
    {
        var player = Engine.State.PlayerNation;
        if (!player.PayGold(total)) return;

        foreach (var n in eligible)
        {
            n.Gold += _aidPerCountry;
            int gain = DiplomacyService.AidRelationshipGain(_aidPerCountry);
            n.RelationToPlayer = Math.Min(100, n.RelationToPlayer + gain * 2); // convert to -100..100 scale
            Engine.State.LogMovement(MovementKind.Gold, MovementStatus.Completed, player, n, $"{player.Name} sent aid to {n.Name} (+{gain} relations).");
        }
        _aidTarget = null;
        StateHasChanged();
    }

    private void OpenProfile(Nation n)
    {
        _profile = n;
        _actionMsg = null;
        _actTab = 0;
        _sheet = null;
    }

    private void SetActTab(int tab)
    {
        _actTab = tab;
        _actionMsg = null;
    }

    // ---- Diplomatic action sheet ----

    private void OpenSheet(DiplomaticActionSpec spec)
    {
        _sheet = spec;
        _sheetMsg = null;
        _armed = false;
        _qty = Math.Clamp(1000, 1, Math.Max(1, Engine.SpareSoldiers));
        _giftAmt = 1000;
        _aidRes = "Gold";
        _enemyId = Engine.Enemies(_profile?.Id).FirstOrDefault()?.Id ?? "";
        _colonyId = Engine.OwnedColonies.FirstOrDefault()?.Id ?? "";
    }

    private void CloseSheet()
    {
        _sheet = null;
        _sheetMsg = null;
        _armed = false;
    }

    private void AdjustQty(int delta) => _qty = Math.Clamp(_qty + delta, 1, Math.Max(1, Engine.SpareSoldiers));

    private void SetQtyPct(int pct) =>
        _qty = Math.Clamp((int)(Engine.SpareSoldiers * pct / 100.0), 1, Math.Max(1, Engine.SpareSoldiers));

    /// <summary>Soldier transfers and colony gifts are permanent: they need a second tap.</summary>
    private static bool NeedsConfirm(string id) =>
        id is DiplomaticActionCatalog.GiveArmy or DiplomaticActionCatalog.PresentColony;

    private static TreatyType? CancelType(string id) => id switch
    {
        DiplomaticActionCatalog.Embassy => TreatyType.Embassy,
        DiplomaticActionCatalog.NonAggression => TreatyType.NonAggression,
        DiplomaticActionCatalog.Alliance => TreatyType.DefensiveAlliance,
        DiplomaticActionCatalog.Trade => TreatyType.TradeAgreement,
        _ => null
    };

    private bool IsInForce(string id, Nation n) =>
        CancelType(id) is { } type && TreatyService.Has(Engine.State, type, Engine.State.PlayerNation.Id, n.Id);

    private string TreatyEndNote(string id, Nation n)
    {
        if (id != DiplomaticActionCatalog.NonAggression) return "";
        var pact = TreatyService.Find(Engine.State, TreatyType.NonAggression, Engine.State.PlayerNation.Id, n.Id);
        return pact?.ExpiresDate is { } end ? $" until {end:dd-MM-yyyy}" : "";
    }

    private string TreatySummary(Nation n)
    {
        var s = Engine.State;
        string pid = s.PlayerNation.Id;
        var parts = new List<string>();
        if (TreatyService.HasEmbassy(s, pid, n.Id)) parts.Add("🏛️ Embassy");
        var pact = TreatyService.Find(s, TreatyType.NonAggression, pid, n.Id);
        if (pact is not null) parts.Add($"🕊️ Pact until {pact.ExpiresDate:dd-MM-yyyy}");
        if (TreatyService.Has(s, TreatyType.DefensiveAlliance, pid, n.Id)) parts.Add("🛡️ Alliance");
        if (TreatyService.Has(s, TreatyType.TradeAgreement, pid, n.Id)) parts.Add("📜 Trade");
        int lent = s.TroopLoans.Where(l => l.OwnerId == pid && l.HostId == n.Id).Sum(l => l.Soldiers);
        if (lent > 0) parts.Add($"🪖 {lent:N0} lent");
        return parts.Count == 0 ? "none" : string.Join(" · ", parts);
    }

    private string ConfirmLabel(DiplomaticActionSpec sp)
    {
        if (_armed && NeedsConfirm(sp.Id)) return "CONFIRM — PERMANENT";
        return sp.Id switch
        {
            DiplomaticActionCatalog.Embassy => "ESTABLISH",
            DiplomaticActionCatalog.NonAggression => "PROPOSE PACT",
            DiplomaticActionCatalog.Alliance => "PROPOSE ALLIANCE",
            DiplomaticActionCatalog.Trade => "PROPOSE",
            DiplomaticActionCatalog.SendTroops => $"SEND {_qty:N0}",
            DiplomaticActionCatalog.CallToArms => "CALL TO ARMS",
            DiplomaticActionCatalog.GiveArmy => $"GIVE {_qty:N0}",
            DiplomaticActionCatalog.Gift => $"SEND {_giftAmt:N0} 🪙",
            DiplomaticActionCatalog.Improve => "SEND ENVOYS",
            DiplomaticActionCatalog.Aid => "ASK FOR AID",
            DiplomaticActionCatalog.PresentColony => "PRESENT",
            DiplomaticActionCatalog.Missionary => "SEND MISSIONARIES",
            _ => "CONFIRM"
        };
    }

    private string SheetMsgClass => _sheetOutcome switch
    {
        DipOutcome.Done => "done",
        DipOutcome.Rejected => "rejected",
        _ => "invalid"
    };

    private void RunSheet()
    {
        if (_sheet is null || _profile is null) return;
        if (NeedsConfirm(_sheet.Id) && !_armed) { _armed = true; return; }

        var t = _profile;
        DipResult r = _sheet.Id switch
        {
            DiplomaticActionCatalog.Embassy => Engine.EstablishEmbassy(t.Id),
            DiplomaticActionCatalog.NonAggression => Engine.ProposeNonAggression(t.Id),
            DiplomaticActionCatalog.Alliance => Engine.ProposeAlliance(t.Id),
            DiplomaticActionCatalog.Trade => Engine.ProposeTradeAgreement(t.Id),
            DiplomaticActionCatalog.Research => Engine.ResearchContract(t.Id),
            DiplomaticActionCatalog.SendTroops => Engine.SendTroops(t.Id, _qty),
            DiplomaticActionCatalog.CallToArms => Engine.CallToArms(t.Id, _enemyId),
            DiplomaticActionCatalog.GiveArmy => Engine.GiveArmy(t.Id, _qty),
            DiplomaticActionCatalog.Gift => Engine.GiveGift(t.Id, _giftAmt),
            DiplomaticActionCatalog.Improve => Engine.ImproveRelations(t.Id),
            DiplomaticActionCatalog.Aid => Engine.AskForAid(t.Id, _aidRes),
            DiplomaticActionCatalog.Sovereignty => Engine.SupportSovereignty(t.Id),
            DiplomaticActionCatalog.PresentColony => Engine.PresentColonyTo(t.Id, _colonyId),
            DiplomaticActionCatalog.Missionary => Engine.SendMissionary(t.Id),
            _ => DipResult.Invalid("Unknown action.")
        };
        _armed = false;
        _sheetOutcome = r.Outcome;
        _sheetMsg = r.Message;
    }

    private void CancelTreatyClick()
    {
        if (_sheet is null || _profile is null || CancelType(_sheet.Id) is not { } type) return;
        if (!_armed) { _armed = true; return; }
        var r = Engine.CancelTreaty(type, _profile.Id);
        _armed = false;
        _sheetOutcome = r.Outcome;
        _sheetMsg = r.Message;
    }

    private bool CheckCooldown(Nation target, string action, int days)
    {
        var player = Engine.State.PlayerNation;
        string key = $"{action}_{target.Id}";
        if (player.DiplomacyCooldowns.TryGetValue(key, out var until) && Engine.State.CurrentDate < until)
        {
            _actionMsg = $"Available in {(until.DayNumber - Engine.State.CurrentDate.DayNumber)} days.";
            return false;
        }
        player.DiplomacyCooldowns[key] = Engine.State.CurrentDate.AddDays(days);
        return true;
    }

    private void DoAttack(Nation target)
    {
        // A treaty (non-aggression pact, alliance) may forbid war: say so before the cooldown is spent.
        if (Engine.WarBlockReason(target.Id) is { } blocked) { _actionMsg = blocked; return; }
        if (!CheckCooldown(target, "attack", 30)) return;
        var error = Engine.DeclareWar(target.Id);
        _actionMsg = error ?? $"War declared on {target.Name}!";
        if (error is null) target.RelationToPlayer = -100;
    }

    private void DoEspionage(Nation target)
    {
        if (!CheckCooldown(target, "espionage", 5)) return;
        _actionMsg = Engine.EstablishNetwork(target.Id) ?? $"Spy network established in {target.Name}.";
    }

    private void DoSabotage(Nation target)
    {
        if (!CheckCooldown(target, "sabotage", 7)) return;
        var result = Engine.SpySabotage(target.Id);
        _actionMsg = result ?? $"Sabotage against {target.Name} attempted.";
        if (result is null) target.RelationToPlayer -= 10;
    }

    private void DoInsult(Nation target)
    {
        if (!CheckCooldown(target, "insult", 1)) return;
        target.RelationToPlayer = Math.Max(-100, target.RelationToPlayer - 10);
        Engine.State.Log($"{Engine.State.PlayerNation.Name} insulted {target.Name}.");
        _actionMsg = $"You insulted {target.Name}. (-10 relations)";
    }

    private void DoCoup(Nation target)
    {
        if (!CheckCooldown(target, "coup", 30)) return;
        var result = Engine.SpyInciteRevolt(target.Id);
        _actionMsg = result ?? $"Coup staged in {target.Name}!";
        if (result is null) target.RelationToPlayer -= 20;
    }

    private void DoAnnex(Nation target)
    {
        if (!CheckCooldown(target, "annex", 60)) return;
        double pp = DiplomacyService.MilitaryPower(Engine.State.PlayerNation);
        double tp = DiplomacyService.MilitaryPower(target);
        if (pp > tp * 3)
        {
            _actionMsg = $"{target.Name} accepts annexation! (Overwhelming power)";
            // Annexation handled via warfare system
        }
        else
        {
            target.RelationToPlayer = Math.Max(-100, target.RelationToPlayer - 15);
            _actionMsg = $"{target.Name} refuses annexation. (-15 relations)";
        }
    }

    private void DoDemand()
    {
        if (_demandTarget is null) return;
        var target = _demandTarget;
        if (!CheckCooldown(target, "demand", 7)) { _demandTarget = null; return; }

        double amount = _demandAmt;
        bool hasEnough = _demandRes switch
        {
            "Gold" => target.Gold >= amount,
            "Wood" => target.Wood >= amount,
            "Stone" => target.Stone >= amount,
            "Iron" => target.Iron >= amount,
            _ => false
        };

        int rating = DiplomacyService.ToDisplayRating(target.RelationToPlayer);
        double pp = DiplomacyService.MilitaryPower(Engine.State.PlayerNation);
        double tp = DiplomacyService.MilitaryPower(target);

        // AI decision: accept if friendly or intimidated
        bool accept = hasEnough && (rating >= 60 || pp > tp * 2);

        if (accept)
        {
            var player = Engine.State.PlayerNation;
            switch (_demandRes)
            {
                case "Gold": target.Gold -= amount; player.Gold += amount; break;
                case "Wood": target.Wood -= amount; player.Wood += amount; break;
                case "Stone": target.Stone -= amount; player.Stone += amount; break;
                case "Iron": target.Iron -= amount; player.Iron += amount; break;
            }
            target.RelationToPlayer = Math.Min(100, target.RelationToPlayer + 4);
            Engine.State.LogMovement(_demandRes == "Gold" ? MovementKind.Gold : MovementKind.Goods, MovementStatus.Completed, target, Engine.State.PlayerNation,
                $"{target.Name} accepted your demand for {amount:N0} {_demandRes}.");
            _actionMsg = $"{target.Name} accepted! (+{_demandRes})";
        }
        else
        {
            target.RelationToPlayer = Math.Max(-100, target.RelationToPlayer - 6);
            Engine.State.LogMovement(_demandRes == "Gold" ? MovementKind.Gold : MovementKind.Goods, MovementStatus.Failed, target, Engine.State.PlayerNation,
                $"{target.Name} refused your demand for {_demandRes}.");
            _actionMsg = $"{target.Name} refused. (-6 relations)";
        }
        _demandTarget = null;
    }

    private void DoAskAttack(Nation target)
    {
        if (!CheckCooldown(target, "askattack", 14)) return;
        int rating = DiplomacyService.ToDisplayRating(target.RelationToPlayer);
        if (rating >= 70)
        {
            _actionMsg = $"{target.Name} agrees to attack! (AI will consider)";
            Engine.State.Log($"{target.Name} agreed to join your war.");
        }
        else
        {
            _actionMsg = $"{target.Name} refuses. (Relations too low)";
        }
    }
}

