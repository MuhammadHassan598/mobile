@page "/military"
@using EmpireSim.Core.Models
@using EmpireSim.Core.Services
@inject GameEngine Engine
@implements IDisposable

<div class="mil-wrap">
    <div class="mil-header">
        <span class="mil-emblem">@_nation.Emblem</span>
        <div>
            <div class="mil-title">Army Management</div>
            <div class="mil-nation">@_nation.Name</div>
        </div>
    </div>

    <!-- Summary -->
    <div class="mil-summary">
        <div class="ms-row"><span>Military Power</span><b>@MilitaryPower().ToString("N0")</b></div>
        <div class="ms-row"><span>Active Soldiers</span><b>@_nation.Soldiers.ToString("N0")</b></div>
        <div class="ms-row"><span>Reserves</span><b>@_nation.Reserves.ToString("N0")</b></div>
        <div class="ms-row"><span>Upkeep / day</span><b>@DailyUpkeep().ToString("N2") 🪙</b></div>
        <div class="ms-row"><span>Warships</span><b>@_nation.Warships.ToString("N0") 🚢</b></div>
    </div>

    @if (!string.IsNullOrEmpty(_error))
    {
        <div class="mil-error">⚠ @_error</div>
    }
    @if (!string.IsNullOrEmpty(_msg))
    {
        <div class="mil-msg">@_msg</div>
    }

    <!-- Tabs -->
    <div class="mil-tabs">
        <button class="@(_tab == 0 ? "active" : "")" @onclick="() => _tab = 0">Overview</button>
        <button class="@(_tab == 1 ? "active" : "")" @onclick="() => _tab = 1">Recruit</button>
        <button class="@(_tab == 2 ? "active" : "")" @onclick="() => _tab = 2">Mercenary</button>
        <button class="@(_tab == 3 ? "active" : "")" @onclick="() => _tab = 3">Reserves</button>
        <button class="@(_tab == 4 ? "active" : "")" @onclick="() => _tab = 4">Equipment</button>
        <button class="@(_tab == 5 ? "active" : "")" @onclick="() => _tab = 5">Naval</button>
    </div>

    @if (_tab == 0)
    {
        <!-- OVERVIEW -->
        <h3>LAND FORCES</h3>
        @foreach (var spec in UnitCatalog.All)
        {
            var owned = _nation.Units.FirstOrDefault(u => u.Type == spec.Type)?.Count ?? 0;
            <div class="mil-row">
                <span class="mil-ico">@spec.Icon</span>
                <div class="mil-info">
                    <div class="mil-name">@spec.Name × @owned.ToString("N0")</div>
                    <div class="mil-sub">Str @((owned * spec.Strength).ToString("N0")) · @spec.UpkeepPerDay Gold/day each</div>
                </div>
            </div>
        }

        @if (_nation.RecruitmentQueue.Count > 0)
        {
            <h3>RECRUITMENT QUEUE</h3>
            @foreach (var r in _nation.RecruitmentQueue)
            {
                var spec = UnitCatalog.Get(r.Type);
                <div class="mil-row">
                    <span class="mil-ico">@spec.Icon</span>
                    <div class="mil-info">
                        <div class="mil-name">@r.Count.ToString("N0") × @spec.Name</div>
                        <div class="mil-prog"><div class="mil-prog-fill" style="width: @(r.Progress * 100)%"></div></div>
                        <div class="mil-sub">@r.DaysLeft.ToString("N1")d left</div>
                    </div>
                    <button class="mil-cancel" @onclick="() => CancelRec(r.Id)">✕</button>
                </div>
            }
        }

        @if (_nation.MercenaryContracts.Count > 0)
        {
            <h3>MERCENARY CONTRACTS</h3>
            @foreach (var c in _nation.MercenaryContracts)
            {
                var co = MercenaryCatalog.Get(c.CompanyId);
                <div class="mil-row">
                    <span class="mil-ico">@(co?.Icon ?? "⚔️")</span>
                    <div class="mil-info">
                        <div class="mil-name">@(co?.Name ?? c.CompanyId) × @c.Count.ToString("N0")</div>
                        <div class="mil-sub">Expires @c.Expires.ToString("dd-MM-yyyy")</div>
                    </div>
                </div>
            }
        }

        <h3>MAINTENANCE</h3>
        <div class="mil-row">
            <div class="mil-info">
                <div class="mil-name">Accrued: @Currency.Format(_nation.UpkeepAccrued)</div>
                <div class="mil-sub">Payday: @_nation.NextPayday.ToString("dd-MM-yyyy")</div>
                @if (_nation.IsInGracePeriod)
                {
                    <div class="mil-grace">⚠ GRACE — @_nation.GraceDaysLeft days left!</div>
                }
            </div>
            <button class="mil-btn" @onclick="PayNow" disabled="@(_nation.UpkeepAccrued <= 0)">Pay</button>
        </div>
    }
    else if (_tab == 1)
    {
        <!-- RECRUIT -->
        <h3>RECRUIT ARMY</h3>
        @foreach (var spec in UnitCatalog.All)
        {
            <div class="rec-card">
                <div class="rec-head">
                    <span class="mil-ico">@spec.Icon</span>
                    <div>
                        <div class="mil-name">@spec.Name</div>
                        <div class="mil-sub">@spec.Description</div>
                    </div>
                </div>
                <div class="rec-costs">
                    <div>💰 @((spec.GoldCost * CommandStaffService.LandRecruitMult(_nation) * _recCount).ToString("N1")) gold</div>
                    @if (spec.Equipment is not null)
                    {
                        @foreach (var eq in spec.Equipment)
                        {
                            var have = _nation.GetMilitaryItem(eq.ItemId);
                            var need = eq.PerSoldier * _recCount;
                            <div class="@(have >= need ? "ok" : "lack")">
                                @EquipIcon(eq.ItemId) @need.ToString("N0") (have @have.ToString("N0"))
                            </div>
                        }
                    }
                    <div>⏱️ @RecruitDays(_recCount).ToString("N1") days</div>
                    <div>⚔️ +@((_recCount * spec.Strength).ToString("N0")) power</div>
                </div>
                <div class="rec-actions">
                    <div class="qty-row">
                        <button @onclick="() => _recCount = Math.Max(10, _recCount - 100)">−100</button>
                        <span>@_recCount</span>
                        <button @onclick="() => _recCount += 100">+100</button>
                    </div>
                    <button class="mil-btn" @onclick="() => DoRecruit(spec.Type)">RECRUIT</button>
                </div>
            </div>
        }
    }
    else if (_tab == 2)
    {
        <!-- MERCENARIES -->
        <h3>MERCENARY COMPANIES</h3>
        @foreach (var co in MercenaryCatalog.All)
        {
            var spec = UnitCatalog.Get(co.UnitType);
            <div class="rec-card">
                <div class="rec-head">
                    <span class="mil-ico">@co.Icon</span>
                    <div>
                        <div class="mil-name">@co.Name</div>
                        <div class="mil-sub">@spec.Name × @co.Available.ToString("N0") · Morale @((co.Morale * 100).ToString("N0"))%</div>
                    </div>
                </div>
                <div class="rec-costs">
                    <div>💰 Hire: @((co.HireCostPerSoldier * _mercCount).ToString("N1")) gold</div>
                    <div>📅 Upkeep: @((co.UpkeepPerSoldierPerDay * _mercCount).ToString("N2"))/day</div>
                    <div>⏳ Contract: @co.ContractDays days</div>
                </div>
                <div class="rec-actions">
                    <div class="qty-row">
                        <button @onclick="() => _mercCount = Math.Max(50, _mercCount - 50)">−50</button>
                        <span>@_mercCount</span>
                        <button @onclick="() => _mercCount += 50">+50</button>
                    </div>
                    <button class="mil-btn" @onclick="() => DoHire(co.Id)">HIRE</button>
                </div>
            </div>
        }
    }
    else if (_tab == 3)
    {
        <!-- RESERVES & CONSCRIPTION -->
        <h3>RESERVES (@_nation.Reserves.ToString("N0"))</h3>
        <div class="rec-card">
            <div class="rec-costs">
                <div>💰 Mobilize cost: @((Balance.MobilizeCostPerSoldier * _mobCount).ToString("N1")) gold</div>
                <div>⚡ Instant — trained soldiers</div>
            </div>
            <div class="rec-actions">
                <div class="qty-row">
                    <button @onclick="() => _mobCount = Math.Max(100, _mobCount - 100)">−100</button>
                    <span>@_mobCount</span>
                    <button @onclick="() => _mobCount += 100">+100</button>
                </div>
                <button class="mil-btn" @onclick="DoMobilize">MOBILIZE</button>
            </div>
        </div>

        <h3>EMERGENCY CONSCRIPTION</h3>
        @foreach (var level in ConscriptionLevels.All)
        {
            int count = (int)(_nation.Population * level.PopulationFraction);
            <div class="rec-card">
                <div class="rec-head">
                    <span class="mil-ico">@level.Icon</span>
                    <div>
                        <div class="mil-name">@level.Name</div>
                        <div class="mil-sub">@level.Description</div>
                    </div>
                </div>
                <div class="rec-costs">
                    <div>👥 @count.ToString("N0") militia</div>
                    <div>💰 @((level.GoldCostPerSoldier * count).ToString("N0")) gold</div>
                    <div>😠 Unrest +@level.UnrestPenalty</div>
                </div>
                <button class="mil-btn" @onclick="() => DoConscript(level.Id)">CONSCRIPT</button>
            </div>
        }

        <h3>ALLIED ASSISTANCE</h3>
        <div class="mil-sub" style="margin-bottom:6px">A friend (relations ≥ 70) hands over @(Balance.AlliedHelpFraction.ToString("P0")) of its soldiers: they leave its army and join yours. Costs @Balance.AlliedHelpRatingCost relations; once every @Balance.AlliedHelpCooldownDays days per friend.</div>
        @foreach (var a in Engine.State.LiveOtherNations().Where(n => DiplomacyService.ToDisplayRating(n.RelationToPlayer) >= 70).OrderBy(n => n.Name).Take(10))
        {
            <div class="mil-row">
                <span class="mil-ico">@a.Emblem</span>
                <div class="mil-info"><div class="mil-name">@a.Name</div></div>
                <button class="mil-btn" @onclick="() => DoAlly(a.Id)">REQUEST</button>
            </div>
        }
    }
    else if (_tab == 4)
    {
        <!-- EQUIPMENT -->
        <h3>MILITARY EQUIPMENT</h3>
        @foreach (var recipe in MilitaryRecipes.All)
        {
            <div class="mil-row">
                <span class="mil-ico">@recipe.Icon</span>
                <div class="mil-info">
                    <div class="mil-name">@recipe.Name</div>
                    <div class="mil-sub">Stock: @_nation.GetMilitaryItem(recipe.Id).ToString("N0")</div>
                </div>
                <button class="mil-btn" @onclick='() => Nav.NavigateTo("/production")'>MAKE</button>
            </div>
        }
        <div class="mil-sub" style="margin-top:8px">Equipment is crafted in Production → Military. Each soldier needs equipment to recruit.</div>
    }
    else if (_tab == 5)
    {
        <!-- NAVAL STRATEGIC WARFARE & FLEET OPERATIONS -->
        <h3>IMPERIAL NAVY & FLEET OPERATIONS (@_nation.Warships.ToString("N0") 🚢)</h3>

        <!-- Fleet Readiness Overview -->
        <div class="mil-summary" style="margin-bottom:12px;">
            <div class="ms-row"><span>Total Warships</span><b>@_nation.Warships.ToString("N0") 🚢</b></div>
            <div class="ms-row"><span>Docked in Port (Available)</span><b style="color:#2e7d32;">@Engine.AvailableWarships.ToString("N0") ⚓</b></div>
            <div class="ms-row"><span>On Blockade</span><b>@Engine.ActiveNavalMissions.Where(m => m.Type == NavalMissionType.Blockade).Sum(m => m.Warships).ToString("N0") ⚔️</b></div>
            <div class="ms-row"><span>On Trade Patrol</span><b>@Engine.ActiveNavalMissions.Where(m => m.Type == NavalMissionType.Patrol).Sum(m => m.Warships).ToString("N0") 🛡️</b></div>
            <div class="ms-row"><span>Privateering</span><b>@Engine.ActiveNavalMissions.Where(m => m.Type == NavalMissionType.Privateering).Sum(m => m.Warships).ToString("N0") 🏴‍☠️</b></div>
            @if (_nation.HasCommander(CommanderRole.FleetCommander))
            {
                <div class="mil-sub" style="margin-top:6px; color:#2e7d32; font-weight:bold;">
                    ⚓ Fleet Commander Active: +@(((CommandStaffService.NavalCombatMult(_nation) - 1) * 100).ToString("N0"))% combat power & blockade efficiency
                </div>
            }
            else
            {
                <div class="mil-sub" style="margin-top:6px; color:#856404;">
                    ⚓ No Fleet Commander appointed. Appoint one in Command Staff for naval battle bonuses.
                </div>
            }
        </div>

        <!-- Active Squadrons -->
        <h3>ACTIVE SQUADRONS (@Engine.ActiveNavalMissions.Count)</h3>
        @if (Engine.ActiveNavalMissions.Any())
        {
            @foreach (var m in Engine.ActiveNavalMissions)
            {
                var target = Engine.State.AllNations().FirstOrDefault(n => n.Id == m.TargetNationId);
                string targetName = target?.Name ?? "Imperial Shipping Lanes";
                string roleIcon = m.Type switch { NavalMissionType.Blockade => "⚔️", NavalMissionType.Patrol => "🛡️", _ => "🏴‍☠️" };
                string roleName = m.Type switch { NavalMissionType.Blockade => "Blockade Squadron", NavalMissionType.Patrol => "Patrol & Escort Fleet", _ => "Privateer Squadron" };

                <div class="rec-card" style="margin-bottom:8px;">
                    <div class="rec-head">
                        <span class="mil-ico">@roleIcon</span>
                        <div>
                            <div class="mil-name">@roleName — @m.Warships.ToString("N0") Warships</div>
                            <div class="mil-sub">Target: <b>@targetName</b> · Active for @m.DaysActive days</div>
                            @if (m.Type == NavalMissionType.Privateering && m.PlunderGold > 0)
                            {
                                <div class="mil-sub" style="color:#2e7d32; font-weight:bold;">Plunder Seized: @Currency.Cost(m.PlunderGold)</div>
                            }
                        </div>
                    </div>
                    <div style="display:flex; justify-content:flex-end;">
                        <button class="mil-btn" style="background:linear-gradient(#8b3a3a, #5a2020);" @onclick="() => DoRecallMission(m.Id)">RECALL SQUADRON</button>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="mil-sub" style="font-style:italic; margin-bottom:12px;">All imperial warships are currently resting in home dockyards.</div>
        }

        <!-- Strategic Orders Console -->
        <h3>STRATEGIC FLEET ORDERS</h3>
        
        <!-- Order 1: Naval Blockade -->
        <div class="rec-card">
            <div class="rec-head">
                <span class="mil-ico">⚔️</span>
                <div>
                    <div class="mil-name">Enforce Naval Blockade (Economic Siege)</div>
                    <div class="mil-sub">Chokes foreign trade contracts, cuts food/mineral imports, and drains enemy gold.</div>
                </div>
            </div>
            @{
                var atWarNations = Engine.State.LiveOtherNations().Where(n => n.AtWarWithPlayer).ToList();
            }
            @if (atWarNations.Any())
            {
                <div style="margin: 8px 0;">
                    <label style="font-size:0.85rem; font-weight:bold;">Select Target Enemy:</label>
                    <select class="qty-row" style="width:100%; padding:6px; margin-top:4px; font-family:inherit;" @bind="_blockadeTargetId">
                        <option value="">-- Choose Enemy Nation --</option>
                        @foreach (var enemy in atWarNations)
                        {
                            <option value="@enemy.Id">@enemy.Name (fields @enemy.Warships 🚢, holds @Currency.Cost(enemy.Gold))</option>
                        }
                    </select>
                </div>
                <div class="rec-actions">
                    <div class="qty-row">
                        <button @onclick="() => _blockadeShips = Math.Max(5, _blockadeShips - 5)">−5</button>
                        <span>@_blockadeShips 🚢</span>
                        <button @onclick="() => _blockadeShips = Math.Min(Engine.AvailableWarships, _blockadeShips + 5)">+5</button>
                    </div>
                    <button class="mil-btn" disabled="@(Engine.AvailableWarships < _blockadeShips || string.IsNullOrEmpty(_blockadeTargetId))" @onclick="DoDeployBlockade">ENFORCE BLOCKADE</button>
                </div>
            }
            else
            {
                <div class="mil-sub" style="color:#5a4a2a; margin-top:6px;">Your empire is not currently at war with any maritime realm. Declare war to institute a naval blockade.</div>
            }
        </div>

        <!-- Order 2: Patrol Sea Lanes -->
        <div class="rec-card">
            <div class="rec-head">
                <span class="mil-ico">🛡️</span>
                <div>
                    <div class="mil-name">Patrol Imperial Sea Lanes (Convoy Escort)</div>
                    <div class="mil-sub">Protects imperial merchant trade contracts against foreign corsairs and blockades.</div>
                </div>
            </div>
            <div class="rec-actions" style="margin-top:8px;">
                <div class="qty-row">
                    <button @onclick="() => _patrolShips = Math.Max(3, _patrolShips - 5)">−5</button>
                    <span>@_patrolShips 🚢</span>
                    <button @onclick="() => _patrolShips = Math.Min(Engine.AvailableWarships, _patrolShips + 5)">+5</button>
                </div>
                <button class="mil-btn" disabled="@(Engine.AvailableWarships < _patrolShips)" @onclick="DoDeployPatrol">PATROL SEA LANES</button>
            </div>
        </div>

        <!-- Order 3: State Privateering -->
        <div class="rec-card">
            <div class="rec-head">
                <span class="mil-ico">🏴‍☠️</span>
                <div>
                    <div class="mil-name">Commission Privateers (Letters of Marque)</div>
                    <div class="mil-sub">State-sponsored corsairs raid rival merchant shipping, seizing gold directly for the crown.</div>
                </div>
            </div>
            @{
                var rivalNations = Engine.State.LiveOtherNations()
                    .Where(n => TreatyService.ForbidsAttack(Engine.State, _nation.Id, n.Id) is null)
                    .OrderBy(n => n.Name).ToList();
            }
            <div style="margin: 8px 0;">
                <label style="font-size:0.85rem; font-weight:bold;">Select Target Realm:</label>
                <select class="qty-row" style="width:100%; padding:6px; margin-top:4px; font-family:inherit;" @bind="_privateerTargetId">
                    <option value="">-- Choose Rival Nation --</option>
                    @foreach (var rival in rivalNations)
                    {
                        <option value="@rival.Id">@rival.Name (Treasury: @Currency.Cost(rival.Gold))</option>
                    }
                </select>
            </div>
            <div class="rec-actions">
                <div class="qty-row">
                    <button @onclick="() => _privateerShips = Math.Max(3, _privateerShips - 5)">−5</button>
                    <span>@_privateerShips 🚢</span>
                    <button @onclick="() => _privateerShips = Math.Min(Engine.AvailableWarships, _privateerShips + 5)">+5</button>
                </div>
                <button class="mil-btn" disabled="@(Engine.AvailableWarships < _privateerShips || string.IsNullOrEmpty(_privateerTargetId))" @onclick="DoDeployPrivateering">COMMISSION</button>
            </div>
        </div>

        <!-- Naval Dockyard -->
        <h3>IMPERIAL DOCKYARDS</h3>
        <div class="rec-card">
            <div class="rec-head">
                <span class="mil-ico">🚢</span>
                <div>
                    <div class="mil-name">Build Warships</div>
                    <div class="mil-sub">Requires Ship Parts + Wood + Iron + Gold</div>
                </div>
            </div>
            <div class="rec-costs">
                <div>💰 @((WarshipSpec.GoldCost * CommandStaffService.WarshipRecruitMult(_nation) * _shipCount).ToString("N1")) gold</div>
                <div>🪵 @((WarshipSpec.WoodCost * _shipCount).ToString("N0")) wood (have @_nation.Wood.ToString("N0"))</div>
                <div>⛓️ @((WarshipSpec.IronCost * _shipCount).ToString("N0")) iron (have @_nation.Iron.ToString("N0"))</div>
                <div>🔧 @((2 * _shipCount).ToString("N0")) ship parts (have @_nation.GetMilitaryItem("shipparts").ToString("N0"))</div>
            </div>
            <div class="rec-actions">
                <div class="qty-row">
                    <button @onclick="() => _shipCount = Math.Max(1, _shipCount - 5)">−5</button>
                    <span>@_shipCount</span>
                    <button @onclick="() => _shipCount += 5">+5</button>
                </div>
                <button class="mil-btn" @onclick="DoBuildShips">BUILD WARSHIPS</button>
            </div>
        </div>
    }
</div>

@code {
    private Nation _nation => Engine.State.PlayerNation;
    private int _tab = 0;
    private string? _error;
    private string? _msg;
    private int _recCount = 100;
    private int _mercCount = 100;
    private int _mobCount = 500;
    private int _shipCount = 10;
    [Inject] private NavigationManager Nav { get; set; } = default!;

    protected override void OnInitialized() => Engine.StateChanged += OnStateChanged;
    private void OnStateChanged() => InvokeAsync(StateHasChanged);
    public void Dispose() => Engine.StateChanged -= OnStateChanged;

    private double MilitaryPower() => DiplomacyService.MilitaryPower(_nation);

    private double DailyUpkeep()
    {
        double u = 0;
        foreach (var s in _nation.Units)
            u += UnitCatalog.Get(s.Type).UpkeepPerDay * s.Count * CommandStaffService.LandUpkeepMult(_nation);
        u += _nation.Warships * WarshipSpec.UpkeepPerDay * CommandStaffService.NavalUpkeepMult(_nation);
        foreach (var c in _nation.MercenaryContracts)
        {
            var co = MercenaryCatalog.Get(c.CompanyId);
            if (co is not null) u += co.UpkeepPerSoldierPerDay * c.Count;
        }
        return u;
    }

    private double RecruitDays(int count) =>
        Math.Max(1, Math.Min(Balance.RecruitDaysPerSoldier * count, Balance.MaxRecruitDays));

    private string EquipIcon(string id) => id switch
    {
        "helmet" => "🪖", "dagger" => "🗡️", "pike" => "🔱",
        "shotgun" => "🔫", "arquebus" => "🎯", "shipparts" => "🔧",
        _ => "📦"
    };

    private void DoRecruit(UnitType t)
    {
        _error = Engine.StartRecruitment(t, _recCount);
        _msg = _error is null ? $"Recruiting {_recCount:N0} {UnitCatalog.Get(t).Name}." : null;
    }

    private void CancelRec(string id)
    {
        _error = Engine.CancelRecruitment(id);
    }

    private void DoHire(string id)
    {
        _error = Engine.HireMercenaries(id, _mercCount);
        _msg = _error is null ? $"Hired {_mercCount:N0} mercenaries." : null;
    }

    private void DoMobilize()
    {
        _error = Engine.MobilizeReserves(_mobCount);
        _msg = _error is null ? $"Mobilized {_mobCount:N0} reserves." : null;
    }

    private void DoConscript(string id)
    {
        _error = Engine.Conscript(id);
        _msg = _error is null ? "Conscription complete." : null;
    }

    private void DoAlly(string id)
    {
        _msg = Engine.RequestAlliedAssistance(id);
        _error = null;
    }

    private void DoBuildShips()
    {
        // Warships need 2 ship parts each
        double parts = _nation.GetMilitaryItem("shipparts");
        if (parts < 2 * _shipCount) { _error = "Not enough Ship Parts."; return; }
        _error = Engine.RecruitWarships(_shipCount);
        if (_error is null)
        {
            _nation.AddMilitaryItem("shipparts", -2 * _shipCount);
            _msg = $"Building {_shipCount} warships.";
        }
    }

    private string? _blockadeTargetId;
    private int _blockadeShips = 5;
    private int _patrolShips = 5;
    private string? _privateerTargetId;
    private int _privateerShips = 5;

    private void DoDeployBlockade()
    {
        if (string.IsNullOrEmpty(_blockadeTargetId))
        {
            _error = "Select a target enemy nation to blockade.";
            return;
        }
        _error = Engine.DeployNavalBlockade(_blockadeTargetId, _blockadeShips);
        if (_error is null)
        {
            _msg = $"Naval blockade squadron deployed with {_blockadeShips} warships.";
        }
    }

    private void DoDeployPatrol()
    {
        _error = Engine.DeployNavalPatrol(_patrolShips);
        if (_error is null)
        {
            _msg = $"Trade patrol fleet deployed with {_patrolShips} warships.";
        }
    }

    private void DoDeployPrivateering()
    {
        if (string.IsNullOrEmpty(_privateerTargetId))
        {
            _error = "Select a target realm for privateering.";
            return;
        }
        _error = Engine.DeployPrivateering(_privateerTargetId, _privateerShips);
        if (_error is null)
        {
            _msg = $"Letters of marque issued to {_privateerShips} privateer warships.";
        }
    }

    private void DoRecallMission(string missionId)
    {
        _error = Engine.RecallNavalMission(missionId);
        if (_error is null)
        {
            _msg = "Naval squadron recalled back to dockyards.";
        }
    }

    private void PayNow() => _error = Engine.PayMaintenance();
}

