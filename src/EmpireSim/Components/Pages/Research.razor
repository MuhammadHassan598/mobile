@page "/research"
@using EmpireSim.Core.Models
@using EmpireSim.Core.Services
@inject GameEngine Engine
@inject NavigationManager Nav
@implements IDisposable

@{
    var state = Engine.State;
    var player = state.PlayerNation;
    var contracts = ResearchService.Contracts(state);
    double own = ResearchService.DailyPoints(player);
    double fromContracts = ResearchService.ContractIncome(state);
    double perDay = own + fromContracts;
    var current = player.CurrentResearchId is null ? null : TechnologyCatalog.Get(player.CurrentResearchId);
}

<div class="res-wrap">
    <div class="res-header">
        <button class="res-back" @onclick='() => Nav.NavigateTo("/")'>◀ BACK</button>
        <h2>🔬 RESEARCH</h2>
        <span class="res-spacer"></span>
    </div>

    <div class="res-card">
        <div class="res-points">@Math.Floor(player.ResearchPoints).ToString("N0") <span>points</span></div>
        <div class="res-rate">+@perDay.ToString("0.0") a day</div>
        <div class="res-break">
            <span>Our own: @own.ToString("0.0")</span>
            <span>Contracts: +@fromContracts.ToString("0.0")</span>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(_error))
    {
        <div class="res-error">⚠ @_error</div>
    }

    @if (current is not null)
    {
        double missing = Math.Max(0, current.Cost - player.ResearchPoints);
        int days = perDay > 0 ? (int)Math.Ceiling(missing / perDay) : 0;
        <div class="res-current">
            <div class="res-current-title">Researching: @current.Icon <b>@current.Name</b></div>
            <div class="res-bar"><div class="res-bar-fill" style="width: @(Math.Min(100, player.ResearchPoints / current.Cost * 100).ToString("0"))%"></div></div>
            <div class="res-sub">@Math.Floor(player.ResearchPoints).ToString("N0") / @current.Cost.ToString("N0") points · @(missing <= 0 ? "completes tomorrow" : $"about {days} day{(days == 1 ? "" : "s")} left")</div>
        </div>
    }
    else
    {
        <div class="res-hint">Choose a technology below. Points keep banking meanwhile and are spent when it completes.</div>
    }

    <h3>TECHNOLOGIES</h3>
    @foreach (var tech in TechnologyCatalog.All)
    {
        bool done = ResearchService.Has(player, tech.Id);
        bool active = player.CurrentResearchId == tech.Id;
        <div class="res-tech @(done ? "done" : active ? "active" : "")">
            <span class="res-tech-ico">@tech.Icon</span>
            <div class="res-tech-body">
                <div class="res-tech-name">@tech.Name</div>
                <div class="res-tech-effect">@tech.Effect</div>
                <div class="res-sub">@tech.Description</div>
                <div class="res-sub">Cost: @tech.Cost.ToString("N0") points</div>
            </div>
            @if (done)
            {
                <span class="res-badge done">✔ Done</span>
            }
            else if (active)
            {
                <span class="res-badge active">Researching</span>
            }
            else
            {
                <button class="res-btn" @onclick="() => Start(tech.Id)">RESEARCH</button>
            }
        </div>
    }

    <h3>RESEARCH CONTRACTS (@contracts.Count / @Balance.ResearchContractMax)</h3>
    @if (contracts.Count == 0)
    {
        <div class="res-hint">None yet. On a country's Diplomacy page, open Treaties → Research Contract: a bigger partner shares half of its daily research with you for a year.</div>
    }
    @foreach (var c in contracts)
    {
        var partner = state.OtherNations.FirstOrDefault(n => n.Id == c.NationBId);
        if (partner is null) { continue; }
        <div class="res-contract">
            <span class="res-tech-ico">@partner.Emblem</span>
            <div class="res-tech-body">
                <div class="res-tech-name">@partner.Name</div>
                <div class="res-sub">+@((ResearchService.DailyPoints(partner) * Balance.ResearchContractShare).ToString("0.0")) points a day · until @c.ExpiresDate?.ToString("dd-MM-yyyy")</div>
            </div>
        </div>
    }
</div>

@code {
    private string? _error;

    protected override void OnInitialized() => Engine.StateChanged += OnStateChanged;
    private void OnStateChanged() => InvokeAsync(StateHasChanged);
    public void Dispose() => Engine.StateChanged -= OnStateChanged;

    private void Start(string techId) => _error = Engine.StartResearch(techId);
}

<style>
.res-wrap { background: linear-gradient(#f0e0b0, #e8d090); min-height: 100vh; padding: 10px 8px 90px; font-family: Georgia, serif; color: #3d2b1f; }
.res-header { display: flex; align-items: center; margin-bottom: 10px; }
.res-back { background: linear-gradient(#7a5230, #4a2e14); color: #f5e6c4; border: 2px solid #2e1c0c; border-radius: 6px; padding: 8px 14px; cursor: pointer; font-family: inherit; }
.res-header h2 { flex: 1; text-align: center; margin: 0; letter-spacing: 2px; font-size: 1.1rem; color: #3d2b1f; }
.res-spacer { width: 80px; }
.res-card { text-align: center; background: linear-gradient(#3b2a1a, #1f160d); border: 3px solid #c9a227; border-radius: 10px; padding: 12px; color: #f5e6c4; margin-bottom: 10px; }
.res-points { font-size: 2rem; font-weight: bold; }
.res-points span { font-size: 0.9rem; font-weight: normal; color: #c9b98a; }
.res-rate { color: #8be28b; font-weight: bold; }
.res-break { display: flex; justify-content: center; gap: 16px; font-size: 0.8rem; color: #c9b98a; margin-top: 4px; }
.res-error { background: #f8d7da; color: #721c24; border-radius: 6px; padding: 8px; margin-bottom: 8px; font-size: 0.9rem; }
.res-hint { font-size: 0.85rem; color: #5a4a2a; margin: 6px 2px 10px; }
.res-current { background: rgba(255,255,255,.4); border: 2px solid #1565c0; border-radius: 8px; padding: 10px; margin-bottom: 10px; }
.res-current-title { font-size: 0.95rem; margin-bottom: 6px; }
.res-bar { height: 10px; background: #d4b896; border-radius: 5px; overflow: hidden; }
.res-bar-fill { height: 100%; background: linear-gradient(#42a5f5, #1565c0); }
.res-sub { font-size: 0.78rem; color: #5a4a2a; margin-top: 3px; }
.res-wrap h3 { color: #5a3a1a; font-size: 0.9rem; letter-spacing: 1px; margin: 14px 0 6px; border-bottom: 2px solid #8b6914; padding-bottom: 4px; }
.res-tech, .res-contract { display: flex; align-items: center; gap: 10px; background: rgba(255,255,255,.35); border: 1px solid #c9b98a; border-left: 4px solid #8b6914; border-radius: 6px; padding: 8px; margin-bottom: 6px; }
.res-tech.done { border-left-color: #2e7d32; }
.res-tech.active { border-left-color: #1565c0; }
.res-tech-ico { font-size: 1.6rem; width: 40px; height: 40px; flex-shrink: 0; display: flex; align-items: center; justify-content: center; border-radius: 50%; background: radial-gradient(circle at 35% 30%, #f7ead0, #c9a96a 70%); border: 2px solid #2e1c0c; }
.res-tech-body { flex: 1; min-width: 0; }
.res-tech-name { font-weight: bold; font-size: 0.95rem; }
.res-tech-effect { color: #2e7d32; font-size: 0.85rem; font-weight: bold; }
.res-btn { background: linear-gradient(#7a5230, #4a2e14); color: #f5e6c4; border: 2px solid #2e1c0c; border-radius: 6px; padding: 8px 10px; cursor: pointer; font-family: inherit; font-size: 0.75rem; font-weight: bold; }
.res-badge { font-size: 0.7rem; font-weight: bold; padding: 3px 8px; border-radius: 10px; color: #fff; }
.res-badge.done { background: #2e7d32; }
.res-badge.active { background: #1565c0; }
</style>
