@page "/worldnews"
@using EmpireSim.Core.Models
@using EmpireSim.Core.Services
@inject GameEngine Engine
@inject NavigationManager Nav
@implements IDisposable

@{
    var state = Engine.State;
    var military = WorldNewsReport.Items(state, true, _stateId);
    var other = WorldNewsReport.Items(state, false, _stateId);
    var shown = _military ? military : other;
}

<div class="news-wrap">
    <div class="news-header">
        <button class="news-back" @onclick='() => Nav.NavigateTo("/")'>◀ BACK</button>
        <h2>WORLD NEWS</h2>
        <span class="news-spacer"></span>
    </div>
    <div class="news-note">What other countries do among themselves. Anything that involves you or your allies is in your Movement Report instead.</div>

    <!-- Country filter and grouping -->
    <div class="news-controls">
        <button class="news-state" @onclick="() => _picker = true" title="Filter by country">
            <span class="news-state-emblem">@(_stateId is null ? "🌍" : Emblem(_stateId))</span>
            <span class="news-state-name">@(_stateId is null ? "All" : NameOf(_stateId))</span>
        </button>
        <div class="news-seg">
            <button class="@(_byState ? "active" : "")" @onclick="() => _byState = true">By state</button>
            <button class="@(!_byState ? "active" : "")" @onclick="() => _byState = false">By date</button>
        </div>
    </div>

    <!-- The two sections of the news -->
    <div class="news-tabs">
        <button class="@(_military ? "active" : "")" @onclick="() => _military = true">⚔ Military <span class="news-count">@military.Count</span></button>
        <button class="@(!_military ? "active" : "")" @onclick="() => _military = false">🌐 Other <span class="news-count">@other.Count</span></button>
    </div>

    @if (shown.Count == 0)
    {
        <div class="news-empty">
            <div class="news-empty-title">@(_military ? "No military news" : "No other news")</div>
            <div class="news-empty-ico">@(_military ? "⚔️" : "🌐")</div>
            <div class="news-empty-hint">
                @(_military
                    ? "Wars, marches, battles, conquests, plunder and soldiers lent between other countries will be listed here."
                    : "Alliances and treaties, gold, goods, colonies, missions and diplomacy between other countries will be listed here.")
            </div>
        </div>
    }
    else if (_byState)
    {
        @foreach (var g in WorldNewsReport.ByState(state, _military, _stateId))
        {
            <div class="news-group"><span class="news-group-emblem">@Emblem(g.StateId)</span> @g.StateName <span class="news-count">@g.Items.Count</span></div>
            @foreach (var m in g.Items) { @NewsRow(m) }
        }
    }
    else
    {
        @foreach (var m in shown) { @NewsRow(m) }
    }
</div>

<!-- Country picker -->
@if (_picker)
{
    <div class="news-overlay" @onclick="() => _picker = false">
        <div class="news-panel" @onclick:stopPropagation>
            <div class="news-panel-title">Show world news about</div>
            <button class="news-pick @(_stateId is null ? "active" : "")" @onclick="() => Pick(null)">
                <span class="news-pick-emblem">🌍</span><span class="news-pick-name">All countries</span>
            </button>
            @foreach (var n in InvolvedStates())
            {
                <button class="news-pick @(_stateId == n.Id ? "active" : "")" @onclick="() => Pick(n.Id)">
                    <span class="news-pick-emblem">@n.Emblem</span>
                    <span class="news-pick-name">@n.Name</span>
                    <span class="news-count">@WorldNewsReport.Items(Engine.State, null, n.Id).Count</span>
                </button>
            }
            @if (!InvolvedStates().Any())
            {
                <div class="news-empty-hint">No other country has done anything yet.</div>
            }
            <button class="news-close" @onclick="() => _picker = false">CLOSE</button>
        </div>
    </div>
}

@code {
    private bool _military = true;    // which section: military (true) or other news (false)
    private bool _byState;            // false = by date (default)
    private bool _picker;
    private string? _stateId;         // null = every country; otherwise only news that involves that country

    protected override void OnInitialized() => Engine.StateChanged += OnStateChanged;
    private void OnStateChanged() => InvokeAsync(StateHasChanged);
    public void Dispose() => Engine.StateChanged -= OnStateChanged;

    private void Pick(string? id)
    {
        _stateId = id;
        _picker = false;
    }

    private string Emblem(string id) =>
        Engine.State.AllNations().FirstOrDefault(n => n.Id == id)?.Emblem ?? "🌍";

    private string NameOf(string id) =>
        Engine.State.AllNations().FirstOrDefault(n => n.Id == id)?.Name ?? id;

    /// <summary>Countries that appear anywhere in the world news.</summary>
    private IEnumerable<Nation> InvolvedStates()
    {
        var state = Engine.State;
        var ids = new HashSet<string>();
        foreach (var m in WorldNewsReport.Items(state)) { ids.Add(m.FromId); ids.Add(m.ToId); }
        return state.OtherNations.Where(n => ids.Contains(n.Id)).OrderBy(n => n.Name);
    }

    private static string StatusClass(MovementStatus s) => s switch
    {
        MovementStatus.Completed => "done",
        MovementStatus.UnderWay => "going",
        _ => "failed"
    };

    private RenderFragment NewsRow(MovementRecord m) => @<div class="news-row @StatusClass(m.Status)">
        <span class="news-ico">@MovementReport.Icon(m.Kind)</span>
        <div class="news-body">
            <div class="news-text">@m.Text</div>
            <div class="news-meta">@m.Date.ToString("dd-MM-yyyy") · @Emblem(m.FromId) @m.FromName ➜ @Emblem(m.ToId) @m.ToName</div>
        </div>
        <span class="news-pill @StatusClass(m.Status)">@MovementReport.StatusName(m.Status)</span>
    </div>;
}

<style>
.news-wrap { background: linear-gradient(#f0e0b0, #e8d090); min-height: 100vh; padding: 10px 8px 90px; font-family: Georgia, serif; color: #3d2b1f; }
.news-header { display: flex; align-items: center; margin-bottom: 6px; }
.news-back { background: linear-gradient(#7a5230, #4a2e14); color: #f5e6c4; border: 2px solid #2e1c0c; border-radius: 6px; padding: 8px 14px; cursor: pointer; font-family: inherit; }
.news-header h2 { flex: 1; text-align: center; margin: 0; letter-spacing: 2px; font-size: 1.1rem; color: #3d2b1f; }
.news-spacer { width: 80px; }
.news-note { font-size: 0.78rem; color: #5a4a2a; text-align: center; margin: 0 4px 10px; }
.news-controls { display: flex; align-items: center; gap: 8px; margin-bottom: 8px; }
.news-state { display: flex; flex-direction: column; align-items: center; gap: 2px; min-width: 64px; padding: 4px 8px; background: linear-gradient(#3b2a1a, #1f160d); border: 2px solid #c9a227; border-radius: 10px; color: #f5e6c4; cursor: pointer; font-family: inherit; }
.news-state-emblem { font-size: 1.5rem; line-height: 1.1; }
.news-state-name { font-size: 0.62rem; max-width: 70px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.news-seg { flex: 1; display: flex; border: 2px solid #2e1c0c; border-radius: 6px; overflow: hidden; }
.news-seg button { flex: 1; padding: 10px 4px; background: #f7ead0; color: #3d2b1f; border: none; cursor: pointer; font-family: inherit; font-weight: bold; font-size: 0.85rem; }
.news-seg button.active { background: linear-gradient(#4a4a4a, #262626); color: #f5e6c4; }
.news-tabs { display: flex; margin-bottom: 8px; border-radius: 6px; overflow: hidden; border: 2px solid #8b6914; }
.news-tabs button { flex: 1; padding: 10px 4px; background: rgba(139,105,20,.25); color: #3d2b1f; border: none; cursor: pointer; font-family: inherit; font-weight: bold; font-size: 0.95rem; }
.news-tabs button.active { background: linear-gradient(#7a5230, #4a2e14); color: #f5e6c4; }
.news-count { display: inline-block; min-width: 18px; padding: 0 5px; border-radius: 9px; background: rgba(0,0,0,.18); font-size: 0.72rem; text-align: center; font-weight: bold; }
.news-empty { text-align: center; padding: 28px 12px; }
.news-empty-title { font-weight: bold; font-size: 1.05rem; margin-bottom: 14px; }
.news-empty-ico { width: 120px; height: 120px; margin: 0 auto 14px; border-radius: 50%; border: 4px solid #6b5a3a; display: flex; align-items: center; justify-content: center; font-size: 3.4rem; opacity: 0.6; }
.news-empty-hint { font-size: 0.85rem; color: #5a4a2a; max-width: 300px; margin: 0 auto; }
.news-group { display: flex; align-items: center; gap: 6px; margin: 12px 0 6px; padding-bottom: 4px; border-bottom: 2px solid #8b6914; font-weight: bold; font-size: 0.95rem; color: #5a3a1a; }
.news-group-emblem { font-size: 1.3rem; }
.news-group .news-count { margin-left: auto; }
.news-row { display: flex; align-items: flex-start; gap: 8px; background: rgba(255,255,255,.35); border: 1px solid #c9b98a; border-left: 4px solid #8b6914; border-radius: 6px; padding: 8px; margin-bottom: 5px; }
.news-row.done { border-left-color: #2e7d32; }
.news-row.going { border-left-color: #1565c0; }
.news-row.failed { border-left-color: #b71c1c; }
.news-ico { font-size: 1.4rem; width: 34px; height: 34px; flex-shrink: 0; display: flex; align-items: center; justify-content: center; border-radius: 50%; background: radial-gradient(circle at 35% 30%, #f7ead0, #c9a96a 70%); border: 2px solid #2e1c0c; }
.news-body { flex: 1; min-width: 0; }
.news-text { font-size: 0.88rem; line-height: 1.25; }
.news-meta { font-size: 0.74rem; color: #5a4a2a; margin-top: 2px; }
.news-pill { flex-shrink: 0; align-self: center; font-size: 0.66rem; font-weight: bold; padding: 2px 7px; border-radius: 10px; color: #fff; }
.news-pill.done { background: #2e7d32; }
.news-pill.going { background: #1565c0; }
.news-pill.failed { background: #b71c1c; }
.news-overlay { position: fixed; inset: 0; z-index: 100; background: rgba(0,0,0,.6); display: flex; align-items: center; justify-content: center; padding: 12px; }
.news-panel { background: linear-gradient(#f5e6c4, #e2cb92); border: 3px double #8b6914; border-radius: 10px; padding: 14px; max-width: 360px; width: 100%; max-height: 80vh; overflow-y: auto; font-family: Georgia, serif; color: #3d2b1f; }
.news-panel-title { font-weight: bold; text-align: center; margin-bottom: 8px; letter-spacing: 1px; }
.news-pick { display: flex; align-items: center; gap: 10px; width: 100%; padding: 8px; margin-bottom: 4px; background: rgba(255,255,255,.4); border: 2px solid #c9b98a; border-radius: 8px; cursor: pointer; font-family: inherit; color: #3d2b1f; text-align: left; }
.news-pick.active { border-color: #c9a227; background: rgba(201,162,39,.25); }
.news-pick-emblem { font-size: 1.5rem; width: 34px; text-align: center; }
.news-pick-name { flex: 1; font-weight: bold; font-size: 0.92rem; }
.news-close { width: 100%; margin-top: 8px; padding: 10px; background: linear-gradient(#8a8a8a, #5a5a5a); color: #fff; border: 2px solid #2e1c0c; border-radius: 6px; cursor: pointer; font-family: inherit; font-weight: bold; }
</style>
