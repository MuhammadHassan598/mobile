@page "/population"
@inject GameEngine Engine
@implements IDisposable

<div class="dashboard">
    <div class="topbar">
        <div class="nation-name">Population</div>
    </div>

    <div class="cards">
        <div class="card"><div class="label">Total</div><div class="value">@_nation.Population.ToString("N0")</div></div>
        <div class="card"><div class="label">Capital</div><div class="value">@_nation.CapitalName</div></div>
        <div class="card"><div class="label">Countries annexed</div><div class="value">@Engine.State.NationsAnnexedByPlayer</div></div>
        <div class="card"><div class="label">Colonies founded</div><div class="value">@_nation.ColoniesFounded</div></div>
    </div>

    <p class="page-hint">Your people are one nation — every subject pays tax, eats food, and may be called to the colors.</p>
</div>

@code {
    private Nation _nation => Engine.State.PlayerNation;

    protected override void OnInitialized() => Engine.StateChanged += OnStateChanged;
    private void OnStateChanged() => InvokeAsync(StateHasChanged);
    public void Dispose() => Engine.StateChanged -= OnStateChanged;
}
