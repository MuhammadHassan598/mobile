@page "/population"
@using EmpireSim.Core.Models
@using EmpireSim.Core.Services
@inject GameEngine Engine
@implements IDisposable

<div class="pop-wrap">
    <div class="pop-header">
        <h2>👥 POPULATION</h2>
        <div class="pop-nation">@_nation.Emblem @_nation.Name</div>
    </div>

    <div class="pop-tabs">
        <button class="@(_tab == 0 ? "active" : "")" @onclick="() => _tab = 0">
            <span class="tab-ico">👥</span><span>Overview</span>
        </button>
        <button class="@(_tab == 1 ? "active" : "")" @onclick="() => _tab = 1">
            <span class="tab-ico">🎖️</span><span>Recruit</span>
        </button>
    </div>

    @if (!string.IsNullOrEmpty(_error))
    {
        <div class="pop-error">⚠ @_error</div>
    }
    @if (!string.IsNullOrEmpty(_msg))
    {
        <div class="pop-msg">@_msg</div>
    }

    @if (_tab == 0)
    {
        <!-- Overview -->
        <div class="pop-total">
            <div class="pop-total-label">TOTAL POPULATION</div>
            <div class="pop-total-value">👥 @_nation.Population.ToString("N0")</div>
        </div>

        <h3>POPULATION BY GROUPS</h3>
        @foreach (var g in Groups)
        {
            <div class="pop-row">
                <span class="pop-icon">@g.Icon</span>
                <div class="pop-info">
                    <div class="pop-name">@g.Name</div>
                    <div class="pop-count">@PopulationService.GetGroupCount(_nation.Workforce, g.Key).ToString("N0") people</div>
                </div>
            </div>
        }

        <h3>DEMOGRAPHICS</h3>
        <div class="pop-row"><span class="pop-icon">🧒</span><div class="pop-info"><div class="pop-name">Children</div><div class="pop-count">@_nation.Demographics.Children.ToString("N0") people</div></div></div>
        <div class="pop-row"><span class="pop-icon">👨</span><div class="pop-info"><div class="pop-name">Adult Men</div><div class="pop-count">@_nation.Demographics.AdultMen.ToString("N0") people</div></div></div>
        <div class="pop-row"><span class="pop-icon">👩</span><div class="pop-info"><div class="pop-name">Adult Women</div><div class="pop-count">@_nation.Demographics.AdultWomen.ToString("N0") people</div></div></div>
        <div class="pop-row"><span class="pop-icon">🧓</span><div class="pop-info"><div class="pop-name">Elderly</div><div class="pop-count">@_nation.Demographics.Elderly.ToString("N0") people</div></div></div>
    }
    else
    {
        <!-- Recruitment -->
        <h3>PERSONNEL RECRUITMENT</h3>
        @foreach (var p in PersonnelCatalog.All)
        {
            long count = p.Id == "military"
                ? _nation.Workforce.MilitaryPersonnel
                : PopulationService.GetGroupCount(_nation.Workforce, p.Id == "spy" ? "spies" : "saboteurs");
            <div class="rec-card">
                <span class="pop-icon">@p.Icon</span>
                <div class="pop-info">
                    <div class="pop-name">@p.Name</div>
                    <div class="pop-count">@count.ToString("N0")</div>
                    <div class="pop-desc">@p.Description</div>
                </div>
                <button class="pop-btn" @onclick="() => _selected = p">SELECT</button>
            </div>
        }
    }
</div>

<!-- Hiring Modal -->
@if (_selected is not null)
{
    var def = _selected;
    double totalCost = def.GoldCostPerPerson * _qty;
    bool canAfford = _nation.Gold >= totalCost;
    long maxAvailable = def.EligibleSources.Max(s => PopulationService.GetGroupCount(_nation.Workforce, s));
    bool valid = _qty > 0 && _qty <= maxAvailable && canAfford;

    <div class="popup-overlay" @onclick="() => _selected = null">
        <div class="popup-panel" @onclick:stopPropagation>
            <div class="pop-modal-icon">@def.Icon</div>
            <div class="pop-modal-name">@def.Name.ToUpper()</div>
            <div class="c-row"><span>🪙 Cost per person:</span><b>@def.GoldCostPerPerson.ToString("N1") Gold</b></div>
            <div class="c-row"><span>Quantity:</span>
                <div class="qty-row">
                    <button @onclick="() => _qty = Math.Max(1, _qty - 10)">−10</button>
                    <input type="number" @bind="_qty" min="1" class="qty-input" />
                    <button @onclick="() => _qty += 10">+10</button>
                </div>
            </div>
            <div class="c-row total"><span>Total Cost:</span><b>@totalCost.ToString("N0") 🪙</b></div>
            <div class="pop-note">Available workers: @maxAvailable.ToString("N0")</div>
            @if (!canAfford)
            {
                <div class="pop-insufficient">Insufficient Gold!</div>
            }
            <div class="popup-actions">
                <button class="popup-btn cancel" @onclick="() => _selected = null">CANCEL</button>
                <button class="popup-btn confirm" disabled="@(!valid)" @onclick="() => DoHire(def.Id)">HIRE</button>
            </div>
        </div>
    </div>
}

@code {
    private Nation _nation => Engine.State.PlayerNation;
    private int _tab = 0;
    private string? _error;
    private string? _msg;
    private PersonnelDefinition? _selected;
    private long _qty = 100;

    private record PopGroup(string Key, string Name, string Icon);
    private readonly List<PopGroup> Groups = new()
    {
        new("peasants", "Peasants", "🌾"),
        new("craftsmen", "Craftsmen", "🔨"),
        new("military", "Military Personnel", "⚔️"),
        new("merchants", "Merchants", "💼"),
        new("spies", "Spies", "🕵️"),
        new("saboteurs", "Saboteurs", "💣"),
    };

    protected override void OnInitialized()
    {
        _nation.EnsureTaxationInitialized();
        Engine.StateChanged += OnStateChanged;
    }
    private void OnStateChanged() => InvokeAsync(StateHasChanged);
    public void Dispose() => Engine.StateChanged -= OnStateChanged;

    private void DoHire(string id)
    {
        _error = Engine.RecruitPersonnel(id, _qty);
        if (_error is null)
        {
            var def = PersonnelCatalog.Get(id);
            _msg = $"Hired {_qty:N0} {def?.Name}.";
            _selected = null;
            _qty = 100;
        }
    }
}

<style>
.pop-wrap { background: linear-gradient(#f0e0b0, #e8d090); min-height: 100vh; padding: 10px 8px 90px; font-family: Georgia, serif; color: #3d2b1f; }
.pop-header { text-align: center; margin-bottom: 10px; }
.pop-header h2 { margin: 0; letter-spacing: 2px; }
.pop-nation { color: #5a4a2a; font-size: 0.95rem; }
.pop-tabs { display: flex; gap: 12px; justify-content: center; margin-bottom: 12px; }
.pop-tabs button { display: flex; flex-direction: column; align-items: center; gap: 4px; width: 90px; height: 90px; border-radius: 50%; background: linear-gradient(#4a7a8a, #2e4a5a); border: 3px solid #1a2a3a; color: #fff; cursor: pointer; font-family: inherit; justify-content: center; }
.pop-tabs button.active { border-color: #ffd700; box-shadow: 0 0 12px rgba(255,215,0,.6); }
.tab-ico { font-size: 1.8rem; }
.pop-tabs button span:last-child { font-size: 0.7rem; font-weight: bold; }
.pop-error { background: #f8d7da; color: #721c24; border-radius: 6px; padding: 8px; margin-bottom: 8px; font-size: 0.9rem; }
.pop-msg { background: #d4edda; color: #155724; border-radius: 6px; padding: 8px; margin-bottom: 8px; font-size: 0.9rem; }
.pop-total { background: rgba(255,255,255,.4); border: 2px solid #8b6914; border-radius: 8px; padding: 14px; text-align: center; margin-bottom: 12px; }
.pop-total-label { font-size: 0.85rem; letter-spacing: 2px; color: #5a4a2a; }
.pop-total-value { font-size: 1.6rem; font-weight: bold; }
.pop-wrap h3 { color: #5a3a1a; font-size: 0.9rem; letter-spacing: 1px; margin: 12px 0 6px; border-bottom: 2px solid #8b6914; padding-bottom: 4px; }
.pop-row { display: flex; align-items: center; gap: 10px; background: rgba(255,255,255,.3); border: 1px solid #c9b98a; border-radius: 6px; padding: 10px; margin-bottom: 4px; }
.pop-icon { font-size: 1.8rem; width: 40px; text-align: center; }
.pop-info { flex: 1; }
.pop-name { font-weight: bold; font-size: 1rem; }
.pop-count { font-size: 0.9rem; color: #5a4a2a; }
.pop-desc { font-size: 0.8rem; color: #5a4a2a; font-style: italic; }
.rec-card { display: flex; align-items: center; gap: 10px; background: rgba(255,255,255,.35); border: 2px solid #8b6914; border-radius: 8px; padding: 12px; margin-bottom: 8px; }
.pop-btn { background: linear-gradient(#7a5230, #4a2e14); color: #f5e6c4; border: 2px solid #2e1c0c; border-radius: 6px; padding: 8px 16px; cursor: pointer; font-family: inherit; font-weight: bold; }
.popup-overlay { position: fixed; inset: 0; z-index: 100; background: rgba(0,0,0,.6); display: flex; align-items: center; justify-content: center; padding: 12px; }
.popup-panel { background: linear-gradient(#f5e6c4, #e2cb92); border: 3px double #8b6914; border-radius: 10px; padding: 16px; max-width: 360px; width: 100%; font-family: Georgia, serif; color: #3d2b1f; text-align: center; }
.pop-modal-icon { font-size: 3rem; margin-bottom: 4px; }
.pop-modal-name { font-size: 1.2rem; font-weight: bold; letter-spacing: 1px; margin-bottom: 8px; }
.c-row { display: flex; justify-content: space-between; align-items: center; padding: 6px 0; border-bottom: 1px solid #c9b98a; font-size: 0.92rem; text-align: left; }
.c-row.total { font-size: 1.05rem; border-bottom: 2px solid #8b6914; }
.qty-row { display: flex; align-items: center; gap: 6px; }
.qty-row button { background: #d4b896; border: 1px solid #8b6914; border-radius: 4px; padding: 4px 10px; cursor: pointer; font-family: inherit; }
.qty-input { width: 80px; padding: 6px; border: 2px solid #8b6914; border-radius: 6px; background: #fffdf5; font-family: inherit; text-align: center; }
.pop-note { font-size: 0.82rem; color: #5a4a2a; margin-top: 6px; }
.pop-insufficient { color: #8B0000; font-weight: bold; margin-top: 8px; }
.popup-actions { display: flex; gap: 10px; margin-top: 12px; }
.popup-btn { flex: 1; padding: 10px; border-radius: 6px; cursor: pointer; font-family: inherit; border: 2px solid #2e1c0c; font-weight: bold; }
.popup-btn.cancel { background: linear-gradient(#8a8a8a, #5a5a5a); color: #fff; }
.popup-btn.confirm { background: linear-gradient(#7a5230, #4a2e14); color: #f5e6c4; }
.popup-btn.confirm:disabled { opacity: 0.4; }
</style>
