@page "/economy"
@inject GameEngine Engine
@implements IDisposable

<div class="dashboard">
    <div class="topbar">
        <div class="nation-name">Economy</div>
    </div>

    @if (!string.IsNullOrEmpty(_error))
    {
        <div class="warning">⚠ @_error</div>
    }

    <h2>STOCKS</h2>
    <div class="cards">
        <div class="card"><div class="label">Treasury</div><div class="value gold">@Currency.Format(_nation.Gold)</div></div>
        <div class="card"><div class="label">Wood</div><div class="value">@_nation.Wood.ToString("N0")</div></div>
        <div class="card"><div class="label">Iron</div><div class="value">@_nation.Iron.ToString("N0")</div></div>
        <div class="card"><div class="label">Goods</div><div class="value">@_nation.Goods.ToString("N0")</div></div>
        <div class="card">
            <div class="label">Trade</div>
            <button class="inline-btn" @onclick="SellGoods" disabled="@(_nation.Goods <= 0)">
                Sell goods (@Currency.Cost(_nation.Goods * Balance.GoodsSellPrice))
            </button>
        </div>
    </div>

    @if (_nation.ConstructionQueue.Count > 0)
    {
        <h2>UNDER CONSTRUCTION</h2>
        @foreach (var q in _nation.ConstructionQueue)
        {
            <div class="build-row">
                <div class="build-info">
                    <div class="build-name">@BuildingCatalog.Get(q.Building).Name</div>
                    <div class="progress"><div class="progress-fill" style="width:@((q.Progress * 100).ToString("N0"))%"></div></div>
                </div>
                <div class="build-days">@q.DaysLeft d</div>
            </div>
        }
    }

    <h2>BUILDINGS</h2>
    <div class="province-econ">
        <div class="province-econ-head">@_nation.Name</div>
        <div class="build-counts">
            <span>🌾 @_nation.Farms</span><span>⛏ @_nation.Mines</span><span>🪵 @_nation.Sawmills</span><span>🏭 @_nation.Workshops</span>
        </div>
        <div class="build-buttons">
            @foreach (var spec in BuildingCatalog.All)
            {
                <button class="build-btn" @onclick="() => Build(spec.Type)" disabled="@(!Engine.CanAfford(spec))">
                    + @spec.Name
                    <small>@BuildingCatalog.CostText(spec)</small>
                </button>
            }
        </div>
    </div>
</div>

@code {
    private Nation _nation => Engine.State.PlayerNation;
    private string? _error;

    protected override void OnInitialized()
    {
        Engine.StateChanged += OnStateChanged;
    }

    private void OnStateChanged() => InvokeAsync(StateHasChanged);

    private void Build(BuildingType type)
    {
        _error = Engine.StartConstruction(type);
    }

    private void SellGoods() => Engine.SellGoods();

    public void Dispose() => Engine.StateChanged -= OnStateChanged;
}
